fn max(x0: Float, x1: Float) -> Float {
  max_float(x0, x1)
}

fn min(x0: Float, x1: Float) -> Float {
  min_float(x0, x1)
}

enum Option<T> {
    Some(T),
    None,
}

fn is_some<T>(o: Option<T>) -> Bool {
    match o {
        Some(_) => true,
        None => false,
    }
}

fn is_none<T>(o: Option<T>) -> Bool {
    !is_some(o)
}

fn unwrap_or<T>(o: Option<T>, default: T) -> T {
    match o {
        Some(x) => x,
        None => default,
    }
}

fn first<T>(items: [T]) -> Option<T> {
    if items == [] {
        None
    } else {
        Some(head(items))
    }
}

fn last<T>(items: [T]) -> T {
    if tail(items) == [] {
        head(items)
    } else {
        last(tail(items))
    }
}

// The sequence helpers below are native builtins, so each runs in one step
// however long its input.

fn len<T>(items: [T]) -> Int {
    seq_len(items)
}

fn concat<T>(first: [T], second: [T]) -> [T] {
    seq_concat(first, second)
}

fn flatten<T>(sequences: [[T]]) -> [T] {
    seq_flatten(sequences)
}

fn sum(values: [Int]) -> Int {
    seq_sum(values)
}

fn any(values: [Bool]) -> Bool {
    seq_any(values)
}

fn all(values: [Bool]) -> Bool {
    seq_all(values)
}

// `range_full` is a native builtin (see the `"range_full"` arms in compile.rs):
// it constructs the whole `[Int]` in one O(n) pass rather than via recursive
// `cons`, so `range(n)` is O(n) instead of O(n^2).
fn range(stop: Int) -> [Int] {
    range_full(0, stop, 1)
}

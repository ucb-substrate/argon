fn max(x0: Float, x1: Float) -> Float {
  if x0 < x1 {
    x1
  } else {
    x0
  }
}

fn min(x0: Float, x1: Float) -> Float {
  if x0 < x1 {
    x0
  } else {
    x1
  }
}

enum Option<T> {
    Some(T),
    None,
}

fn is_some<T>(o: Option<T>) -> Bool {
    match o {
        Some(_) => true,
        None => false,
    }
}

fn is_none<T>(o: Option<T>) -> Bool {
    !is_some(o)
}

fn unwrap_or<T>(o: Option<T>, default: T) -> T {
    match o {
        Some(x) => x,
        None => default,
    }
}

fn first<T>(items: [T]) -> Option<T> {
    if items == [] {
        None
    } else {
        Some(head(items))
    }
}

fn last<T>(items: [T]) -> T {
    if tail(items) == [] {
        head(items)
    } else {
        last(tail(items))
    }
}

// `range_full` is a native builtin (see the `"range_full"` arms in compile.rs):
// it constructs the whole `[Int]` in one O(n) pass rather than via recursive
// `cons`, so `range(n)` is O(n) instead of O(n^2).
fn range(stop: Int) -> [Int] {
    range_full(0, stop, 1)
}

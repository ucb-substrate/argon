fn intersection(rect1: Rect, rect2: Rect) -> Rect {
    let intersection_x0 = std::max(rect1.x0, rect2.x0);
    let intersection_y0 = std::max(rect1.y0, rect2.y0);
    let intersection_x1 = std::min(rect1.x1, rect2.x1);
    let intersection_y1 = std::min(rect1.y1, rect2.y1);
    crect(x0=intersection_x0, y0=intersection_y0, x1=intersection_x1, y1=intersection_y1)
}

fn union(rect1: Rect, rect2: Rect) -> Rect {
    let union_x0 = std::min(rect1.x0, rect2.x0);
    let union_y0 = std::min(rect1.y0, rect2.y0);
    let union_x1 = std::max(rect1.x1, rect2.x1);
    let union_y1 = std::max(rect1.y1, rect2.y1);
    crect(x0=union_x0, y0=union_y0, x1=union_x1, y1=union_y1)
}

fn array(r: Rect, n: Int, xpitch: Float, ypitch: Float) -> Rect {
    if n >= 1 {
        if n == 1 {
            let first_rect = rect(r.layer);
            eq(first_rect.w, r.w);
            eq(first_rect.h, r.h);
            first_rect
        } else {
            let subarray = array(r, n - 1, xpitch, ypitch);
            let first_rect = rect(r.layer);
            eq(first_rect.w, r.w);
            eq(first_rect.h, r.h);
            eq(first_rect.x0 + xpitch, subarray.x0);
            eq(first_rect.y0 + ypitch, subarray.y0);
            let out_rect = crect();
            if xpitch > 0. {
                eq(out_rect.x0, first_rect.x0);
                eq(out_rect.x1, subarray.x1);
            } else {
                eq(out_rect.x0, subarray.x0);
                eq(out_rect.x1, first_rect.x1);
            }
            if ypitch > 0. {
                eq(out_rect.y0, first_rect.y0);
                eq(out_rect.y1, subarray.y1);
            } else {
                eq(out_rect.y0, subarray.y0);
                eq(out_rect.y1, first_rect.y1);
            }
            out_rect
        }
    } else {
        crect(w=0., h=0.)
    }
}

fn array2(r: Rect, nx: Int, ny: Int, xpitch: Float, ypitch: Float) -> Rect {
    if nx >= 1 {
        if ny >= 1 {
            if ny == 1 {
                array(r, nx, xpitch, 0.)
            } else {
                let subarray = array2(r, nx, ny-1, xpitch, ypitch);
                let first_rect = array(r, nx, xpitch, 0.);
                eq(first_rect.x0, subarray.x0);
                eq(first_rect.y0 + ypitch, subarray.y0);
                let out_rect = crect();
                eq(out_rect.x0, first_rect.x0);
                eq(out_rect.x1, first_rect.x1);
                if ypitch > 0. {
                    eq(out_rect.y0, first_rect.y0);
                    eq(out_rect.y1, subarray.y1);
                } else {
                    eq(out_rect.y0, subarray.y0);
                    eq(out_rect.y1, first_rect.y1);
                }
                out_rect
            }
        } else {
            crect(w=0., h=0.)
        }
    } else {
        crect(w=0., h=0.)
    }
}

fn max_array(r: Rect, w: Float, h: Float, xpitch: Float, ypitch: Float) -> Rect {
    let nx = if w >= r.w { ((w - r.w) / xpitch) as Int + 1 } else { 0 };
    let ny = if h >= r.h { ((h - r.h) / ypitch) as Int + 1 } else { 0 };
    if nx >= 1 {
        if ny >= 1 {
            array2(r, nx, ny, xpitch, ypitch)
        } else {
            crect(w=0., h=0.)
        }
    } else {
        crect(w=0., h=0.)
    }
}

fn eq_rect(r1: Rect, r2: Rect) {
    eq(r1.x0, r2.x0);
    eq(r1.y0, r2.y0);
    eq(r1.x1, r2.x1);
    eq(r1.y1, r2.y1);
}

fn center_rects(r1: Rect, r2: Rect) {
    eq(r2.x0, r1.x0 + grid_floor((r1.w - r2.w) / 2.));
    eq(r2.y0, r1.y0 + grid_floor((r1.h - r2.h) / 2.));
}

fn crect2rect(r: Rect) -> Rect {
    rect(r.layer, x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1)
}

fn mirror_pair(c: Any, axis: Float) -> [Any] {
    let a = inst(c);
    let b = inst(c, reflect=true, angle=180);
    eq(a.x + b.x, 2. * axis);
    eq(a.y, b.y);
    [a, b]
}

fn eq_mirror(a: Rect, b: Rect, axis: Float) {
    eq(a.x0 + b.x1, 2. * axis);
    eq(a.x1 + b.x0, 2. * axis);
    eq(a.y0, b.y0);
    eq(a.y1, b.y1);
}

fn common_centroid(n: Int) -> [Bool] {
    [for i in std::range(2 * n) { (i + 1) / 2 % 2 == 0 }]
}

fn interdigitated(n: Int) -> [Bool] {
    [for i in std::range(2 * n) { i % 2 == 0 }]
}

/// The technology file's value for the design rule `name`, such as
/// `"met1.space"`, in source units.
fn rule(name: String) -> Float {
    tech_rule(name)
}

/// Draws the largest array of cuts that fits where `bot` and `top` overlap,
/// enclosed by both as the technology file's via between their layers
/// requires, and centered on the grid. Returns the array's bounds.
fn via(bot: Rect, top: Rect) -> Rect {
    via_part(head(tech_via(bot, top, false)))
}

/// Joins `bot` up to `top` through every layer between them, with a via per
/// layer and a pad on each layer in between. Everything stays within the
/// shapes' overlap, except where a pad grows to its layer's minimum width or
/// area. Returns the bounds of each via's cuts and each pad, from the bottom.
fn via_stack(bot: Rect, top: Rect) -> [Rect] {
    [for part in tech_via(bot, top, true) { via_part(part) }]
}

/// Draws one part from `tech_via`: an array of rectangles on its layer.
fn via_part(part: (String, Float, Float, Float, Float, Int, Int, Float)) -> Rect {
    let shapes = array2(crect(layer=part.0, x0=0., y0=0., w=part.3, h=part.4), part.5, part.6, part.7, part.7);
    eq(shapes.x0, part.1);
    eq(shapes.y0, part.2);
    shapes
}

/// The bounding box of a non-empty sequence of instances or rectangles.
fn bbox_of(items: [Any]) -> Rect {
    let first = bbox(head(items));
    let rest = tail(items);
    if rest == [] {
        first
    } else {
        union(first, bbox_of(rest))
    }
}

/// Places each instance `gap` right of the one before, by their bounding boxes.
fn row(insts: [Any], gap: Float) {
    for i in std::range(std::len(insts) - 1) {
        eq(bbox(insts[i + 1]).x0, bbox(insts[i]).x1 + gap);
    }
}

/// Places each instance `gap` above the one before, by their bounding boxes.
fn column(insts: [Any], gap: Float) {
    for i in std::range(std::len(insts) - 1) {
        eq(bbox(insts[i + 1]).y0, bbox(insts[i]).y1 + gap);
    }
}

// A routing layer for `autoroute`: the layer to draw on, its wire width and
// spacing, and whether its wires run horizontally.
struct RouteLayer {
    name: String,
    width: Float,
    space: Float,
    horizontal: Bool,
}

// The via from one routing layer to the next: its cut layer, square cut size,
// spacing between cuts, and the enclosure of the cuts by the lower and upper
// layers, each as (short side, long side).
struct RouteVia {
    cut: String,
    size: Float,
    space: Float,
    bot_enc: (Float, Float),
    top_enc: (Float, Float),
}

// A pin: a rectangle on the routing layer at index `layer`.
struct RoutePin {
    layer: Int,
    rect: Rect,
}

// A net to route. Its first pin is routed to each of the others.
struct RouteNet {
    name: String,
    pins: [RoutePin],
}

// What `autoroute` drew for a net: its metal on routing layers (wires, pin
// stubs, gap fills, and via landings) and its via cuts.
struct RoutedNet {
    name: String,
    wires: [Rect],
    cuts: [Rect],
}

// Routes `nets` in order within `area` and draws them. `obstacles[i]` holds
// the obstacles on `layers[i]`, and `vias[i]` joins `layers[i]` to the next.
fn autoroute(
    area: Rect,
    layers: [RouteLayer],
    vias: [RouteVia],
    obstacles: [[Rect]],
    nets: [RouteNet],
) -> [RoutedNet] {
    let routed = route_tracks(
        area,
        [for l in layers { (l.width, l.space, l.horizontal) }],
        [for v in vias { (v.size, v.space, v.bot_enc, v.top_enc) }],
        std::flatten([for i in std::range(std::len(obstacles)) {
            [for r in obstacles[i] { (i, r) }]
        }]),
        [for n in nets { (n.name, [for p in n.pins { (p.layer, p.rect) }]) }],
    );
    [for i in std::range(std::len(nets)) {
        let net = routed[i];
        let wires = [for w in std::concat(net.2, net.0) {
            rect(layers[w.0].name, x0=w.1.x0, y0=w.1.y0, x1=w.1.x1, y1=w.1.y1)
        }];
        let landings = std::flatten([for v in net.1 {
            [
                rect(layers[v.0].name, x0=v.2.x0, y0=v.2.y0, x1=v.2.x1, y1=v.2.y1),
                rect(layers[v.0 + 1].name, x0=v.3.x0, y0=v.3.y0, x1=v.3.x1, y1=v.3.y1),
            ]
        }]);
        let cuts = std::flatten([for v in net.1 {
            [for c in v.1 { rect(vias[v.0].cut, x0=c.x0, y0=c.y0, x1=c.x1, y1=c.y1) }]
        }]);
        RoutedNet { name: nets[i].name, wires: std::concat(wires, landings), cuts: cuts }
    }]
}

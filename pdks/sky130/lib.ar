use std::layout::{array, center_rects, crect, inst, max_array, rect};

/// A 1.8 V transistor with `nf` gate fingers over one diffusion, contacted
/// with local interconnect between and beside the fingers.
///
/// # Arguments
/// - `nfet`: draws an NMOS device (N+ implant) if true, PMOS (P+ implant) if false.
/// - `w`: width of each finger, which is the height of the diffusion.
/// - `nf`: number of gate fingers.
cell fet1v8(nfet: Bool, w: Float, nf: Int) {
    let poly = crect(layer="poly.drawing", x0=0., y0=0., w=150., h = w + 260.);
    pub let poly_bbox = std::layout::array(poly, nf, 430., 0.);
    eq(poly_bbox.x0, 0.);
    eq(poly_bbox.y0, 0.);
    let diff = rect(
        "diff.drawing",
        x0 = poly_bbox.x0 - 55. - 170. - 130.,
        x1 = poly_bbox.x1 + 55. + 170. + 130.,
        y0 = poly_bbox.y0 + 130.,
        y1 = poly_bbox.y1 - 130.
    )!;
    let li1 = crect(layer="li1.drawing", x1=poly_bbox.x0 - 55., y0=diff.y0 - 100., w=170., y1=diff.y1 + 100.);
    pub let li1_bbox = std::layout::array(li1, nf + 1, 430., 0.);
    eq(li1_bbox.x0, li1.x0);
    eq(li1_bbox.y0, li1.y0);
    pub let sdm = rect(if nfet { "nsdm.drawing" } else { "psdm.drawing" }, x0 = diff.x0 - 130., x1=diff.x1 + 130., y0=diff.y0 - 130., y1=diff.y1+130.);

    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let ny = (diff.h + 170. - 80.) as Int / 340. as Int;
    std::layout::center_rects(li1_bbox, std::layout::array2(licon, nf + 1, ny, 430., 340.));
}

/// A well or substrate tap: a `w` by `h` tap diffusion covered with local
/// interconnect and as many contacts as fit on a 340 pitch.
///
/// # Arguments
/// - `ntap`: 1 for an N+ tap, which contacts an n-well; any other value for a P+ tap, which contacts the substrate.
/// - `w`: width of the tap diffusion.
/// - `h`: height of the tap diffusion.
cell tap(ntap: Int, w: Float, h: Float) {
    pub let tap = rect("tap.drawing", x0=0., y0=0., w=w, h=h);
    pub let li1 = rect("li1.drawing", x0=tap.x0 + 40., y0=tap.y0 + 40., x1 = tap.x1 - 40., y1 = tap.y1 - 40.);
    pub let sdm = rect(if ntap == 1 { "nsdm.drawing" } else { "psdm.drawing" }, x0=tap.x0 - 130., x1=tap.x1 + 130., y0=tap.y0 - 130., y1=tap.y1 + 130.);
    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let cons = crect(x0=li1.x0, x1=li1.x1, y0=li1.y0+80., y1=li1.y1-80.);
    std::layout::center_rects(cons, std::layout::max_array(licon, cons.w, cons.h, 340., 340.));
}

/// A `fet1v8` wired on met1: its gate fingers join a poly bar below the
/// diffusion, contacted under the met1 bar `g`, and the met1 bars `s` and `d`
/// strap its sources (even contact columns, counting from 0 at the left) and
/// its drains (odd columns). Each bar is 320 tall, so a via1 centered on it
/// fits. Place it with `reflect=true` for its gate above, or use `fet1v8` to
/// contact the gates some other way.
///
/// # Fields
/// - `g`, `s`, `d`: the met1 bars.
/// - `cols`: the bounds of the li1 contact columns, 170 wide on a 430 pitch.
/// - `poly`: the bounds of the gate fingers.
/// - `sdm`: the N+ or P+ implant.
cell mos(nfet: Bool, w: Float, nf: Int) {
    let fet = inst(fet1v8(nfet, w, nf), x=0., y=0.);
    pub let sdm = fet.sdm;
    pub let poly = fet.poly_bbox;
    pub let cols = fet.li1_bbox;
    pub let s = strap(cols.x0, cols.y0, nf / 2 + 1, 90.);
    pub let d = strap(cols.x0 + 430., cols.y1 - 170., (nf + 1) / 2, 60.);

    // The bar stays within the outer fingers, so abutted devices' bars keep
    // apart, except that a lone finger's widens to fit a contact.
    let ext = std::max(0., (270. - poly.w) / 2.);
    let li_y0 = s.y0 - 385.;
    let bar = rect("poly.drawing", x0=poly.x0 - ext, x1=poly.x1 + ext, y0=li_y0 - 80., y1=poly.y0);
    let licon = crect(layer="licon1.drawing", x0=0., y0=0., w=170., h=170.);
    let licons = max_array(licon, bar.w - 100., 170., 340., 340.);
    center_rects(crect(x0=bar.x0, x1=bar.x1, y0=li_y0, h=170.), licons);
    let li = rect("li1.drawing", x0=licons.x0 - 80., x1=licons.x1 + 80., y0=li_y0, h=170.);
    let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
    let mcons = max_array(mcon, li.w - 120., 170., 360., 360.);
    center_rects(li, mcons);
    pub let g = rect("met1.drawing", x0=mcons.x0 - 60., x1=mcons.x1 + 60., y0=li.y0 - 75., h=320.);
    rect("npc.drawing", x0=poly.x0 - 140., x1=poly.x1 + 140., y0=li.y0 - 100., y1=li.y1 + 100.);
}

/// A met1 bar 320 tall over `n` mcons at `y`, on every other contact column
/// from the one at `x0`, reaching `below` under them.
fn strap(x0: Float, y: Float, n: Int, below: Float) -> Rect {
    let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
    let cuts = array(mcon, n, 860., 0.);
    eq(cuts.x0, x0);
    eq(cuts.y0, y);
    rect("met1.drawing", x0=x0 - 60., x1=cuts.x1 + 60., y0=y - below, h=320.)
}

/// Places each `mos` instance of `devices` right of the one before, with its
/// leftmost contact column on that one's rightmost, so their diffusions merge
/// and the shared column is a terminal of both. Counting from column 0, which a
/// mirrored copy has at its right, even columns are sources. Abutted devices
/// need the same `w`; two with `nf = 1` and their gates on the same side can't
/// abut.
fn abut(devices: [Any]) {
    for i in std::range(std::len(devices) - 1) {
        let a = devices[i];
        let b = devices[i + 1];
        eq(b.cols.x0, a.cols.x1 - 170.);
        eq(b.cols.y0, a.cols.y0);
    }
}

cell inv(nw: Float, pw: Float, nf: Int) {
    let nmos = inst(fet1v8(true, nw, nf), x=0., y=0.);
    pub let ptap = inst(tap(0, nmos.sdm.w - 260., 800.));
    eq(ptap.sdm.y1 + 100., nmos.sdm.y0);
    eq(ptap.sdm.x0, nmos.sdm.x0);
    pub let pmos = inst(fet1v8(false, pw, nf), x=0.);
    pub let ntap = inst(tap(1, pmos.sdm.w - 260., 800.));
    eq(pmos.li1_bbox.y1 + 100., ntap.sdm.y0);
    eq(ntap.sdm.x0, pmos.sdm.x0);

    pub let nwell = rect("nwell.drawing", x0=pmos.sdm.x0-180., x1=pmos.sdm.x1+180., y0=pmos.sdm.y0-180., y1=ntap.sdm.y1+180.);

    // Draw horizontal LI1 rails.
    let o_li_bot = rect("li1.drawing", x0=nmos.li1_bbox.x0 + 430., y0=nmos.li1_bbox.y1 + 170., h=170.);
    pub let a_li_mid = rect("li1.drawing", x0=nmos.poly_bbox.x0 - 90., x1=nmos.poly_bbox.x1 + 90., y0=o_li_bot.y1 + 170., h=170.)!;
    let o_li_top = rect("li1.drawing", x0=nmos.li1_bbox.x0 + 430., x1=o_li_bot.x1, y0=a_li_mid.y1 + 170., h=170.)!;
    eq(o_li_top.y1 + 170., pmos.li1_bbox.y0);

    // Connect output LI1 rectangles.
    pub let o_li_right = rect("li1.drawing", x0=a_li_mid.x1 + 170., w=170., y0=o_li_bot.y0, y1=o_li_top.y1);
    eq(o_li_bot.x1, o_li_right.x1);
    let li1 = crect(layer="li1.drawing", x1=o_li_bot.x0, w=170., y0=nmos.li1_bbox.y0, y1=o_li_bot.y1);
    let li1_bbox_bot = std::layout::array(li1, (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_bot.x0, o_li_bot.x0);
    eq(li1_bbox_bot.y1, o_li_bot.y1);
    let li1 = crect(layer="li1.drawing", x1=o_li_bot.x0, w=170., y1=pmos.li1_bbox.y1, y0=o_li_top.y0);
    let li1_bbox_top = std::layout::array(li1, (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_top.x0, o_li_top.x0);
    eq(li1_bbox_top.y0, o_li_top.y0);

    // Connect sources to taps.
    let li1 = crect(layer="li1.drawing", x1=o_li_bot.x0, w=170., y0=ptap.li1.y0, y1=nmos.li1_bbox.y1);
    let li1_bbox_bot = std::layout::array(li1, nf + 1 - (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_bot.x0, nmos.li1_bbox.x0);
    eq(li1_bbox_bot.y0, ptap.li1.y0);
    let li1 = crect(layer="li1.drawing", x1=o_li_bot.x0, w=170., y1=ntap.li1.y1, y0=pmos.li1_bbox.y0);
    let li1_bbox_top = std::layout::array(li1, nf + 1 - (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_top.x0, pmos.li1_bbox.x0);
    eq(li1_bbox_top.y1, ntap.li1.y1);

    // Connect gates to input LI1 rectangle.
    let a_poly_mid = rect("poly.drawing", x0=nmos.poly_bbox.x0 - 90., x1=nmos.poly_bbox.x1 + 90., h=270.)!;
    eq(a_poly_mid.y0 + a_poly_mid.y1, a_li_mid.y0 + a_li_mid.y1);
    let a_npc_mid = rect("npc.drawing", x0=nmos.poly_bbox.x0 - 110., x1=nmos.poly_bbox.x1 + 110., h=370.)!;
    eq(a_poly_mid.y0 + a_poly_mid.y1, a_npc_mid.y0 + a_npc_mid.y1);

    let poly = crect(layer="poly.drawing", x0=0., y0=nmos.poly_bbox.y0, y1=pmos.poly_bbox.y1, w=150.);
    let poly_bbox = std::layout::array(poly, nf, 430., 0.);
    eq(poly_bbox.x0, nmos.poly_bbox.x0);
    eq(poly_bbox.y0, nmos.poly_bbox.y0);

    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let licon_bbox = std::layout::array(licon, nf, 430., 0.);
    eq(licon_bbox.x0, a_li_mid.x0 + 80.);
    eq(licon_bbox.y0, a_li_mid.y0);
}

fn v12_array(r1: Rect, r2: Rect) {
    let via = crect(layer="via.drawing", w=150., h=150., x0=0., y0=0.);
    centered_via_array(r1, r2, via, 320., 320.);
}

fn centered_via_array(r1: Rect, r2: Rect, via: Rect, xpitch: Float, ypitch: Float) {
    let intersection = std::layout::intersection(r1, r2);
    std::layout::center_rects(intersection, std::layout::max_array(via, intersection.w, intersection.h, xpitch, ypitch));
}

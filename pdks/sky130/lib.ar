use std::layout::{array, center_rects, crect, inst, max_array, rect, via};

/// A 1.8 V transistor with `nf` gate fingers over one diffusion, contacted
/// with local interconnect between and beside the fingers. The diffusion ends
/// 60 past the outer contact columns.
///
/// # Arguments
/// - `nfet`: draws an NMOS device (N+ implant) if true, PMOS (P+ implant) if false.
/// - `w`: width of each finger, which is the height of the diffusion.
/// - `nf`: number of gate fingers.
cell fet1v8(nfet: Bool, w: Float, nf: Int) {
    let poly = crect(layer="poly.drawing", x0=0., y0=0., w=150., h = w + 260.);
    pub let poly_bbox = std::layout::array(poly, nf, 430., 0.);
    eq(poly_bbox.x0, 0.);
    eq(poly_bbox.y0, 0.);
    let diff = rect(
        "diff.drawing",
        x0 = poly_bbox.x0 - 55. - 170. - 60.,
        x1 = poly_bbox.x1 + 55. + 170. + 60.,
        y0 = poly_bbox.y0 + 130.,
        y1 = poly_bbox.y1 - 130.
    )!;
    let li1 = crect(
        layer="li1.drawing",
        x1=poly_bbox.x0 - 55.,
        y0=diff.y0 - 100.,
        w=170.,
        y1=diff.y1 + 100.,
    );
    pub let li1_bbox = std::layout::array(li1, nf + 1, 430., 0.);
    eq(li1_bbox.x0, li1.x0);
    eq(li1_bbox.y0, li1.y0);
    pub let sdm = rect(
        if nfet { "nsdm.drawing" } else { "psdm.drawing" },
        x0 = diff.x0 - 130.,
        x1=diff.x1 + 130.,
        y0=diff.y0 - 130.,
        y1=diff.y1+130.,
    );

    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let ny = (diff.h + 170. - 80.) as Int / 340. as Int;
    std::layout::center_rects(li1_bbox, std::layout::array2(licon, nf + 1, ny, 430., 340.));
}

/// A well or substrate tap: a `w` by `h` tap diffusion covered with local
/// interconnect and as many contacts as fit on a 340 pitch. Contacts fit
/// only when `w` is at least 250 and `h` at least 410.
///
/// # Arguments
/// - `ntap`: an N+ tap, which contacts an n-well, if true; a P+ tap, which contacts the substrate, if false.
/// - `w`: width of the tap diffusion.
/// - `h`: height of the tap diffusion.
cell tap(ntap: Bool, w: Float, h: Float) {
    pub let tap = rect("tap.drawing", x0=0., y0=0., w=w, h=h);
    pub let li1 = rect(
        "li1.drawing",
        x0=tap.x0 + 40.,
        y0=tap.y0 + 40.,
        x1 = tap.x1 - 40.,
        y1 = tap.y1 - 40.,
    );
    pub let sdm = rect(
        if ntap { "nsdm.drawing" } else { "psdm.drawing" },
        x0=tap.x0 - 130.,
        x1=tap.x1 + 130.,
        y0=tap.y0 - 130.,
        y1=tap.y1 + 130.,
    );
    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let cons = crect(x0=li1.x0, x1=li1.x1, y0=li1.y0+80., y1=li1.y1-80.);
    std::layout::center_rects(cons, std::layout::max_array(licon, cons.w, cons.h, 340., 340.));
}

/// A `tap` with met1 over its whole outline, contacted to its local
/// interconnect with as many mcons as fit, so a supply can strap it directly.
/// A narrow, tall one is a tap column for the end of a row of devices. It
/// needs `w` of at least 250 and `h` of at least 410. Keep tap diffusion 270
/// from transistor diffusion; an n-tap also needs an n-well over it, 180 past
/// its diffusion.
///
/// # Fields
/// - `tap`, `li1`, `sdm`: the tap's diffusion, local interconnect, and implant.
/// - `m1`: the met1, which is the outline of `tap`.
cell tap_m1(ntap: Bool, w: Float, h: Float) {
    let t = inst(tap(ntap, w, h), x=0., y=0.);
    pub let tap = t.tap;
    pub let li1 = t.li1;
    pub let sdm = t.sdm;
    pub let m1 = rect("met1.drawing", x0=0., y0=0., x1=w, y1=h);
    // The met1 encloses each mcon by 60 at both ends of the tap's longer side.
    let cons = if w >= h {
        crect(x0=li1.x0 + 20., x1=li1.x1 - 20., y0=li1.y0, y1=li1.y1)
    } else {
        crect(x0=li1.x0, x1=li1.x1, y0=li1.y0 + 20., y1=li1.y1 - 20.)
    };
    let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
    center_rects(cons, max_array(mcon, cons.w, cons.h, 360., 360.));
}

/// Places a `tap_m1` whose implant fills `span` exactly, such as the room at
/// the end of a row, and returns the instance.
fn fill_tap(ntap: Bool, span: Rect) -> Any {
    let t = inst(tap_m1(ntap, span.w - 260., span.h - 260.));
    eq(t.sdm.x0, span.x0);
    eq(t.sdm.y0, span.y0);
    t
}

/// A `fet1v8` wired on met1: its gate fingers join a poly pad below the
/// diffusion, contacted under the met1 bar `g`, and the met1 bars `s` and `d`
/// strap its sources (even contact columns, counting from 0 at the left) and
/// its drains (odd columns). Each bar is 320 tall, so a via1 centered on it
/// fits. Place it with `reflect=true` for its gate above, or use `fet1v8` to
/// contact the gates some other way.
///
/// # Arguments
/// - `gate_row`: moves the gate contact 540 further from the diffusion per row.
/// - `gate_side`: where a lone finger's 270-wide contact widens: -1 left, 1
///   right, or 0 both ways. See `abut` for lone fingers side by side.
/// - `swap`: puts `d` on the gate side and `s` on the far side.
/// - `away`: puts the gate-side bar just inside the far one, which leaves the
///   gate side free of met1. Abutted devices need the same `away` unless `w`
///   is at least 860.
/// - `straps`: draws `s` and `d` and their mcons; if false, they are only bounds.
///
/// # Fields
/// - `g`, `s`, `d`: the met1 bars.
/// - `cols`: the bounds of the li1 contact columns, 170 wide on a 430 pitch.
/// - `poly`: the bounds of the gate fingers.
/// - `sdm`: the N+ or P+ implant.
cell mos(
    nfet: Bool,
    w: Float,
    nf: Int,
    gate_row: Int = 0,
    gate_side: Int = 0,
    swap: Bool = false,
    away: Bool = false,
    straps: Bool = true
) {
    // `gate_row` counts from 0, and `gate_side` is -1, 0, or 1.
    eq(std::max(gate_row, 0) as Float, gate_row as Float);
    eq(std::min(std::max(gate_side, -1), 1) as Float, gate_side as Float);
    let fet = inst(fet1v8(nfet, w, nf), x=0., y=0.);
    pub let sdm = fet.sdm;
    pub let poly = fet.poly_bbox;
    pub let cols = fet.li1_bbox;
    // The far bar's mcons are at the columns' top; the near bar's are at their
    // bottom, or with `away`, just under the far bar.
    let far_y = cols.y1 - 170.;
    let near_y = if away { cols.y1 - 615. } else { cols.y0 };
    let near_below = if away { 75. } else { 90. };
    pub let s = strap(
        cols.x0,
        if swap { far_y } else { near_y },
        nf / 2 + 1,
        if swap { 60. } else { near_below },
        straps,
    );
    pub let d = strap(
        cols.x0 + 430.,
        if swap { near_y } else { far_y },
        (nf + 1) / 2,
        if swap { near_below } else { 60. },
        straps,
    );

    // Gate contacts sit in rows 540 apart below the diffusion. A row past the
    // first reaches the fingers through extensions of them.
    let li0 = cols.y0 - 475.;
    let li_y0 = li0 - 540. * (gate_row as Float);
    let pad_y1 = if gate_row == 0 { poly.y0 } else { li_y0 + 250. };
    if gate_row > 0 {
        let finger = crect(layer="poly.drawing", x0=0., y0=0., w=150., h=poly.y0 - pad_y1);
        let fingers = array(finger, nf, 430., 0.);
        eq(fingers.x0, poly.x0);
        eq(fingers.y0, pad_y1);
    }
    pub let g = gate_contact(poly, li_y0, pad_y1, gate_side, li_y0 - 100., li0 + 270.);
}

/// One transistor folded into `rows` rows of `mos`, each with `nf / rows`
/// fingers, stacked upward on a pitch of `w + 1000`, so a long device fits the
/// height a taller neighbor sets. Met2 trunks 260 wide join the rows: `s`
/// over contact column 0, `d` over column 1, and `g` 320 right of the
/// columns, which each row's gate bar reaches on met1. `nf` must be a
/// multiple of `rows`.
///
/// # Fields
/// - `g`, `s`, `d`: the met2 trunks.
/// - `devices`: the rows' `mos` instances, from the bottom.
/// - `sdm`: the bounds of the rows' implants.
cell fold(nfet: Bool, w: Float, nf: Int, rows: Int) {
    // `nf` must be a multiple of `rows`.
    eq(((nf / rows) * rows) as Float, nf as Float);
    pub let devices = [for i in std::range(rows) {
        inst(mos(nfet, w, nf / rows), x=0., y=(w + 1000.) * (i as Float))
    }];
    let first = devices[0];
    let last = devices[rows - 1];
    pub let sdm = crect(x0=first.sdm.x0, x1=first.sdm.x1, y0=first.sdm.y0, y1=last.sdm.y1);
    let sx = first.cols.x0 + 85.;
    let gx = first.cols.x1 + 320.;
    pub let s = rect("met2.drawing", x0=sx - 130., x1=sx + 130., y0=first.s.y0, y1=last.s.y1);
    pub let d = rect("met2.drawing", x0=sx + 300., x1=sx + 560., y0=first.d.y0, y1=last.d.y1);
    pub let g = rect("met2.drawing", x0=gx - 130., x1=gx + 130., y0=first.g.y0, y1=last.g.y1);
    for m in devices {
        via(m.s, s);
        via(m.d, d);
        via(rect("met1.drawing", x0=m.g.x0, x1=gx + 130., y0=m.g.y0, y1=m.g.y1), g);
    }
}

/// An NMOS and a PMOS `fet1v8` sharing `nf` gate fingers, as in an inverter:
/// the NMOS below, the PMOS above in an n-well, and the gate contacted on the
/// met1 bar `g` between them, with the drain bars on either side of it. Columns
/// abut as `mos` devices do, and a row of them needs the same `nw`, `pw`, and
/// `rows`.
///
/// # Arguments
/// - `rows`: the number of gate contact rows between the diffusions, 540 apart.
/// - `gate_row`: this column's row, counting from 0 nearest the NMOS.
/// - `gate_side`: where a lone finger's contact widens, as for `mos`.
///
/// # Fields
/// - `g`, `n_s`, `n_d`, `p_s`, `p_d`: the met1 bars, each 320 tall.
/// - `cols`, `p_cols`: the bounds of the NMOS and PMOS li1 contact columns.
/// - `poly`: the bounds of the gate fingers.
/// - `n_sdm`, `p_sdm`, `nwell`: the implants and the n-well.
cell cmos(nw: Float, pw: Float, nf: Int, rows: Int = 1, gate_row: Int = 0, gate_side: Int = 0) {
    // `gate_row` is one of the `rows` rows, and `gate_side` is -1, 0, or 1.
    eq(std::min(std::max(gate_row, 0), rows - 1) as Float, gate_row as Float);
    eq(std::min(std::max(gate_side, -1), 1) as Float, gate_side as Float);
    let n = inst(fet1v8(true, nw, nf), x=0., y=0.);
    pub let cols = n.li1_bbox;
    pub let n_sdm = n.sdm;
    pub let n_s = strap(cols.x0, cols.y0, nf / 2 + 1, 90., true);
    pub let n_d = strap(cols.x0 + 430., cols.y1 - 170., (nf + 1) / 2, 60., true);

    let li0 = n_d.y1 + 215.;
    let top = li0 + 540. * ((rows - 1) as Float);
    let p = inst(fet1v8(false, pw, nf), x=0., reflect=true);
    pub let p_cols = p.li1_bbox;
    pub let p_sdm = p.sdm;
    eq(p_cols.y0, top + 475.);
    pub let p_d = strap(cols.x0 + 430., p_cols.y0, (nf + 1) / 2, 90., true);
    pub let p_s = strap(cols.x0, p_cols.y1 - 170., nf / 2 + 1, 60., true);

    let finger = crect(
        layer="poly.drawing",
        x0=0.,
        y0=0.,
        w=150.,
        h=p.poly_bbox.y0 - n.poly_bbox.y1,
    );
    let fingers = array(finger, nf, 430., 0.);
    eq(fingers.x0, n.poly_bbox.x0);
    eq(fingers.y0, n.poly_bbox.y1);
    pub let poly = crect(
        x0=n.poly_bbox.x0,
        x1=n.poly_bbox.x1,
        y0=n.poly_bbox.y0,
        y1=p.poly_bbox.y1,
    );
    let li_y0 = li0 + 540. * (gate_row as Float);
    pub let g = gate_contact(poly, li_y0, li_y0 + 250., gate_side, li0 - 100., top + 270.);

    // The n-well encloses the PMOS diffusion by 180 and is at least 840 tall.
    pub let nwell = rect(
        "nwell.drawing",
        x0=p_sdm.x0 - 50.,
        x1=p_sdm.x1 + 50.,
        y0=p_sdm.y0 - 50.,
        y1=std::max(p_sdm.y1 + 50., p_sdm.y0 + 790.)
    );
}

/// Contacts the gate fingers spanning `fingers` on met1: a poly pad from 80
/// below `li_y0` to `pad_y1`, li1 170 tall from `li_y0`, the nitride cut from
/// `npc_y0` to `npc_y1`, and the met1 bar 320 tall that it returns. A lone
/// finger's pad widens to 270 toward `side`: -1 left, 1 right, or 0 both.
fn gate_contact(
    fingers: Rect,
    li_y0: Float,
    pad_y1: Float,
    side: Int,
    npc_y0: Float,
    npc_y1: Float,
) -> Rect {
    let ext = std::max(0., 270. - fingers.w);
    let left = if side < 0 { ext } else if side > 0 { 0. } else { ext / 2. };
    let pad = rect(
        "poly.drawing",
        x0=fingers.x0 - left,
        x1=fingers.x1 + ext - left,
        y0=li_y0 - 80.,
        y1=pad_y1,
    );
    let licon = crect(layer="licon1.drawing", x0=0., y0=0., w=170., h=170.);
    let licons = max_array(licon, pad.w - 100., 170., 340., 340.);
    center_rects(crect(x0=pad.x0, x1=pad.x1, y0=li_y0, h=170.), licons);
    let li = rect("li1.drawing", x0=licons.x0 - 80., x1=licons.x1 + 80., y0=li_y0, h=170.);
    let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
    let mcons = max_array(mcon, li.w - 120., 170., 360., 360.);
    center_rects(li, mcons);
    rect(
        "npc.drawing",
        x0=std::min(fingers.x0 - 140., pad.x0 - 50.),
        x1=std::max(fingers.x1 + 140., pad.x1 + 50.),
        y0=npc_y0,
        y1=npc_y1,
    );
    rect("met1.drawing", x0=mcons.x0 - 60., x1=mcons.x1 + 60., y0=li.y0 - 75., h=320.)
}

/// A met1 bar 320 tall over `n` mcons at `y`, on every other contact column
/// from the one at `x0`, reaching `below` under them. Draws the bar and its
/// mcons if `draw`, and otherwise returns only the bar's bounds.
fn strap(x0: Float, y: Float, n: Int, below: Float, draw: Bool) -> Rect {
    let x1 = x0 + 860. * ((n - 1) as Float) + 230.;
    if draw {
        let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
        let cuts = array(mcon, n, 860., 0.);
        eq(cuts.x0, x0);
        eq(cuts.y0, y);
        rect("met1.drawing", x0=x0 - 60., x1=x1, y0=y - below, h=320.)
    } else {
        crect(layer="met1.drawing", x0=x0 - 60., x1=x1, y0=y - below, h=320.)
    }
}

/// Places each `mos` or `cmos` instance of `devices` right of the one before,
/// with its leftmost contact column on that one's rightmost, so their
/// diffusions merge and the shared column is a terminal of both. Counting from
/// column 0, which a mirrored copy has at its right, even columns are sources.
/// Abutted devices need the same `w`. Lone fingers' gate contacts fit side by
/// side only when, as placed, the left one widens left and the right one right
/// (`gate_side`). Otherwise alternate `gate_row`, with the contact nearer the
/// diffusion not widening toward its neighbors.
fn abut(devices: [Any]) {
    for i in std::range(std::len(devices) - 1) {
        let a = devices[i];
        let b = devices[i + 1];
        eq(b.cols.x0, a.cols.x1 - 170.);
        eq(b.cols.y0, a.cols.y0);
    }
}

/// A CMOS inverter drawn from `fet1v8` and `tap`, with taps under the NMOS
/// and over the PMOS, and its gate and output on local interconnect.
cell inv(nw: Float, pw: Float, nf: Int) {
    let nmos = inst(fet1v8(true, nw, nf), x=0., y=0.);
    pub let ptap = inst(tap(false, nmos.sdm.w - 260., 800.));
    eq(ptap.sdm.y1 + 100., nmos.sdm.y0);
    eq(ptap.sdm.x0, nmos.sdm.x0);
    pub let pmos = inst(fet1v8(false, pw, nf), x=0.);
    pub let ntap = inst(tap(true, pmos.sdm.w - 260., 800.));
    eq(pmos.li1_bbox.y1 + 100., ntap.sdm.y0);
    eq(ntap.sdm.x0, pmos.sdm.x0);

    pub let nwell = rect(
        "nwell.drawing",
        x0=pmos.sdm.x0-180.,
        x1=pmos.sdm.x1+180.,
        y0=pmos.sdm.y0-180.,
        y1=ntap.sdm.y1+180.,
    );

    // Draw horizontal LI1 rails.
    let o_li_bot = rect(
        "li1.drawing",
        x0=nmos.li1_bbox.x0 + 430.,
        y0=nmos.li1_bbox.y1 + 170.,
        h=170.,
    );
    pub let a_li_mid = rect(
        "li1.drawing",
        x0=nmos.poly_bbox.x0 - 90.,
        x1=nmos.poly_bbox.x1 + 90.,
        y0=o_li_bot.y1 + 170.,
        h=170.,
    )!;
    let o_li_top = rect(
        "li1.drawing",
        x0=nmos.li1_bbox.x0 + 430.,
        x1=o_li_bot.x1,
        y0=a_li_mid.y1 + 170.,
        h=170.,
    )!;
    eq(o_li_top.y1 + 170., pmos.li1_bbox.y0);

    // Connect output LI1 rectangles.
    pub let o_li_right = rect(
        "li1.drawing",
        x0=a_li_mid.x1 + 170.,
        w=170.,
        y0=o_li_bot.y0,
        y1=o_li_top.y1,
    );
    eq(o_li_bot.x1, o_li_right.x1);
    let li1 = crect(
        layer="li1.drawing",
        x1=o_li_bot.x0,
        w=170.,
        y0=nmos.li1_bbox.y0,
        y1=o_li_bot.y1,
    );
    let li1_bbox_bot = std::layout::array(li1, (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_bot.x0, o_li_bot.x0);
    eq(li1_bbox_bot.y1, o_li_bot.y1);
    let li1 = crect(
        layer="li1.drawing",
        x1=o_li_bot.x0,
        w=170.,
        y1=pmos.li1_bbox.y1,
        y0=o_li_top.y0,
    );
    let li1_bbox_top = std::layout::array(li1, (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_top.x0, o_li_top.x0);
    eq(li1_bbox_top.y0, o_li_top.y0);

    // Connect sources to taps.
    let li1 = crect(
        layer="li1.drawing",
        x1=o_li_bot.x0,
        w=170.,
        y0=ptap.li1.y0,
        y1=nmos.li1_bbox.y1,
    );
    let li1_bbox_bot = std::layout::array(li1, nf + 1 - (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_bot.x0, nmos.li1_bbox.x0);
    eq(li1_bbox_bot.y0, ptap.li1.y0);
    let li1 = crect(
        layer="li1.drawing",
        x1=o_li_bot.x0,
        w=170.,
        y1=ntap.li1.y1,
        y0=pmos.li1_bbox.y0,
    );
    let li1_bbox_top = std::layout::array(li1, nf + 1 - (nf + 1) / 2, 860., 0.);
    eq(li1_bbox_top.x0, pmos.li1_bbox.x0);
    eq(li1_bbox_top.y1, ntap.li1.y1);

    // Connect gates to input LI1 rectangle.
    let a_poly_mid = rect(
        "poly.drawing",
        x0=nmos.poly_bbox.x0 - 90.,
        x1=nmos.poly_bbox.x1 + 90.,
        h=270.,
    )!;
    eq(a_poly_mid.y0 + a_poly_mid.y1, a_li_mid.y0 + a_li_mid.y1);
    let a_npc_mid = rect(
        "npc.drawing",
        x0=nmos.poly_bbox.x0 - 110.,
        x1=nmos.poly_bbox.x1 + 110.,
        h=370.,
    )!;
    eq(a_poly_mid.y0 + a_poly_mid.y1, a_npc_mid.y0 + a_npc_mid.y1);

    let poly = crect(
        layer="poly.drawing",
        x0=0.,
        y0=nmos.poly_bbox.y0,
        y1=pmos.poly_bbox.y1,
        w=150.,
    );
    let poly_bbox = std::layout::array(poly, nf, 430., 0.);
    eq(poly_bbox.x0, nmos.poly_bbox.x0);
    eq(poly_bbox.y0, nmos.poly_bbox.y0);

    let licon = crect(layer="licon1.drawing", x0=0., x1=170., y0=0., y1=170.);
    let licon_bbox = std::layout::array(licon, nf, 430., 0.);
    eq(licon_bbox.x0, a_li_mid.x0 + 80.);
    eq(licon_bbox.y0, a_li_mid.y0);
}

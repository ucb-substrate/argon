{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Argon",
  "scopeName": "source.argon",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.argon"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.argon",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.argon" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(cell|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.argon" },
            "2": { "name": "entity.name.function.argon" }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.argon" },
            "2": { "name": "entity.name.type.argon" }
          }
        },
        {
          "match": "\\b(mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.module.argon" },
            "2": { "name": "entity.name.namespace.argon" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.constant.argon" },
            "2": { "name": "variable.other.constant.argon" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(if|else|match|for|in)\\b", "name": "keyword.control.argon" },
        { "match": "\\b(let|pub|use|as)\\b", "name": "keyword.other.argon" },
        { "match": "\\b(cell|fn|struct|enum|mod|const)\\b", "name": "keyword.declaration.argon" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.argon" },
        { "match": "\\b(std|lib)\\b(?=::)", "name": "entity.name.namespace.argon" }
      ]
    },
    "numbers": {
      "match": "\\b[0-9][0-9_]*(\\.[0-9_]*)?([eE][+-]?[0-9_]+)?\\b|\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b",
      "name": "constant.numeric.argon"
    },
    "types": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.argon"
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.argon" }
      }
    },
    "operators": {
      "patterns": [
        { "match": "::", "name": "punctuation.separator.namespace.argon" },
        { "match": "=>|->", "name": "keyword.operator.arrow.argon" },
        { "match": "==|!=|<=|>=|&&|\\|\\||\\.\\.", "name": "keyword.operator.argon" },
        { "match": "[-+*/%<>!=]", "name": "keyword.operator.argon" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "[;,]", "name": "punctuation.separator.argon" },
        { "match": "\\.", "name": "punctuation.accessor.argon" }
      ]
    }
  }
}

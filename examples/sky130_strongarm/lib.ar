use sky130::{mos, tap};
use std::layout::{center_rects, crect, inst, max_array, mirror_pair, rect, text};
use std::schematic::{DeviceKind, Signal, device};

/// A StrongARM latch with an NMOS input pair, or a PMOS one if `pmos_input`.
///
/// Each `_w` is a finger width of at least 420 nm, and each `_nf` a finger
/// count. The four reset switches, on the outputs and on the input pair's
/// drains, share `reset_w` and `reset_nf`.
cell strong_arm(
    tail_w: Float,
    tail_nf: Int,
    input_w: Float,
    input_nf: Int,
    latch_in_w: Float,
    latch_in_nf: Int,
    latch_rst_w: Float,
    latch_rst_nf: Int,
    reset_w: Float,
    reset_nf: Int,
    pmos_input: Bool,
) {
    pub let clk = Signal();
    pub let inp = Signal();
    pub let inn = Signal();
    pub let outp = Signal();
    pub let outn = Signal();
    pub let vdd = Signal();
    pub let vss = Signal();
    let tail = Signal();
    let mn = Signal();
    let mp = Signal();

    // The input type's devices sit on the evaluation rail, and the reset
    // type's on the reset rail.
    let n = !pmos_input;
    let ev = if pmos_input { vdd } else { vss };
    let rs = if pmos_input { vss } else { vdd };
    fet(n, tail, clk, ev, ev, tail_w, tail_nf);
    fet(n, mn, inp, tail, ev, input_w, input_nf);
    fet(n, mp, inn, tail, ev, input_w, input_nf);
    fet(n, outn, outp, mn, ev, latch_in_w, latch_in_nf);
    fet(n, outp, outn, mp, ev, latch_in_w, latch_in_nf);
    fet(!n, outn, outp, rs, rs, latch_rst_w, latch_rst_nf);
    fet(!n, outp, outn, rs, rs, latch_rst_w, latch_rst_nf);
    for d in [outn, outp, mn, mp] {
        fet(!n, d, clk, rs, rs, reset_w, reset_nf);
    }

    // Rows from the bottom: the tail, the input pair, and the latch's
    // input-type and reset-type pairs. Left devices are on outn's side, and
    // pairs whose sources share a rail share their middle contact column.
    let t = inst(mos(n, tail_w, tail_nf));
    eq(t.cols.x0 + t.cols.x1, 0.);
    eq(t.g.y0, 0.);
    // The input pair folds when it has four fingers or more and would be twice
    // as wide as any other row.
    let widest = max_int(max_int(tail_nf / 2, latch_in_nf), max_int(latch_rst_nf, reset_nf));
    let fold = input_nf >= 4 && input_nf >= 2 * widest;
    let nf_low = if fold { input_nf - input_nf / 2 } else { input_nf };
    let input = pair(mos(n, input_w, nf_low), middle(nf_low));
    eq(input[0].g.y0, t.d.y1 + 155.);
    implant(n, input);
    let input_top = if fold { pair(mos(n, input_w, input_nf / 2), middle(input_nf / 2)) } else { input };
    if fold {
        eq(input_top[0].g.y0, input[0].d.y1 + 155.);
        implant(n, input_top);
    }
    let latch = pair(mos(n, latch_in_w, latch_in_nf), 265.);
    eq(latch[0].g.y0, input_top[0].d.y1 + 155.);
    implant(n, latch);
    let latch_rst = pair(mos(!n, latch_rst_w, latch_rst_nf), middle(latch_rst_nf));
    eq(latch_rst[0].g.y0, latch[0].d.y1 + 155.);
    implant(!n, latch_rst);

    // Above the reset rail's tap, the reset switches on the outputs sit upside
    // down under those on the input pair's drains, sharing their gate contact.
    let reset = mos(!n, reset_w, reset_nf);
    let rst_out = flipped_pair(reset, middle(reset_nf));
    let rst_mid = pair(reset, middle(reset_nf));
    eq(rst_mid[0].g.y0, rst_out[0].g.y0);
    implant(!n, rst_out);
    implant(!n, rst_mid);

    let half = std::max(std::max(std::max(t.sdm.x1, input[1].sdm.x1), latch[1].sdm.x1), std::max(latch_rst[1].sdm.x1, rst_mid[1].sdm.x1));
    let ev_tap = inst(rail(if n { 0 } else { 1 }, 2. * half - 260.), x=0.);
    eq(ev_tap.m1.y1 + 205., t.g.y0);
    let rs_tap = inst(rail(if n { 1 } else { 0 }, 2. * half - 260.), x=0.);
    eq(rs_tap.m1.y0, latch_rst[0].d.y1 + 140.);
    eq(rst_out[0].d.y0, rs_tap.m1.y1 + 140.);
    let well_y0 = if n { latch_rst[0].sdm.y0 } else { ev_tap.sdm.y0 };
    let well_y1 = if n { rst_mid[0].sdm.y1 } else { latch[0].sdm.y1 };
    rect("nwell.drawing", x0=-half - 50., x1=half + 50., y0=well_y0 - 50., y1=well_y1 + 50.);

    // Vertical met2 trunks join each net's bars, in slots 430 apart: the clock
    // down the middle, then on each side the rails, the tail, and the latch's
    // gates in turn; then an input below and an output above; then the input
    // pair's drain.
    via1(t.g, 0.);
    let clk_bar = rect("met1.drawing", x0=rst_out[0].g.x0, x1=rst_out[1].g.x1, y0=rst_out[0].g.y0, y1=rst_out[0].g.y1);
    via1(clk_bar, 0.);
    trunk(0., t.g, clk_bar);
    for i in [0, 1] {
        let a = if i == 0 { -430. } else { 430. };
        via1(ev_tap.m1, a);
        hook(t.s, a);
        trunk(a, ev_tap.m1, t.s);
        hook(t.d, a);
        hook(input[i].s, a);
        hook(input_top[i].s, a);
        trunk(a, t.d, input_top[i].s);
        hook(latch[i].g, a);
        hook(latch_rst[i].g, a);
        trunk(a, latch[i].g, latch_rst[i].g);
        hook(latch_rst[i].s, a);
        via1(rs_tap.m1, a);
        hook(rst_out[i].s, a);
        hook(rst_mid[i].s, a);
        trunk(a, latch_rst[i].s, rst_mid[i].s);

        let b = 2. * a;
        if fold {
            hook(input[i].g, b);
            hook(input_top[i].g, b);
            trunk(b, input[i].g, input_top[i].g);
        }
        hook(latch[i].d, b);
        hook(latch_rst[i].d, b);
        hook(rst_out[i].d, b);
        trunk(b, latch[i].g, rst_out[i].d);

        let c = 3. * a;
        hook(input[i].d, c);
        hook(input_top[i].d, c);
        hook(latch[i].s, c);
        hook(rst_mid[i].d, c);
        trunk(c, input[i].d, rst_mid[i].d);
    }
    // Each side's latch gates join the other side's output on met3.
    let to_outp = cross(-430., 860., mid_y(latch[0].g));
    let to_outn = cross(-860., 430., mid_y(latch[0].d) - 10.);

    pin(if n { "vss" } else { "vdd" }, "met1.pin", "met1.label", ev_tap.m1);
    pin(if n { "vdd" } else { "vss" }, "met1.pin", "met1.label", rs_tap.m1);
    pin("clk", "met1.pin", "met1.label", t.g);
    pin("inp", "met1.pin", "met1.label", input[0].g);
    pin("inn", "met1.pin", "met1.label", input[1].g);
    pin("outp", "met3.pin", "met3.label", to_outp);
    pin("outn", "met3.pin", "met3.label", to_outn);
}

fn fet(nfet: Bool, d: Signal, g: Signal, s: Signal, b: Signal, w: Float, nf: Int) {
    let total = w * (nf as Float) / 1000.;
    if nfet {
        device(DeviceKind::Nmos, [d, g, s, b], "sky130_fd_pr__nfet_01v8", w=total, l=0.15, nf=nf);
    } else {
        device(DeviceKind::Pmos, [d, g, s, b], "sky130_fd_pr__pfet_01v8", w=total, l=0.15, nf=nf);
    }
}

/// Where the right device of a pair whose devices have `nf` fingers starts: on
/// the left one's first contact column, unless single fingers' gate contacts
/// would collide.
fn middle(nf: Int) -> Float {
    if nf == 1 { 265. } else { -85. }
}

/// Places two copies of `c` mirrored about x = 0, the right one's first contact
/// column from `x0`, and returns the left one first. Their first columns,
/// sources, face each other, and with `x0 = -85.` they are one column;
/// with `x0 = 265.` their diffusions keep 270 apart.
fn pair(c: Any, x0: Float) -> [Any] {
    let p = mirror_pair(c, 0.);
    eq(p[0].cols.x0, x0);
    [p[1], p[0]]
}

/// A `pair` turned upside down: `reflect=true` flips a copy about the x axis,
/// and `angle=180` also mirrors it left to right.
fn flipped_pair(c: Any, x0: Float) -> [Any] {
    let left = inst(c, angle=180);
    let right = inst(c, reflect=true);
    eq(left.x + right.x, 0.);
    eq(left.y, right.y);
    eq(right.cols.x0, x0);
    [left, right]
}

/// Fills the implant across a pair of devices.
fn implant(nfet: Bool, p: [Any]) {
    rect(if nfet { "nsdm.drawing" } else { "psdm.drawing" }, x0=p[0].sdm.x0, x1=p[1].sdm.x1, y0=p[0].sdm.y0, y1=p[0].sdm.y1);
}

/// A tap `w` wide, centered on x = 0 and strapped with met1.
cell rail(ntap: Int, w: Float) {
    let t = inst(tap(ntap, w, 500.), x=-w / 2., y=0.);
    pub let sdm = t.sdm;
    pub let m1 = rect("met1.drawing", x0=t.li1.x0, y0=t.li1.y0, x1=t.li1.x1, y1=t.li1.y1);
    let mcon = crect(layer="mcon.drawing", x0=0., y0=0., w=170., h=170.);
    center_rects(m1, max_array(mcon, m1.w - 120., 170., 360., 360.));
}

fn mid_y(r: Rect) -> Float {
    grid_floor((r.y0 + r.y1) / 2.)
}

/// A via1 from the met1 bar `bar` up to a met2 pad on a trunk at `x`.
fn via1(bar: Rect, x: Float) {
    let y = mid_y(bar);
    rect("via.drawing", x0=x - 75., y0=y - 75., w=150., h=150.);
    rect("met2.drawing", x0=x - 130., y0=y - 160., w=260., h=320.);
}

/// Extends `bar` on met1 to reach `x`, with a via1 up to a trunk there.
fn hook(bar: Rect, x: Float) {
    rect("met1.drawing", x0=std::min(bar.x0, x - 130.), x1=std::max(bar.x1, x + 130.), y0=bar.y0, y1=bar.y1);
    via1(bar, x);
}

/// A met2 trunk at `x` between the vias on two bars.
fn trunk(x: Float, a: Rect, b: Rect) {
    rect("met2.drawing", x0=x - 70., x1=x + 70., y0=mid_y(a), y1=mid_y(b));
}

/// A met3 strap at height `y` joining the trunks at `x0` and `x1`.
fn cross(x0: Float, x1: Float, y: Float) -> Rect {
    for x in [x0, x1] {
        rect("via2.drawing", x0=x - 100., y0=y - 100., w=200., h=200.);
        rect("met2.drawing", x0=x - 140., y0=y - 185., w=280., h=370.);
    }
    rect("met3.drawing", x0=std::min(x0, x1) - 165., x1=std::max(x0, x1) + 165., y0=y - 165., h=330.)
}

/// Labels a port with a pin at the center of a shape.
fn pin(name: String, pin: String, label: String, r: Rect) {
    let p = rect(pin, w=140., h=140.);
    center_rects(r, p);
    text(name, label, p.x0 + 70., p.y0 + 70.);
}

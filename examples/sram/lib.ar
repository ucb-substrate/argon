// The complete SRAM for the generated sizing, with its lower-left corner at
// the origin.
cell example_sram() {
    let native = inst(logic::sram::sram_macro(generated::sram(), true), x=0., y=0.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// The SRAM inside its guard rings, with the bitcell array at the origin.
cell example_sram_inner() {
    let native = inst(logic::sram::sram_inner(generated::sram(), true), x=0., y=0.);
}

// The same SRAM without its control logic block; routes stop at its pins.
cell example_no_control_logic() {
    let native = inst(logic::sram::sram_macro(generated::sram(), false), x=0., y=0.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// The signal routes on their own, for comparing against other layouts.
cell example_sram_routes() {
    let native = inst(logic::sram::sram_routes(generated::sram()), x=0., y=0.);
}

cell example_no_control_logic_inner() {
    let native = inst(logic::sram::sram_inner(generated::sram(), false), x=0., y=0.);
}

// Native top-level assembly for the representative practical SRAM sizing.
// These coordinates follow SRAM22's alignment policy. Routing is generated
// below in Argon; there is no GDS import or reference-layout dependency.
cell no_control_logic_components_64x24(p: SramParams) {
    eq(p.num_words as Float, 64.);
    eq(p.data_width as Float, 24.);
    eq(p.mux_ratio as Float, 4.);
    eq(p.wmask_granularity as Float, 8.);
    let bitcells = inst(bitcells::array::sp_cell_array(16, 96, 4), x=0., y=0.);
    let cols = inst(columns::top::column_peripherals_exact(full_sram_col_params(p)), x=2500., y=-79240.);
    let row_decoder = inst(columns::decoder::row_decoder_64(), x=-79160., y=3635., angle=270);
    let address_gate = inst(columns::decoder::address_gate_stage(8), x=-114390., y=23255., reflect=true, angle=90);
    let wordline_enable = inst(columns::decoder::horizontal_fanout_buffer_64(3), x=-104390., y=3795.);
    let precharge_buffer = inst(columns::decoder::horizontal_fanout_buffer_64(0), x=-45740., y=-9240., angle=270);
    let column_decoder = inst(columns::decoder::column_decoder_64x24(), x=-50070., y=-45700., reflect=true, angle=90);
    let sense_enable = inst(columns::decoder::horizontal_fanout_buffer_64(2), x=-45310., y=-30590., angle=270);
    let write_enable = inst(columns::decoder::horizontal_fanout_buffer_64(1), x=-30910., y=-88890., angle=270);
    let dffs = inst(logic::dff::dff_array(8), x=-68800., y=-128215.);
    let replica_cells = inst(bitcells::array::replica_cell_array(4, 2), x=-92590., y=-30295.);
    let replica_pc = inst(columns::precharge::replica_precharge(practical_replica_precharge_params(p)), x=-92590., y=-5740., reflect=true);
    let replica_mos = inst(logic::replica::replica_column_mos(replica_gate_width(), replica_drain_n_width(p), replica_drain_p_width(p), replica_device_max_height(p)), x=-109390., y=-6455.);
    let replica_routing = inst(logic::replica::replica_metal_routing(replica_routing_m0_area(p), replica_routing_m1_area(p), columns::util::imax(replica_device_max_height(p), replica_column_height(p))), x=-114390., y=-2365., reflect=true);
}

cell example_no_control_logic_components() {
    let native = inst(no_control_logic_components_64x24(sram_params(8, 4, 64, 24)), x=0., y=0.);
}

cell no_control_logic_64x24(p: SramParams) {
    let components = inst(no_control_logic_components_64x24(p), x=0., y=0.);
    let routes = inst(logic::sram::core_routes_64x24(full_sram_col_params(p)), x=0., y=0.);
    let power = inst(logic::sram::dense_power_grid_64x24(), x=0., y=0.);
}

cell no_control_logic_guarded_64x24(p: SramParams) {
    let inner = inst(no_control_logic_64x24(p), x=0., y=0.);
    let ring = inst(logic::guard_ring::guard_ring(-126960., -135120., 163000., 47400.), x=0., y=0.);
    let connections = inst(logic::sram::guard_connections_64x24(full_sram_col_params(p)), x=0., y=0.);
    let addr = connections.addr;
    let ce = connections.ce;
    let we = connections.we;
    let clk = connections.clk;
    let rstb = connections.rstb;
    let din = connections.din;
    let dout = connections.dout;
    let wmask = connections.wmask;
    let vdd = connections.vdd;
    let vss = connections.vss;
}

cell example_no_control_logic_inner() {
    let native = inst(no_control_logic_64x24(sram_params(8, 4, 64, 24)), x=0., y=0.);
}

// Normalized guarded SRAM: the lower-left of the complete layout is at (0, 0).
cell example_no_control_logic() {
    let native = inst(no_control_logic_guarded_64x24(sram_params(8, 4, 64, 24)), x=131200., y=139360.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// Native Argon port of SRAM22 column peripherals.
// All layout dimensions are in Sky130 nanometers.

mod params;
mod generated;
mod sizing;

use std::layout::inst;
use lib::params::{ColParams, PrimitiveGateParams, SramLayoutParams};
use lib::columns::decoder;
use lib::logic::sram;

mod columns;
mod bitcells;
mod logic;

cell col_peripherals(p: ColParams) {
    let native = inst(columns::top::column_peripherals_exact(p), x=0., y=0.);
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
    let pc_b = native.pc_b;
    let precharge_en = native.precharge_en;
    let sense_en = native.sense_en;
    let clk = native.clk;
    let rstb = native.rstb;
    let we = native.we;
    let write_en = native.write_en;
    let sel = native.sel;
    let sel_b = native.sel_b;
    let bl = native.bl;
    let br = native.br;
}

cell col_peripherals_for_sram(p: SramLayoutParams) {
    inst(col_peripherals(p.standalone_col), x=0., y=0.);
}

cell example_col_peripherals() {
    inst(col_peripherals_for_sram(generated::sram()), x=0., y=0.);
}

cell bitcell_array(p: SramLayoutParams) {
    inst(
        bitcells::array::sp_cell_array(
            p.sram.num_words / p.sram.mux_ratio,
            p.sram.data_width * p.sram.mux_ratio,
            p.sram.mux_ratio,
        ),
        x=0.,
        y=0.,
    );
}

cell example_control_logic() {
    inst(logic::control::control_logic_replica_v2(generated::sram().control), x=0., y=0.);
}

cell example_bitcell_array() {
    inst(bitcell_array(generated::sram()), x=0., y=0.);
}

cell replica_bitcell_array(p: SramLayoutParams) {
    inst(bitcells::array::replica_cell_array(p.replica_rows, 2), x=0., y=0.);
}

cell example_replica_bitcell_array() {
    inst(replica_bitcell_array(generated::sram()), x=0., y=0.);
}

cell address_dff_array(p: SramLayoutParams) {
    inst(logic::dff::dff_array(p.address_dff_count), x=0., y=0.);
}

cell example_address_dff_array() {
    inst(address_dff_array(generated::sram()), x=0., y=0.);
}

cell replica_precharge(p: SramLayoutParams) {
    inst(columns::precharge::replica_precharge(p.replica_precharge), x=0., y=0.);
}

cell example_replica_precharge() {
    inst(replica_precharge(generated::sram()), x=0., y=0.);
}

cell replica_column_devices(p: SramLayoutParams) {
    inst(logic::replica::replica_column_mos(p.replica_column), x=0., y=0.);
}

cell example_replica_column_devices() {
    inst(replica_column_devices(generated::sram()), x=0., y=0.);
}

cell replica_metal_routing(p: SramLayoutParams) {
    inst(logic::replica::replica_metal_routing(p.replica_routing), x=0., y=0.);
}

cell example_replica_metal_routing() {
    inst(replica_metal_routing(generated::sram()), x=0., y=0.);
}

cell example_guard_ring() {
    let p = generated::sram();
    let hole = sram::ring_hole(logic::floorplan::sram_grid(p, logic::floorplan::sram_floorplan(p)));
    inst(logic::guard_ring::guard_ring(hole.x0, hole.y0, hole.x1, hole.y1), x=0., y=0.);
}

cell example_address_gate() {
    inst(
        decoder::and2_gate(
            PrimitiveGateParams { nwidth: 2000, pwidth: 2500, length: 150 },
            PrimitiveGateParams { nwidth: 4000, pwidth: 10000, length: 150 },
            pins=true,
        ),
        x=0.,
        y=0.,
    );
}

cell example_address_gate_stage() {
    inst(decoder::address_gate_stage(8), x=0., y=0.);
}

cell example_row_leaf_decoder_stage() {
    let r = generated::sram().periphery.row_decoder;
    inst(decoder::row_decoder_node(r, 1, 30000), x=0., y=0.);
}

cell example_multifinger_inv(nwidth: Int, pwidth: Int) {
    inst(decoder::mf_inv(nwidth, pwidth, pins=true), x=0., y=0.);
}

cell example_multifinger_decoder_gate(nwidth: Int, pwidth: Int) {
    inst(decoder::mf_gate(nwidth, pwidth, pins=true), x=0., y=0.);
}

cell example_multifinger_decoder_tap(nwidth: Int, pwidth: Int) {
    inst(decoder::mf_tap(nwidth, pwidth, width=1580), x=0., y=0.);
}

cell example_row_root_decoder_stage() {
    let r = generated::sram().periphery.row_decoder;
    inst(decoder::row_decoder_stage(decoder::node_stage(r, 0, 0)), x=0., y=0.);
}

cell example_row_decoder() {
    inst(decoder::row_decoder(generated::sram().periphery.row_decoder), x=0., y=0.);
}

cell example_relaxed_nand2_decoder_gate() {
    inst(
        decoder::dec_gate(2, 2000, 2500, width=1900, signal_pins=true, supply_pins=true),
        x=0.,
        y=0.,
    );
}

cell example_relaxed_nand2_decoder_tap() {
    inst(decoder::dec_tap(2, 2000, 2500), x=0., y=0.);
}

cell example_column_decoder_stage() {
    inst(
        decoder::column_decoder_stage(
            decoder::col_decoder_layout(generated::sram().periphery.col_decoder, 37000),
            false,
        ),
        x=0.,
        y=0.,
    );
}

cell example_column_decoder() {
    inst(
        decoder::column_decoder(decoder::col_decoder_layout(
            generated::sram().periphery.col_decoder,
            37000,
        )),
        x=0.,
        y=0.,
    );
}

cell example_precharge_buffer() {
    inst(
        decoder::fanout_buffer(decoder::buffer_layout(
            generated::sram().periphery.pc_b_buffer,
            13000,
            false,
        )),
        x=0.,
        y=0.,
    );
}

cell example_write_enable_buffer() {

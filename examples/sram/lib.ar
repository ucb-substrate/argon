// The complete SRAM for the generated sizing, with its lower-left corner at
// the origin.
cell example_sram() {
    let native = inst(sram::sram_macro(generated::sram(), true), x=0., y=0.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// The complete SRAM for any organization the Rust sizer supports, sized when
// the cell compiles.
cell example_sized_sram(wmask_granularity: Int, mux_ratio: Int, num_words: Int, data_width: Int) {
    let p = sizing::sram(wmask_granularity, mux_ratio, num_words, data_width);
    let native = inst(sram::sram_macro(p, true), x=0., y=0.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// The SRAM inside its guard rings, with the bitcell array at the origin.
cell example_sram_inner() {
    inst(sram::sram_inner(generated::sram(), true), x=0., y=0.);
}

// The same SRAM without its control logic block; routes stop at its pins.
cell example_no_control_logic() {
    let native = inst(sram::sram_macro(generated::sram(), false), x=0., y=0.);
    let addr = native.addr;
    let ce = native.ce;
    let we = native.we;
    let clk = native.clk;
    let rstb = native.rstb;
    let din = native.din;
    let dout = native.dout;
    let wmask = native.wmask;
    let vdd = native.vdd;
    let vss = native.vss;
}

// The signal routes on their own, for comparing against other layouts.
cell example_sram_routes() {
    inst(sram::sram_routes(generated::sram()), x=0., y=0.);
}

cell example_no_control_logic_inner() {
    inst(sram::sram_inner(generated::sram(), false), x=0., y=0.);
}

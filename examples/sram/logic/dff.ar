// The address DFFs: tapped DFF tiles on a 6.1 um pitch, matching four 1.2 um
// columns plus the 1.3 um substrate tap used throughout the SRAM.

use std::layout::{crect, inst};

fn dff_x(index: Int) -> Float { 4715. + index as Float * 6100. }

cell dff_array(count: Int) {
    for index in std::range(count) {
        inst(lib::logic::fixed_macros::tapped_dff(), x=dff_x(index), y=0.);
    }
    let w = count as Float * 6100.;
    pub let d = ports(count, -1570., 125., 760., 390.);
    pub let q = ports(count, -2980., 13135., 2650., 170.);
    pub let q_n = ports(count, -2900., 10895., 1580., 170.);
    pub let clk = crect(x0=0., y0=6715., x1=w, y1=7035.);
    pub let rstb = crect(x0=0., y0=2480., x1=w, y1=2800.);
    pub let vdd = ports(count, -3575., 0., 490., 13920.);
    pub let vss = ports(count, -245., 0., 490., 13920.);
}

// One port per DFF, at (dx, y0) from each tile's origin and w by h.
fn ports(count: Int, dx: Float, y0: Float, w: Float, h: Float) -> [Rect] {
    [for i in std::range(count) { crect(x0=dff_x(i) + dx, y0=y0, w=w, h=h) }]
}

// The assembled SRAM: blocks placed by the floorplan, signal routes, power,
// guard rings, and pins.

use std::layout::{crect, inst};
use lib::params::SramLayoutParams;
use lib::logic::floorplan::{Blocks, Grid, SramFloorplan};
use lib::logic::routing::Shapes;
use lib::logic::power::Straps;
use lib::columns::{top, util};
use lib::logic::{floorplan, guard_ring, routing};
use lib::columns::util::Via;

// All signal routes, returning the shapes they use outside the blocks.
fn draw_signal_routes(p: SramLayoutParams, g: Grid, f: SramFloorplan, b: Blocks) -> Shapes {
    let words = p.sram.data_width;
    routing::join_all([
        routing::draw_bitlines(b.cols, b.bitcells, p.col.cols),
        routing::draw_wordlines(b.dec, b.bitcells, p.sram.num_words / p.sram.mux_ratio),
        routing::draw_replica_bitlines(b.rbl, b.rpc),
        routing::draw_replica_load_route(b.rpc, b.nmos, b.routing),
        routing::draw_dff_pins(g, b.dffs, p.address_dff_count),
        routing::draw_predecode_routes(g, f, b.gate, b.dec, 2 * floorplan::row_bits(p)),
        routing::draw_buffer_column_routes(p, g, f, b.cols, b.pc_b, b.sense, b.write),
        routing::draw_col_select_routes(p, g, f, b.col_dec, b.cols),
        routing::draw_clock_reset_routes(p, g, f, b.control, b.dffs, b.cols),
        routing::draw_ce_we_routes(p, g, f, b.control, b.dffs),
        routing::draw_replica_control_routes(p, g, b.control, b.rbl, b.rpc),
        routing::draw_enable_routes(g, b.control, b.wlen, b.gate, b.pc_b),
        routing::draw_buffer_enable_routes(g, f, b.control, b.sense, b.write),
        routing::draw_col_address_routes(p, g, f, b.col_dec, b.dffs),
        routing::draw_row_address_routes(p, g, f, b.gate, b.dffs),
        routing::draw_data_pins(g, b.cols, words, words / p.sram.wmask_granularity),
    ])
}

// The signal routes alone, drawn against construction copies of the blocks.
cell sram_routes(p: SramLayoutParams) {
    let f = floorplan::sram_floorplan(p);
    draw_signal_routes(p, floorplan::sram_grid(p, f), f, floorplan::place(p, f, true, true));
}

// The SRAM inside its guard ring: blocks, signal routes, and power, with the
// bitcell array at the origin. Without control logic, the routes stop at its
// pins.
cell sram_inner(p: SramLayoutParams, with_control: Bool) {
    let f = floorplan::sram_floorplan(p);
    let b = floorplan::place(p, f, false, with_control);
    let routes = draw_signal_routes(p, floorplan::sram_grid(p, f), f, b);
    pub let straps = lib::logic::power::draw_power(p, f, b, routes);
}

// The guard ring's hole: the routing grid's metal extent with 1 um to spare.
fn ring_hole(g: Grid) -> Rect {
    let e = crect(
        x0=g.x0 - 160.,
        y0=g.y0 - 160.,
        x1=g.x0 + 680. * (g.nx - 1) as Float + 160.,
        y1=g.y0 + 680. * (g.ny - 1) as Float + 160.,
    );
    util::grow(e, 1000., 1000.)
}

// The full layout's bounds: the VDD ring's hole is 2.72 um outside the VSS
// ring's, and its nwell frame 1.52 um beyond that.
fn macro_bounds(g: Grid) -> Rect {
    util::grow(ring_hole(g), 4240., 4240.)
}

// Each strap that reaches the routing area's edge runs on to the outer edge
// of its supply's ring, with vias onto the ring's crossing sides and, for
// met1 straps, onto its tap. Met2 straps become supply pins.
fn extend_straps(ring: Any, placed: Straps) {
    // Each instance field read places its rects anew, so read the rings once.
    let rings = [ring.vss_ring, ring.vdd_ring];
    for s in placed.straps {
        let r0 = lib::logic::router::from_box(s.rect);
        let rg = rings[if s.vdd { 1 } else { 0 }];
        let outer = rg.outer;
        let vertical = s.layer == 0;
        let lo = if s.lower_boundary {
            if vertical { outer.y0 } else { outer.x0 }
        } else {
            if vertical { r0.y0 } else { r0.x0 }
        };
        let hi = if s.upper_boundary {
            if vertical { outer.y1 } else { outer.x1 }
        } else {
            if vertical { r0.y1 } else { r0.x1 }
        };
        let r = if vertical {
            crect(x0=r0.x0, y0=lo, x1=r0.x1, y1=hi)
        } else {
            crect(x0=lo, y0=r0.y0, x1=hi, y1=r0.y1)
        };
        // Sides in ring order: left, right, bottom, top.
        let ends = std::concat(
            if s.upper_boundary { [if vertical { 3 } else { 1 }] } else { [] },
            if s.lower_boundary { [if vertical { 2 } else { 0 }] } else { [] },
        );
        for k in ends {
            if vertical {
                util::contact(Via::Via1, r, rg.sides[k], longer=true, later=true);
            } else {
                util::contact(Via::Via1, rg.sides[k], r, longer=true, later=true);
            }
        }
        if vertical {
            for k in ends {
                util::contact(Via::Mcon, rg.mids[k], r, longer=true, later=true);
            }
            util::draw_box("met1.drawing", r);
        } else {
            util::met2_port(r.x0, r.y0, r.x1, r.y1);
        }
    }
}

// A pin from a signal's track down through the guard rings.
fn pin_down(g: Grid, track: Rect) -> Rect {
    util::met1_port(track.x0, macro_bounds(g).y0, track.x1, g.y0 + 320.)
}

// The SRAM with its guard rings and pins. `addr[k]` comes from address DFF
// `addr_width - 1 - k`; the last two DFFs take the chip and write enables.
cell sram(p: SramLayoutParams, with_control: Bool) {
    let f = floorplan::sram_floorplan(p);
    let g = floorplan::sram_grid(p, f);
    let inner = inst(sram_inner(p, with_control), x=0., y=0.);
    let hole = ring_hole(g);
    let ring = inst(guard_ring::guard_ring(hole.x0, hole.y0, hole.x1, hole.y1), x=0., y=0.);
    extend_straps(ring, inner.straps);
    let dffs = inst(
        lib::logic::dff::dff_array(p.address_dff_count),
        x=f.dffs.0,
        y=f.dffs.1,
        construction=true,
    );
    let cols = inst(
        top::column_peripherals_exact(p.col),
        x=f.cols.0,
        y=f.cols.1,
        construction=true,
    );
    let n = p.address_dff_count;
    let dff = [for k in std::range(n) { pin_down(g, routing::dff_pin(g, dffs, k)) }];
    pub let addr = [for k in std::range(n - 2) { dff[n - 3 - k] }];
    pub let ce = dff[n - 2];
    pub let we = dff[n - 1];
    pub let clk = pin_down(g, routing::clock_pin(g, f, 0));
    pub let rstb = pin_down(g, routing::clock_pin(g, f, 1));
    pub let din = [for r in cols.din { pin_down(g, r) }];
    pub let dout = [for r in cols.dout { pin_down(g, r) }];
    pub let wmask = [for r in cols.wmask { pin_down(g, r) }];
    // The rings' left sides.
    pub let vdd = ring.vdd_ring.sides[0];
    pub let vss = ring.vss_ring.sides[0];
}

// The SRAM with its lower-left corner at the origin.
cell sram_macro(p: SramLayoutParams, with_control: Bool) {
    let b = macro_bounds(floorplan::sram_grid(p, floorplan::sram_floorplan(p)));
    let native = inst(sram(p, with_control), x=-b.x0, y=-b.y0);
    pub let addr = native.addr;
    pub let ce = native.ce;
    pub let we = native.we;
    pub let clk = native.clk;
    pub let rstb = native.rstb;
    pub let din = native.din;
    pub let dout = native.dout;
    pub let wmask = native.wmask;
    pub let vdd = native.vdd;
    pub let vss = native.vss;
}

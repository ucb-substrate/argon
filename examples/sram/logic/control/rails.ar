// Supply pins on the control logic's row rails. A rail exposes the supply
// pins of the cells beside it, except those of the taps inside inverter
// chains and of the SR latches' output inverters; each connected span of
// exposed rail is one pin.

fn concat(a: [(Float, Float)], b: [(Float, Float)]) -> [(Float, Float)] {
    if a == [] { b } else { cons(head(a), concat(tail(a), b)) }
}

// Rail spans hidden by the taps inside an inverter chain at x, from group g on.
fn inv_chain_gaps(x: Float, n: Int, g: Int) -> [(Float, Float)] {
    if 7 * g >= n {
        []
    } else {
        let tap_x1 = x + lib::logic::control::blocks::inv_chain_x(7 * g);
        cons((tap_x1 - lib::logic::control::blocks::tap_w(), tap_x1,), inv_chain_gaps(x, n, g + 1))
    }
}

// Rail span hidden by the output inverters of an SR latch at x.
fn sr_latch_gaps(x: Float) -> [(Float, Float)] {
    cons((x + lib::logic::control::blocks::sr_latch_inverters_x(), x + lib::logic::control::blocks::sr_latch_w(),), [])
}

// The spans of [start, end] outside the sorted, disjoint `gaps`.
fn row_spans(gaps: [(Float, Float)], start: Float, end: Float) -> [(Float, Float)] {
    if gaps == [] {
        cons((start, end,), [])
    } else {
        cons((start, head(gaps).0,), row_spans(tail(gaps), head(gaps).1, end))
    }
}

fn merge_sorted(a: [(Float, Float)], b: [(Float, Float)]) -> [(Float, Float)] {
    if a == [] {
        b
    } else if b == [] {
        a
    } else if head(a).0 <= head(b).0 {
        cons(head(a), merge_sorted(tail(a), b))
    } else {
        cons(head(b), merge_sorted(a, tail(b)))
    }
}

fn coalesce_from(cur: (Float, Float), rest: [(Float, Float)]) -> [(Float, Float)] {
    if rest == [] {
        cons(cur, [])
    } else if head(rest).0 <= cur.1 {
        coalesce_from((cur.0, lib::columns::util::fmax(cur.1, head(rest).1),), tail(rest))
    } else {
        cons(cur, coalesce_from(head(rest), tail(rest)))
    }
}

// Connected spans of a rail shared by two rows with the given spans.
fn shared_spans(a: [(Float, Float)], b: [(Float, Float)]) -> [(Float, Float)] {
    let all = merge_sorted(a, b);
    coalesce_from(head(all), tail(all))
}

// Draws a labeled met1 pin over each span of the 490 nm rail centered at y.
fn rail_pins(name: String, y: Float, spans: [(Float, Float)]) {
    for s in spans {
        rect("met1.pin", x0=s.0, y0=y - 245., x1=s.1, y1=y + 245.);
        text(name, "met1.label", lib::columns::util::snap5((s.0 + s.1) / 2.), y);
    }
}

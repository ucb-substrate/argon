// SRAM power distribution. Every block's supply pins are extended to targets,
// and the greedy router's free met1 and met2 tracks become straps where they
// reach a target or cross another strap of their supply. Even tracks carry
// VSS and odd tracks VDD.

use std::layout::{crect, rect, shapes, text, union};
use lib::params::SramLayoutParams;
use lib::logic::floorplan::{Blocks, SramFloorplan};
use lib::logic::routing::Shapes;
use lib::logic::router::{
    block,
    from_box,
    m1,
    m2,
    to_box,
    track_grid,
    Grid as RouterGrid,
    RoutedVia,
    RouterBox,
    RouterOp,
};
use lib::columns::util;
use lib::logic::floorplan;
use lib::columns::util::Via;

struct StrapTarget {
    layer: Int,
    vdd: Bool,
    rect: RouterBox,
}

// `blocks[l]` are blocked on layer `l` before `ops` run.
struct StrapJob {
    grid: RouterGrid,
    blocks: [[RouterBox]],
    ops: [RouterOp],
    targets: [StrapTarget],
    strap_layers: [Int],
    manufacturing_grid: Int,
}

struct PlacedStrap {
    layer: Int,
    rect: RouterBox,
    vdd: Bool,
    lower_boundary: Bool,
    upper_boundary: Bool,
}

// Vias that are translated copies of `via`, one per offset.
struct Crossing {
    via: RoutedVia,
    offsets: [(Float, Float)],
}

struct Straps {
    straps: [PlacedStrap],
    vias: [RoutedVia],
    crossings: [Crossing],
}

// Places straps on the free met1 and met2 tracks that reach a target or cross
// a strap of their supply.
extern "routing" fn straps(job: StrapJob) -> Straps;

fn blocks_on(layer: Int, l: [Rect]) -> [RouterOp] { [for r in l { block(layer, r) }] }

// The router's area: the block bbox grown by eight tracks, four more on the
// right and room for the row address routes on the left, snapped to the
// 680 nm pitch.
fn router_area(p: SramLayoutParams, f: SramFloorplan) -> Rect {
    let b = f.boxes.all;
    crect(
        x0=floorplan::snap(b.x0 - 5440. - 1400. * floorplan::row_bits(p) as Float, 680),
        y0=floorplan::snap(b.y0 - 5440., 680),
        x1=floorplan::snap(b.x1 + 5440. + 2720., 680),
        y1=floorplan::snap(b.y1 + 5440., 680),
    )
}

// What keeps straps away besides the blocks' own metal: their supply pins, the
// arrays and column periphery outright, and every signal route.
fn router_blocks(
    f: SramFloorplan,
    pin_boxes: [Rect],
    dec_pin_boxes: [Rect],
    routes: Shapes,
) -> [RouterOp] {
    let b = f.boxes;
    std::flatten([
        blocks_on(m2(), pin_boxes),
        blocks_on(
            m2(),
            [for r in dec_pin_boxes { crect(x0=r.x0, y0=r.y0, x1=r.x1 + 6000., y1=r.y1) }],
        ),
        [for r in [
            b.row_decoder,
            b.col_decoder,
            b.pc_b_buffer,
            b.sense_en_buffer,
            b.write_driver_en_buffer,
        ] {
            block(m1(), crect(x0=r.x0, y0=r.y0, x1=r.x1 + 1400., y1=r.y1))
        }],
        [
            block(m1(), util::grow(b.bitcells, 140., 6000.)),
            block(m2(), util::grow(b.bitcells, 6000., 140.)),
            block(m1(), util::grow(b.cols, 140., 6000.)),
            block(m2(), util::grow(b.cols, 6000., 140.)),
            block(
                m1(),
                util::grow(
                    crect(x0=b.rbl.x0 + 2520., y0=b.rbl.y0, x1=b.rbl.x1 - 2520., y1=b.rbl.y1),
                    140.,
                    6000.,
                ),
            ),
            block(m2(), util::grow(b.rbl, 3480., 140.)),
        ],
        blocks_on(m1(), routes.m1),
        blocks_on(m2(), routes.m2),
    ])
}

fn bbox_of(l: [Rect]) -> Rect {
    if std::len(l) == 1 { head(l) } else { union(head(l), bbox_of(tail(l))) }
}

// A labeled met2 supply pin of the SRAM.
fn supply_pin(vdd: Bool, r: Rect) {
    rect("met2.pin", x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1);
    text(
        if vdd { "vdd" } else { "vss" },
        "met2.label",
        util::snap5((r.x0 + r.x1) / 2.),
        util::snap5((r.y0 + r.y1) / 2.),
    );
}

fn target(layer: Int, vdd: Bool, r: Rect) -> StrapTarget {
    StrapTarget { layer: layer, vdd: vdd, rect: to_box(r) }
}

// Targets, and the router blocks of the metal drawn for them.
struct PowerPart {
    targets: [StrapTarget],
    blocks: [RouterOp],
}

fn part(targets: [StrapTarget], blocks: [RouterOp]) -> PowerPart {
    PowerPart { targets: targets, blocks: blocks }
}

fn join_parts(l: [PowerPart]) -> PowerPart {
    part(std::flatten([for x in l { x.targets }]), std::flatten([for x in l { x.blocks }]))
}

// Spans sorted by start, equal starts kept in order.
fn sort_spans(l: [(Float, Float)]) -> [(Float, Float)] {
    let n = std::len(l);
    if n <= 1 {
        l
    } else {
        let half = n / 2;
        merge_sorted_spans(
            sort_spans([for i in range_full(0, half, 1) { l[i] }]),
            sort_spans([for i in range_full(half, n, 1) { l[i] }]),
        )
    }
}

fn merge_sorted_spans(a: [(Float, Float)], b: [(Float, Float)]) -> [(Float, Float)] {
    if a == [] {
        b
    } else if b == [] {
        a
    } else if head(b).0 < head(a).0 {
        cons(head(b), merge_sorted_spans(a, tail(b)))
    } else {
        cons(head(a), merge_sorted_spans(tail(a), b))
    }
}

fn span_gap(a: (Float, Float), b: (Float, Float)) -> Float {
    max_float(0., max_float(a.1, b.1) - min_float(a.0, b.0) - (a.1 - a.0) - (b.1 - b.0))
}

// Sorted spans with each joined to the next when less than 400 nm apart.
fn merge_close_spans(l: [(Float, Float)]) -> [(Float, Float)] {
    if l == [] { [] } else { merge_from(head(l), tail(l)) }
}

fn merge_from(cur: (Float, Float), rest: [(Float, Float)]) -> [(Float, Float)] {
    if rest == [] {
        [cur]
    } else if span_gap(cur, head(rest)) < 400. {
        merge_from((min_float(cur.0, head(rest).0), max_float(cur.1, head(rest).1),), tail(rest))
    } else {
        cons(cur, merge_from(head(rest), tail(rest)))
    }
}

// One supply's array pins on one layer, on one side of the array's center:
// each pin runs out to the edge of `t`, and each group of pins less than
// 400 nm apart gets a `length` target band just inside that edge.
fn array_side(
    t: Rect,
    pins: [Rect],
    vdd: Bool,
    vertical: Bool,
    positive: Bool,
    length: Float,
) -> [StrapTarget] {
    let layer = if vertical { "met1.drawing" } else { "met2.drawing" };
    let edge = if vertical {
        if positive { t.y1 } else { t.y0 }
    } else {
        if positive { t.x1 } else { t.x0 }
    };
    for r in pins {
        if vertical {
            rect(layer, x0=r.x0, y0=min_float(r.y0, edge), x1=r.x1, y1=max_float(r.y1, edge));
        } else {
            rect(layer, x0=min_float(r.x0, edge), y0=r.y0, x1=max_float(r.x1, edge), y1=r.y1);
        }
    }
    let band = if positive { (edge - length, edge,) } else { (edge, edge + length,) };
    let spans = merge_close_spans(sort_spans([for r in pins {
        if vertical { (r.x0, r.x1,) } else { (r.y0, r.y1,) }
    }]));
    [for s in spans {
        let r = if vertical {
            crect(x0=s.0, y0=band.0, x1=s.1, y1=band.1)
        } else {
            crect(x0=band.0, y0=s.0, x1=band.1, y1=s.1)
        };
        rect(layer, x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1);
        target(if vertical { m1() } else { m2() }, vdd, r)
    }]
}

// A bitcell array's supply pins brought out past its edges: met1 pins up and
// down, met2 pins left and right.
fn connect_array(
    b: Rect,
    vdd_m1: [Rect],
    vss_m1: [Rect],
    vdd_m2: [Rect],
    vss_m2: [Rect],
    expand: Float,
) -> [StrapTarget] {
    let t = crect(x0=b.x0 - expand, y0=b.y0 - 3500., x1=b.x1 + expand, y1=b.y1 + 3500.);
    let cx = util::cx_i(b);
    let cy = util::cy_i(b);
    std::flatten([for vertical in [true, false] {
        std::flatten([for vdd in [true, false] {
            let pins = if vertical {
                if vdd { vdd_m1 } else { vss_m1 }
            } else {
                if vdd { vdd_m2 } else { vss_m2 }
            };
            let below = [for r in pins if (if vertical { util::cy_i(r) < cy } else { util::cx_i(r) < cx }) {
                r
            }];
            let above = [for r in pins if !(if vertical { util::cy_i(r) < cy } else { util::cx_i(r) < cx }) {
                r
            }];
            std::concat(
                if below == [] {
                    []
                } else {
                    array_side(t, below, vdd, vertical, false, if vertical { 3300. } else { 5520. })
                },
                if above == [] {
                    []
                } else {
                    array_side(t, above, vdd, vertical, true, if vertical { 3300. } else { 5520. })
                },
            )
        }])
    }])
}

// The column periphery's short supply pins, run out 5 um past either side
// of it on met2, with an M1-M2 via where the pin is on met1.
fn connect_cols(
    b: Rect,
    vdd_m1: [Rect],
    vss_m1: [Rect],
    vdd_m2: [Rect],
    vss_m2: [Rect],
) -> PowerPart {
    join_parts(std::flatten([for on_m1 in [true, false] {
        [for vdd in [true, false] {
            let pins = if on_m1 {
                if vdd { vdd_m1 } else { vss_m1 }
            } else {
                if vdd { vdd_m2 } else { vss_m2 }
            };
            let short = [for r in pins if r.y1 - r.y0 < 5000. { r }];
            let rects = std::flatten([for r in short {
                [
                    crect(x0=b.x0 - 5000., y0=r.y0, x1=r.x0 + 800., y1=r.y1),
                    crect(x0=r.x1 - 800., y0=r.y0, x1=b.x1 + 5000., y1=r.y1),
                ]
            }]);
            for r in short {
                if on_m1 {
                    util::contact(
                        Via::Via1,
                        r,
                        crect(x0=b.x0 - 5000., y0=r.y0, x1=r.x0 + 800., y1=r.y1),
                        longer=true,
                        later=true,
                    );
                    util::contact(
                        Via::Via1,
                        r,
                        crect(x0=r.x1 - 800., y0=r.y0, x1=b.x1 + 5000., y1=r.y1),
                        longer=true,
                        later=true,
                    );
                }
            }
            for r in rects { rect("met2.drawing", x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1); }
            for r in if on_m1 {
                rects
            } else {
                [for q in short { crect(x0=b.x0 - 5000., y0=q.y0, x1=b.x1 + 5000., y1=q.y1) }]
            } {
                supply_pin(vdd, r);
            }
            part([for r in rects { target(m2(), vdd, r) }], blocks_on(m2(), rects))
        }]
    }]))
}

// A block's met2 supply pins carried 2 um past its top and bottom on met1.
fn extend_m2_pins(b: Rect, vdd: [Rect], vss: [Rect]) -> PowerPart {
    for r in vdd { supply_pin(true, r); }
    for r in vss { supply_pin(false, r); }
    join_parts([for supply in [true, false] {
        let rects = std::flatten([for r in if supply { vdd } else { vss } {
            [
                crect(x0=r.x0, y0=b.y0 - 2000., x1=r.x1, y1=r.y0 + 800.),
                crect(x0=r.x0, y0=r.y1 - 800., x1=r.x1, y1=b.y1 + 2000.),
            ]
        }]);
        for r in rects { rect("met1.drawing", x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1); }
        part([for r in rects { target(m1(), supply, r) }], blocks_on(m1(), rects))
    }])
}

// Met2 supply pins widened sideways by `d` on each side.
fn widen_m2_pins(vdd: [Rect], vss: [Rect], d: Float) -> PowerPart {
    join_parts([for supply in [true, false] {
        let rects = [for r in if supply { vdd } else { vss } {
            crect(x0=r.x0 - d, y0=r.y0, x1=r.x1 + d, y1=r.y1)
        }];
        for r in rects {
            rect("met2.drawing", x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1);
            supply_pin(supply, r);
        }
        part([for r in rects { target(m2(), supply, r) }], blocks_on(m2(), rects))
    }])
}

fn m1_pin_targets(vdd: [Rect], vss: [Rect]) -> [StrapTarget] {
    std::concat([for r in vdd { target(m1(), true, r) }], [for r in vss { target(m1(), false, r) }])
}

// The drawn metal of `insts` on `layer`, as router boxes.
fn drawn_boxes(insts: [Any], layer: String) -> [RouterBox] {
    std::flatten([for i in insts { [for r in shapes(i, layer) { to_box(r) }] }])
}

fn draw_power(p: SramLayoutParams, f: SramFloorplan, blocks: Blocks, routes: Shapes) -> Straps {
    let Blocks {
        bitcells,
        cols,
        gate,
        dec,
        col_dec,
        pc_b,
        wlen,
        sense,
        write,
        dffs,
        control,
        rbl,
        rpc,
        nmos,
        routing,
    } = blocks;
    let b = f.boxes;
    let insts = [gate, dec, col_dec, pc_b, wlen, sense, write, dffs, control, rpc, nmos, routing];
    let pin_boxes = std::flatten([for i in [col_dec, pc_b, sense, write] {
        [bbox_of(i.vdd_pins_m2), bbox_of(i.vss_pins_m2)]
    }]);
    let dec_pin_boxes = [bbox_of(dec.vdd_pins_m2), bbox_of(dec.vss_pins_m2)];
    let rbl_wl = p.replica_rows / 2;
    let rbl_wl_pins = rbl.wl_pins_m2;
    let rbl_vss_m2 = std::concat(
        rbl.vss_pins_m2,
        std::flatten([for i in std::range(p.replica_rows) if i != rbl_wl { rbl_wl_pins[i] }]),
    );
    let power = join_parts([
        part(
            connect_array(
                b.bitcells,
                bitcells.vdd_pins_m1,
                bitcells.vss_pins_m1,
                bitcells.vdd_pins_m2,
                bitcells.vss_pins_m2,
                5720.,
            ),
            [],
        ),
        part(
            connect_array(
                b.rbl,
                rbl.vdd_pins_m1,
                rbl.vss_pins_m1,
                rbl.vdd_pins_m2,
                rbl_vss_m2,
                3200.,
            ),
            [],
        ),
        connect_cols(
            b.cols,
            cols.vdd_pins_m1,
            cols.vss_pins_m1,
            cols.vdd_pins_m2,
            cols.vss_pins_m2,
        ),
        part(std::flatten([
            m1_pin_targets(dec.vdd_pins_m1, dec.vss_pins_m1),
            m1_pin_targets(gate.vdd_pins_m1, gate.vss_pins_m1),
            m1_pin_targets(col_dec.vdd_pins_m1, col_dec.vss_pins_m1),
            m1_pin_targets(dffs.vdd, dffs.vss),
            m1_pin_targets(control.vdd_pins_m1, control.vss_pins_m1),
            m1_pin_targets(pc_b.vdd_pins_m1, pc_b.vss_pins_m1),
            m1_pin_targets(sense.vdd_pins_m1, sense.vss_pins_m1),
            m1_pin_targets(write.vdd_pins_m1, write.vss_pins_m1),
        ]), []),
        extend_m2_pins(b.row_decoder, dec.vdd_pins_m2, dec.vss_pins_m2),
        extend_m2_pins(b.addr_gate, gate.vdd_pins_m2, gate.vss_pins_m2),
        extend_m2_pins(b.col_decoder, col_dec.vdd_pins_m2, col_dec.vss_pins_m2),
        extend_m2_pins(b.pc_b_buffer, pc_b.vdd_pins_m2, pc_b.vss_pins_m2),
        extend_m2_pins(b.sense_en_buffer, sense.vdd_pins_m2, sense.vss_pins_m2),
        extend_m2_pins(b.write_driver_en_buffer, write.vdd_pins_m2, write.vss_pins_m2),
        widen_m2_pins(wlen.vdd_pins_m2, wlen.vss_pins_m2, 2000.),
        widen_m2_pins(rpc.vdd_pins_m2, [], 5520.),
        widen_m2_pins([nmos.vdd], nmos.vss, 5520.),
    ]);
    let placed = straps(StrapJob {
        grid: track_grid(router_area(p, f), 360, false),
        blocks: [drawn_boxes(insts, "met1.drawing"), drawn_boxes(insts, "met2.drawing")],
        ops: std::concat(
            router_blocks(f, std::concat(pin_boxes, dec_pin_boxes), dec_pin_boxes, routes),
            power.blocks,
        ),
        targets: power.targets,
        strap_layers: [m1(), m2()],
        manufacturing_grid: 5,
    });
    for s in placed.straps {
        rect(
            if s.layer == 0 { "met1.drawing" } else { "met2.drawing" },
            x0=s.rect.x0,
            y0=s.rect.y0,
            x1=s.rect.x1,
            y1=s.rect.y1,
        );
    }
    for v in placed.vias {
        util::contact(Via::Via1, from_box(v.bot), from_box(v.top), later=true);
    }
    for c in placed.crossings {
        for o in c.offsets {
            let via = std::layout::inst(
                strap_via(from_box(c.via.bot), from_box(c.via.top)),
                x=o.0,
                y=o.1,
            );
        }
    }
    placed
}

// The via between two crossing straps, drawn once and placed at every crossing.
cell strap_via(bot: Rect, top: Rect) {
    util::contact(Via::Via1, bot, top, later=true);
}

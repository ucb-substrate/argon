// Native replica-column devices. This follows SRAM22's capacitance-emulation
// structure: three single-finger MOS devices share one vertical bitline.

use std::layout::{bbox, crect, inst, rect, shapes};
use lib::params::{ReplicaColumnParams, ReplicaRoutingParams};
use lib::columns::util;
use lib::columns::util::{Device, Via};

// A single-finger MOS of the replica column, its ports pinned.
cell device(d: Device) {
    let m = inst(util::mos([d], 150, 1), x=0., y=0.);
    pub let gate = m.gate[0];
    pub let sd = m.sd[0];
    for r in [gate, sd[0], sd[1]] {
        util::draw_box("li1.pin", r);
    }
}

// Extends li1 `src` up 170 nm past its top and back down to `dst`.
fn jog_up(src: Rect, dst: Rect) {
    let top = src.y1 + 170. + src.w;
    rect("li1.drawing", x0=src.x0, y0=src.y0, x1=src.x1, y1=top);
    rect("li1.drawing", x0=src.x0, y0=top - src.w, x1=dst.x1, y1=top);
    rect("li1.drawing", x0=dst.x0, y0=top - src.w, x1=dst.x1, y1=dst.y1);
}

// A met2 stripe `w` wide centered on `port`, 320 nm to 3.6 um tall.
fn stripe(port: Rect, w: Float) -> Rect {
    let span = util::centered(util::cy_i(port), min_float(max_float(port.h, 320.), 3600.));
    util::met2_port(0., span.0, w, span.1)
}

// One unit of the replica column's load: a gate capacitor, a drain-loaded
// NMOS, and a drain-loaded PMOS on the column's bitline, each present when
// `include`d, with their supply stripes.
cell column_mos(
    gate_width: Int,
    drain_n_width: Int,
    drain_p_width: Int,
    include_gate: Bool,
    include_drain_n: Bool,
    include_drain_p: Bool,
) {
    let drain_n_y = (gate_width + drain_n_width + 470) as Float;
    let drain_p_y = drain_n_y + (drain_p_width + 930) as Float;
    // Each device turned to run up the column; an omitted one is a
    // construction instance, its ports still placing the others.
    let gate = inst(device(util::nmos(gate_width)), y=0., angle=90, construction=!include_gate);
    let drain_n = inst(
        device(util::nmos(drain_n_width)),
        y=drain_n_y,
        angle=270,
        construction=!include_drain_n,
    );
    let drain_p = inst(
        device(util::pmos(drain_p_width)),
        y=drain_p_y,
        angle=270,
        construction=!include_drain_p,
    );
    for m in [gate, drain_n, drain_p] {
        eq(bbox(m).x0 + bbox(m).x1, 1200.);
    }
    pub let bl = util::met1_port(900., -540., 1040., drain_p_y + 540.);
    for k in std::range(3) {
        let m = [gate, drain_n, drain_p][k];
        if [include_gate, include_drain_n, include_drain_p][k] {
            if k == 0 {
                util::draw_box("li1.drawing", std::layout::union(m.sd[0], m.sd[1]));
            } else {
                jog_up(m.sd[0], m.gate);
            }
            let port = if k == 0 { m.gate } else { m.sd[1] };
            let route = rect(
                "li1.drawing",
                x0=min_float(port.x0, bl.x0),
                y0=port.y0,
                x1=max_float(port.x1, bl.x1),
                y1=port.y1,
            );
            util::contact(Via::Mcon, route, bl, longer=true, later=true);
        }
    }
    pub let nsdm = crect(
        x0=0.,
        y0=shapes(gate, "nsdm.drawing")[0].y0,
        x1=1200.,
        y1=shapes(drain_n, "nsdm.drawing")[0].y1,
    );
    pub let psdm = crect(
        x0=0.,
        y0=shapes(drain_p, "psdm.drawing")[0].y0,
        x1=1200.,
        y1=shapes(drain_p, "psdm.drawing")[0].y1,
    );
    pub let nwell = rect(
        "nwell.drawing",
        x0=0.,
        y0=shapes(drain_p, "nwell.drawing")[0].y0,
        x1=1200.,
        y1=shapes(drain_p, "nwell.drawing")[0].y1,
    );
    if include_gate || include_drain_n {
        util::draw_box("nsdm.drawing", nsdm);
    }
    if include_drain_p {
        util::draw_box("psdm.drawing", psdm);
    }
    pub let stripes = [for k in std::range(3) {
        let m = [gate, drain_n, drain_p][k];
        let port = if k == 0 { m.sd[1] } else { m.sd[0] };
        let s = stripe(port, 1200.);
        if [include_gate, include_drain_n, include_drain_p][k] {
            util::contact(Via::Mcon, port, s, longer=true, later=true);
            util::contact(Via::Via1, port, s, longer=true, later=true);
        }
        s
    }];
}

// A 1.3 um tap between replica units: a p-tap and an n-tap under the units'
// supply stripes, which it carries across.
cell column_mos_tap(gate_width: Int, drain_n_width: Int, drain_p_width: Int) {
    let u = inst(
        column_mos(gate_width, drain_n_width, drain_p_width, true, true, true),
        x=0.,
        y=0.,
        construction=true,
    );
    let n = rect("psdm.drawing", x0=0., y0=u.nsdm.y0, x1=1300., y1=u.nsdm.y1);
    let p = rect("nsdm.drawing", x0=0., y0=u.psdm.y0, x1=1300., y1=u.psdm.y1);
    rect("nwell.drawing", x0=0., y0=u.nwell.y0, x1=1300., y1=u.nwell.y1);
    pub let stripes = [for s in u.stripes { util::met2_port(0., s.y0, 1300., s.y1) }];
    for k in std::range(3) {
        let region = if k == 2 { p } else { n };
        let area = util::grow(region, -300., -300.);
        let tap = util::contact(Via::Tap, area, area, later=true);
        util::contact(Via::Mcon, tap.top, stripes[k], later=true);
        util::contact(Via::Via1, tap.top, stripes[k], later=true);
    }
    rect("layout_boundary.boundary", x0=0., y0=u.bl.y0, x1=1300., y1=u.bl.y1);
}

// The replica column's loads: `units` units with a tap before every eight,
// centered on y = 0, each unit's devices present while the column still
// needs their load.
cell replica_column_mos(p: ReplicaColumnParams) {
    let tap = column_mos_tap(p.gate_width, p.drain_n_width, p.drain_p_width);
    let y0 = -(bbox(tap).y0 + bbox(tap).y1) / 2.;
    let sl = util::slots(0., p.units, 1200., 1300., 8);
    let taps = [for x in sl.taps { inst(tap, x=x, y=y0) }];
    let units = [for u in std::range(p.units) {
        inst(
            column_mos(
                p.gate_width,
                p.drain_n_width,
                p.drain_p_width,
                u * p.gate_width < p.gate_target,
                u * p.drain_n_width < p.drain_n_target,
                u * p.drain_p_width < p.drain_p_target,
            ),
            x=sl.gates[u],
            y=y0,
        )
    }];
    let w = std::last(sl.taps) + 1300.;
    pub let bl = [for u in units { u.bl }];
    pub let vdd = crect(x0=0., y0=taps[0].stripes[2].y0, x1=w, y1=taps[0].stripes[2].y1);
    pub let vss = [for k in std::range(2) {
        crect(x0=0., y0=taps[0].stripes[k].y0, x1=w, y1=taps[0].stripes[k].y1)
    }];
}

// Metal-only load used to make the replica bitline see the same first-order
// interconnect capacitance as a main bitline. The sparse 680 nm track pitch is
// intentional: it is the same routing pitch used by SRAM22's column tracks.
cell replica_metal_routing(p: ReplicaRoutingParams) {
    let m0 = rect("li1.drawing", x0=0., y0=0., x1=p.m0_width as Float, y1=p.m0_height as Float);
    pub let bl = [for track in std::range(p.tracks) {
        let width = if track == p.tracks - 1 { 320 + p.m1_width % 320 } else { 320 };
        let m1 = util::met1_port(
            680. * track as Float,
            0.,
            680. * track as Float + width as Float,
            p.m1_height as Float,
        );
        if m0.x1 > m1.x0 && m1.x1 > m0.x0 {
            util::contact(Via::Mcon, m0, m1, longer=true, later=true);
        }
        m1
    }];
}

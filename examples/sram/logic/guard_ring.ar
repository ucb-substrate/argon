// Native Sky130 double guard ring used by the assembled SRAM.

use std::layout::{crect, rect};
use lib::columns::util;
use lib::columns::util::Via;

// A supply ring: its outer edge, its left, right, bottom, and top sides,
// and those sides between the corners.
struct Ring {
    outer: Rect,
    sides: [Rect],
    mids: [Rect],
}

// A supply ring with `w`-wide sides around `inner`: tap under li1 on every
// side in `implant`, met1 on the left and right sides and met2 on the bottom
// and top, joined at the corners.
fn ring(inner: Rect, w: Float, implant: String) -> Ring {
    let outer = util::grow(inner, w, w);
    let sides = [
        crect(x0=outer.x0, y0=outer.y0, x1=inner.x0, y1=outer.y1),
        crect(x0=inner.x1, y0=outer.y0, x1=outer.x1, y1=outer.y1),
        crect(x0=outer.x0, y0=outer.y0, x1=outer.x1, y1=inner.y0),
        crect(x0=outer.x0, y0=inner.y1, x1=outer.x1, y1=outer.y1),
    ];
    let mids = [for k in std::range(4) {
        let s = sides[k];
        let vertical = k < 2;
        if vertical {
            util::met1_port(s.x0, s.y0, s.x1, s.y1);
        } else {
            util::met2_port(s.x0, s.y0, s.x1, s.y1);
        }
        util::draw_box(implant, s);
        util::draw_box("li1.drawing", util::grow(s, -345., -345.));
        util::draw_box("tap.drawing", util::grow(s, -425., -425.));
        // Contacts along the side between the corners.
        let mid = if vertical {
            crect(x0=s.x0, y0=inner.y0, x1=s.x1, y1=inner.y1)
        } else {
            crect(x0=inner.x0, y0=s.y0, x1=inner.x1, y1=s.y1)
        };
        let area = util::grow(mid, -340., -340.);
        let tap = util::contact(Via::Tap, area, area, later=true);
        if vertical {
            util::contact(Via::Mcon, area, area, later=true);
        } else {
            util::draw_box("li1.pin", tap.top);
        }
        mid
    }];
    for edge in [sides[2], sides[3]] {
        for side in [sides[0], sides[1]] {
            util::contact(Via::Via1, side, edge, later=true);
        }
    }
    Ring { outer, sides, mids }
}

// A VSS ring around the hole (x0, y0)-(x1, y1) and a VDD ring 2.72 um outside
// it, in deep nwell that extends 1.08 um past the VDD ring's hole, with a
// 1.52 um nwell frame around that hole.
cell guard_ring(x0: Float, y0: Float, x1: Float, y1: Float) {
    let vss = crect(x0=x0, y0=y0, x1=x1, y1=y1);
    let vdd = util::grow(vss, 2720., 2720.);
    pub let vss_ring = ring(vss, 1360., "psdm.drawing");
    pub let vdd_ring = ring(vdd, 1360., "nsdm.drawing");
    util::draw_box("dnwell.drawing", util::grow(vdd, 1080., 1080.));
    let outer = util::grow(vdd, 1520., 1520.);
    rect("nwell.drawing", x0=outer.x0, y0=outer.y0, x1=outer.x1, y1=vdd.y0);
    rect("nwell.drawing", x0=outer.x0, y0=vdd.y1, x1=outer.x1, y1=outer.y1);
    rect("nwell.drawing", x0=outer.x0, y0=vdd.y0, x1=vdd.x0, y1=vdd.y1);
    rect("nwell.drawing", x0=vdd.x1, y0=vdd.y0, x1=outer.x1, y1=vdd.y1);
}

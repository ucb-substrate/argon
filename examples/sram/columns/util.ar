use std::layout::{crect, inst, rect};

// The contacts between adjacent layers: li1 to met1, met1 to met2, and tap
// or poly to li1.
enum Via { Mcon, Via1, Tap, Poly }

// A contact's cut and the layers it joins, its cut size and spacing, and each
// layer's enclosure of the cuts as (short side, long side).
struct ViaRule {
    cut: String,
    bot: String,
    top: String,
    size: Float,
    space: Float,
    bot_enc: (Float, Float),
    top_enc: (Float, Float),
}

fn via_rule(v: Via) -> ViaRule {
    match v {
        Via::Mcon => ViaRule {
            cut: "mcon.drawing",
            bot: "li1.drawing",
            top: "met1.drawing",
            size: 170.,
            space: 190.,
            bot_enc: (0., 0.),
            top_enc: (30., 60.),
        },
        Via::Via1 => ViaRule {
            cut: "via.drawing",
            bot: "met1.drawing",
            top: "met2.drawing",
            size: 150.,
            space: 170.,
            bot_enc: (55., 85.),
            top_enc: (55., 85.),
        },
        Via::Tap => ViaRule {
            cut: "licon1.drawing",
            bot: "tap.drawing",
            top: "li1.drawing",
            size: 170.,
            space: 170.,
            bot_enc: (0., 120.),
            top_enc: (0., 80.),
        },
        Via::Poly => ViaRule {
            cut: "licon1.drawing",
            bot: "poly.drawing",
            top: "li1.drawing",
            size: 170.,
            space: 170.,
            bot_enc: (50., 80.),
            top_enc: (0., 80.),
        },
    }
}

// A contact: `nx` by `ny` cuts filling `cuts`, and its two layers' metal.
struct Contact {
    via: Via,
    nx: Int,
    ny: Int,
    cuts: Rect,
    bot: Rect,
    top: Rect,
    bbox: Rect,
}

// The contact with the most `v` cuts that fit where `bot` and `top` overlap,
// or in `bot` if they don't, centered there and moved right by `dx`.
// `bot_dir`, `top_dir`, `longer`, and `later` choose its enclosures as in
// `max_via_array`. It is drawn, cut to x in [0, clip] when `clip` is positive,
// unless `draw` is false.
fn contact(
    v: Via,
    bot: Rect,
    top: Rect,
    bot_dir: Int = 0,
    top_dir: Int = 0,
    longer: Bool = false,
    later: Bool = false,
    draw: Bool = true,
    clip: Float = 0.,
    dx: Float = 0.,
) -> Contact {
    let r = via_rule(v);
    let n = max_via_array(
        r.size, r.space, r.bot_enc, r.top_enc, bot, top, bot_dir, top_dir, longer, later,
    );
    let w = (r.size + r.space) * n.0 as Float - r.space;
    let h = (r.size + r.space) * n.1 as Float - r.space;
    // The center of the overlap, rounded toward zero.
    let x0 = max_float(bot.x0, top.x0);
    let y0 = max_float(bot.y0, top.y0);
    let x1 = min_float(bot.x1, top.x1);
    let y1 = min_float(bot.y1, top.y1);
    let hit = x1 >= x0 && y1 >= y0;
    let cx = ((if hit { x0 + x1 } else { bot.x0 + bot.x1 }) / 2.) as Int as Float;
    let cy = ((if hit { y0 + y1 } else { bot.y0 + bot.y1 }) / 2.) as Int as Float;
    let cuts = crect(x0=snap5(cx - w / 2.) + dx, y0=snap5(cy - h / 2.), w=w, h=h);
    let ex = max_float(n.2, n.4);
    let ey = max_float(n.3, n.5);
    let c = Contact {
        via: v,
        nx: n.0,
        ny: n.1,
        cuts,
        bot: grow(cuts, n.2, n.3),
        top: grow(cuts, n.4, n.5),
        bbox: grow(cuts, ex, ey),
    };
    if draw {
        draw_contact(c, clip=clip);
    }
    c
}

// A tap contact: the most licon cuts at a 340 nm pitch that fit in `area`
// less `enc` on each side, centered in it, with tap and li1 grown from the
// cuts by `tap` and `li`.
fn tap_contact(
    area: Rect,
    enc: (Float, Float),
    tap: (Float, Float),
    li: (Float, Float),
) -> Contact {
    let nx = max_int(((area.w + 170. - 2. * enc.0) / 340. + 0.000001) as Int, 1);
    let ny = max_int(((area.h + 170. - 2. * enc.1) / 340. + 0.000001) as Int, 1);
    let w = 340. * nx as Float - 170.;
    let h = 340. * ny as Float - 170.;
    let cuts = crect(x0=snap5(cx_i(area) - w / 2.), y0=snap5(cy_i(area) - h / 2.), w=w, h=h);
    let c = Contact {
        via: Via::Tap,
        nx,
        ny,
        cuts,
        bot: grow(cuts, tap.0, tap.1),
        top: grow(cuts, li.0, li.1),
        bbox: grow(cuts, max_float(tap.0, li.0), max_float(tap.1, li.1)),
    };
    draw_contact(c);
    c
}

fn cut_count(len: Float, enc: Float) -> Int {
    max_int(((len + 170. - 2. * enc) / 340. + 0.000001) as Int, 1)
}

// A tap contact filling `area`, enclosed along whichever axis fits more cuts.
fn tap(area: Rect) -> Contact {
    if cut_count(area.w, 0.) * cut_count(area.h, 120.) > cut_count(area.w, 120.) * cut_count(area.h, 0.) {
        tap_contact(area, (0., 120.), (0., 120.), (0., 80.))
    } else {
        tap_contact(area, (120., 0.), (120., 0.), (80., 0.))
    }
}

// Draws contact `c`, cut to x in [0, clip] when `clip` is positive.
fn draw_contact(c: Contact, clip: Float = 0.) {
    let r = via_rule(c.via);
    let pitch = r.size + r.space;
    if clip > 0. {
        for i in std::range(c.nx) {
            for j in std::range(c.ny) {
                trim(
                    r.cut,
                    crect(
                        x0=c.cuts.x0 + i as Float * pitch,
                        y0=c.cuts.y0 + j as Float * pitch,
                        w=r.size,
                        h=r.size,
                    ),
                    clip,
                );
            }
        }
    } else {
        for i in std::range(c.nx) {
            for j in std::range(c.ny) {
                rect(
                    r.cut,
                    x0=c.cuts.x0 + i as Float * pitch,
                    y0=c.cuts.y0 + j as Float * pitch,
                    w=r.size,
                    h=r.size,
                );
            }
        }
    }
    trim(r.bot, c.bot, clip);
    trim(r.top, c.top, clip);
}

// Contact `c` moved right by `dx`.
fn moved(c: Contact, dx: Float) -> Contact {
    Contact {
        via: c.via,
        nx: c.nx,
        ny: c.ny,
        cuts: shift(c.cuts, dx),
        bot: shift(c.bot, dx),
        top: shift(c.top, dx),
        bbox: shift(c.bbox, dx),
    }
}

// Draws `r` on `layer`, cut to x in [0, clip] when `clip` is positive.
fn trim(layer: String, r: Rect, clip: Float) -> Rect {
    if clip > 0. {
        let x0 = max_float(r.x0, 0.);
        let x1 = min_float(r.x1, clip);
        if x1 > x0 {
            rect(layer, x0=x0, y0=r.y0, x1=x1, y1=r.y1)
        } else {
            crect(x0=x0, y0=r.y0, x1=x0, y1=r.y1)
        }
    } else {
        rect(layer, x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1)
    }
}

// The overlap of `a` and `b`, or `a` if they don't overlap.
fn overlap(a: Rect, b: Rect) -> Rect {
    let x0 = max_float(a.x0, b.x0);
    let y0 = max_float(a.y0, b.y0);
    let x1 = min_float(a.x1, b.x1);
    let y1 = min_float(a.y1, b.y1);
    if x1 >= x0 && y1 >= y0 { crect(x0=x0, y0=y0, x1=x1, y1=y1) } else { a }
}

// `r` grown by `dx` on the left and right and `dy` at the bottom and top.
fn grow(r: Rect, dx: Float, dy: Float) -> Rect {
    crect(x0=r.x0 - dx, y0=r.y0 - dy, x1=r.x1 + dx, y1=r.y1 + dy)
}

fn shift(r: Rect, dx: Float, dy: Float = 0.) -> Rect {
    crect(x0=r.x0 + dx, y0=r.y0 + dy, x1=r.x1 + dx, y1=r.y1 + dy)
}

// The center of `r`, rounded toward zero as integer coordinates are.
fn cx_i(r: Rect) -> Float { ((r.x0 + r.x1) / 2.) as Int as Float }

fn cy_i(r: Rect) -> Float { ((r.y0 + r.y1) / 2.) as Int as Float }

// The span `w` long centered on `c`, starting on the grid.
fn centered(c: Float, w: Float) -> (Float, Float) {
    let x0 = snap5(c - w / 2.);
    (x0, x0 + w)
}

// The smallest rectangle containing all of `rs`.
fn hull(rs: [Rect]) -> Rect { hull_from(tail(rs), head(rs)) }

fn hull_from(rs: [Rect], acc: Rect) -> Rect {
    if rs == [] { acc } else { hull_from(tail(rs), std::layout::union(acc, head(rs))) }
}

// Slot and tap x positions of a row of `n` slots `width` wide from x =
// `left`, with a tap `tap` wide at the left edge and after every `period`
// slots.
struct Slots {
    gates: [Float],
    taps: [Float],
}

fn slots(left: Float, n: Int, width: Float, tap: Float, period: Int) -> Slots {
    Slots {
        gates: [for i in std::range(n) {
            left + tap + i as Float * width + (i / period) as Float * tap
        }],
        taps: [for g in std::range(ceil_div(n, period) + 1) {
            if g == 0 {
                left
            } else {
                left + tap + min_int(g * period, n) as Float * width + (g - 1) as Float * tap
            }
        }],
    }
}

fn ceil_div(a: Int, b: Int) -> Int { (a + b - 1) / b }

// The x spans of a 1.2 um column's met1 bitline tracks: four toward the
// bitcells, with half tracks at the edges, and three toward the sense amp.
fn in_tracks() -> [(Float, Float)] { [(0., 70.), (345., 485.), (715., 855.), (1130., 1200.)] }

fn out_tracks() -> [(Float, Float)] { [(160., 300.), (530., 670.), (900., 1040.)] }

// Jogs 140 nm met1 tracks from the `src` x spans to the `dst` ones, starting
// at `y`. Returns where the jog ends, 420 nm higher.
fn jog(y: Float, src: [(Float, Float)], dst: [(Float, Float)]) -> Float {
    for i in std::range(std::len(src)) {
        let s = src[i];
        let d = dst[i];
        rect("met1.drawing", x0=s.0, y0=y, x1=s.1, h=280.);
        rect("met1.drawing", x0=d.0, y0=y + 140., x1=d.1, h=280.);
        rect("met1.drawing", x0=min_float(s.0, d.1), y0=y + 140., x1=max_float(s.0, d.1), h=140.);
    }
    y + 420.
}

// A device of a `mos` row: its width and whether it is a PMOS.
struct Device {
    w: Int,
    pmos: Bool,
}

fn nmos(w: Int) -> Device { Device { w, pmos: false } }

fn pmos(w: Int) -> Device { Device { w, pmos: true } }

// How a `mos` row contacts its gate fingers: once per finger on the left or
// on both sides, or once on the left for all of them.
enum Gates { Left, Both, Merged }

// A row of devices along x under `nf` shared gate fingers of length `l`, as
// sky130's MOS generator draws it: diffusions 270 nm apart (520 nm between an
// NMOS and a PMOS) in their implants and wells, poly fingers along x with li1
// gate contacts, and a row of li1 source/drain contacts below, between, and
// above the fingers. `sd[j][i]` is row `i` of device `j`; `skip` lists the
// (device, row) contacts left undrawn.
cell mos(devs: [Device], l: Int, nf: Int, gates: Gates = Gates::Left, skip: [(Int, Int)] = []) {
    let n = std::len(devs);
    let pitch = l as Float + 280.;
    let h = nf as Float * pitch + 250.;
    let xs = [for j in std::range(n) {
        std::sum([for k in std::range(j) {
            devs[k].w + if devs[k].pmos == devs[k + 1].pmos { 270 } else { 520 }
        }]) as Float
    }];
    pub let diffs = [for j in std::range(n) {
        rect("diff.drawing", x0=xs[j], y0=0., w=devs[j].w as Float, h=h)
    }];
    for j in std::range(n) {
        let x1 = xs[j] + devs[j].w as Float;
        let joined = j > 0 && devs[j - 1].pmos == devs[j].pmos;
        let implant_x0 = if joined { xs[j - 1] + devs[j - 1].w as Float } else { xs[j] };
        rect(
            if devs[j].pmos { "psdm.drawing" } else { "nsdm.drawing" },
            x0=implant_x0 - 125.,
            y0=-125.,
            x1=x1 + 125.,
            y1=h + 125.,
        );
        if devs[j].pmos {
            rect("nwell.drawing", x0=xs[j] - 180., y0=-180., x1=x1 + 180., y1=h + 180.);
        }
    }
    let both = match gates { Gates::Both => true, _ => false, };
    let poly_x1 = xs[n - 1] + devs[n - 1].w as Float + if both { 190. } else { 130. };
    for k in std::range(nf) {
        rect("poly.drawing", x0=-190., y0=265. + k as Float * pitch, x1=poly_x1, h=l as Float);
    }
    let fingers = nf as Float * pitch - 280.;
    pub let gate = match gates {
        Gates::Merged => {
            let poly = rect("poly.drawing", x0=-520., y0=265., x1=-190., h=fingers);
            let c = contact(Via::Poly, poly, poly, longer=true, later=true);
            draw_box("npc.drawing", grow(c.cuts, 100., 100.));
            [c.top]
        },
        _ => gate_contacts(-520., 265. + fingers / 2., nf),
    };
    pub let gate_x = if both { gate_contacts(poly_x1, 265. + fingers / 2., nf) } else { gate };
    pub let sd = [for j in std::range(n) {
        [for i in std::range(nf + 1) {
            sd_contact(
                xs[j],
                devs[j].w as Float,
                i as Float * pitch,
                !std::any([for s in skip { s.0 == j && s.1 == i }]),
            )
        }]
    }];
}

// A logic gate: a NAND of `inputs` inputs, its NMOS fingers in series and its
// PMOS fingers in parallel, or for one input a folded inverter of two fingers
// each half as wide. `gates` are its li1 inputs; `vss` and `vdd` its sources.
cell gate(inputs: Int, nw: Int, pw: Int, pins: Bool = false) {
    let inv = inputs == 1;
    let nf = if inv { 2 } else { inputs };
    let n = if inv { half(nw) } else { nw };
    let p = if inv { half(pw) } else { pw };
    let m = inst(
        mos(
            [nmos(n), pmos(p)],
            150,
            nf,
            gates=if inv { Gates::Merged } else { Gates::Left },
            skip=[for i in std::range(inputs - 1) { (0, i + 1) }],
        ),
        x=0.,
        y=0.,
    );
    let sd = m.sd;
    let row = if inv { 1 } else { nf };
    pub let out = draw_box("li1.drawing", std::layout::union(sd[0][row], sd[1][row]));
    if !inv {
        // The other PMOS drain joins the output through a strap between the devices.
        let drain = sd[1][nf - 2];
        let x = snap5((((sd[0][row].x1 + drain.x0) as Int) / 2) as Float - out.h / 2.);
        rect("li1.drawing", x0=x, y0=drain.y0, x1=x + out.h, y1=out.y1);
        rect("li1.drawing", x0=x, y0=drain.y0, x1=drain.x1, y1=drain.y1);
    }
    pub let gates = m.gate;
    pub let a = m.gate[0];
    pub let vss = if inv { [sd[0][0], sd[0][2]] } else { [sd[0][0]] };
    pub let vdd = [for i in std::range(nf + 1) if (i % 2 == 0) == (inv || nf % 2 == 1) {
        sd[1][i]
    }];
    if pins {
        for r in std::concat(std::concat([a, out], vss), vdd) {
            draw_box("li1.pin", r);
        }
    }
}

// Half of `w`, rounded to 10 nm.
fn half(w: Int) -> Int {
    ((w as Float * 0.5 / 10. + 0.5) as Int) * 10
}

// A column of `nf` poly-to-li1 gate contacts at `x`, 480 nm apart and
// centered on `y`, and the npc around them. Returns their li1.
fn gate_contacts(x: Float, y: Float, nf: Int) -> [Rect] {
    let y0 = snap5(y - (480. * nf as Float - 210.) / 2.);
    rect("npc.drawing", x0=x - 20., y0=y0 - 50., x1=x + 350., y1=y0 + 480. * nf as Float - 160.);
    [for i in std::range(nf) {
        let y = y0 + 480. * i as Float;
        rect("poly.drawing", x0=x, y0=y, x1=x + 330., h=270.);
        rect("licon1.drawing", x0=x + 80., y0=y + 50., x1=x + 250., h=170.);
        rect("li1.drawing", x0=x, y0=y + 50., x1=x + 330., h=170.)
    }]
}

// The li1 of a row of source/drain contacts across a `w`-wide diffusion at
// (x, y), drawn with its cuts unless `draw` is false.
fn sd_contact(x: Float, w: Float, y: Float, draw: Bool) -> Rect {
    let n = max_int(((w + 10.) / 340.) as Int, 1);
    let aw = 340. * n as Float - 170.;
    let x0 = snap5(x + w / 2. - aw / 2.);
    let li = crect(x0=x0 - 80., y0=y + 40., x1=x0 + aw + 80., y1=y + 210.);
    if draw {
        for i in std::range(n) {
            rect("licon1.drawing", x0=x0 + i as Float * 340., y0=y + 40., w=170., h=170.);
        }
        rect("diff.drawing", x0=x0 - 60., y0=y, x1=x0 + aw + 60., y1=y + 250.);
        draw_box("li1.drawing", li);
    }
    li
}

// The width of a column of `mux` 1.2 um bitline pairs.
fn column_w(mux: Int) -> Float {
    mux as Float * 1200.
}

// Draws rectangle `r` on `layer`.
fn draw_box(layer: String, r: Rect) -> Rect {
    rect(layer, x0=r.x0, y0=r.y0, x1=r.x1, y1=r.y1)
}

// `v` rounded to the 5 nm grid, halves away from zero.
fn snap5(v: Float) -> Float {
    if v < 0. {
        (((v / 5.) - 0.5) as Int) as Float * 5.
    } else {
        (((v / 5.) + 0.5) as Int) as Float * 5.
    }
}

// Draws a met1 rectangle and its pin. Returns the drawn rectangle.
fn met1_port(x0: Float, y0: Float, x1: Float, y1: Float) -> Rect {
    let draw = rect("met1.drawing", x0=x0, y0=y0, x1=x1, y1=y1);
    rect("met1.pin", x0=x0, y0=y0, x1=x1, y1=y1);
    draw
}

fn met2_port(x0: Float, y0: Float, x1: Float, y1: Float) -> Rect {
    let draw = rect("met2.drawing", x0=x0, y0=y0, x1=x1, y1=y1);
    rect("met2.pin", x0=x0, y0=y0, x1=x1, y1=y1);
    draw
}

fn li1_port(x0: Float, y0: Float, x1: Float, y1: Float) -> Rect {
    let draw = rect("li1.drawing", x0=x0, y0=y0, x1=x1, y1=y1);
    rect("li1.pin", x0=x0, y0=y0, x1=x1, y1=y1);
    draw
}

// The width of a row of columns, with a 1.3 um tap between columns and at
// each end.
fn row_w(cols: Int, mux: Int) -> Float {
    let words = cols / mux;
    1300. + words as Float * column_w(mux) + (words - 1) as Float * 1300. + 1300.
}

fn wmask_unit_w(cols: Int, mux: Int, gran: Int) -> Float {
    gran as Float * (column_w(mux) + 1300.)
}

// The left edge of column `group`, and of bitline pair `idx`.
fn word_x(group: Int, mux: Int) -> Float {
    1300. + group as Float * (column_w(mux) + 1300.)
}

fn bit_x(idx: Int, mux: Int) -> Float {
    let group = idx / mux;
    let bit = idx % mux;
    word_x(group, mux) + bit as Float * 1200.
}

// Whether two rects have the same extent along one axis and overlap or touch
// along the other.
fn rects_coalesce(a: Rect, b: Rect) -> Bool {
    let same_x = a.x0 <= b.x0 && a.x0 >= b.x0 && a.x1 <= b.x1 && a.x1 >= b.x1;
    let same_y = a.y0 <= b.y0 && a.y0 >= b.y0 && a.y1 <= b.y1 && a.y1 >= b.y1;
    (same_x && a.y0 <= b.y1 && b.y0 <= a.y1) || (same_y && a.x0 <= b.x1 && b.x0 <= a.x1)
}

// Adds r to rects no two of which coalesce, merging it with the first one it
// coalesces with until it coalesces with none.
fn coalesce_into(acc: [Rect], r: Rect) -> [Rect] {
    let hits = [for i in std::range(std::len(acc)) if rects_coalesce(acc[i], r) { i }];
    if hits == [] {
        std::concat(acc, [r])
    } else {
        let k = head(hits);
        coalesce_into(
            [for i in std::range(std::len(acc)) if i != k { acc[i] }],
            std::layout::union(acc[k], r),
        )
    }
}

fn coalesce_from(l: [Rect], i: Int, acc: [Rect]) -> [Rect] {
    if i == std::len(l) { acc } else { coalesce_from(l, i + 1, coalesce_into(acc, l[i])) }
}

// Merges rects that coalesce until no two do.
fn coalesce_rects(l: [Rect]) -> [Rect] { coalesce_from(l, 0, []) }

use std::layout::{bbox, crect, inst, rect, shapes, union};
use lib::params::{
    AndStageSizing, BufferSizing, DecoderNodeSizing, DecoderParams, PrimitiveGateParams,
    RowDecoderSizing,
};
use lib::columns::util;
use lib::columns::util::Via;

// Decoders and buffers are rows of gates turned to run up slots 1.58 um wide
// (1.9 um or 3.16 um in some decoders), with tap columns between groups of
// slots. Each gate's supply straps run across its slot.

// Supply straps across implant `r`, as y spans: one centered strap half the
// implant's height (at least 320 nm), or 1.92 um straps 3.84 um apart across
// an implant taller than 3.84 um.
fn straps(r: Rect) -> [(Float, Float)] {
    let c = (((r.y0 + r.y1) as Int) / 2) as Float;
    if r.h > 3840. {
        let n = (r.h / 3840.) as Int;
        let first = util::centered(
            c,
            ((1920. * (2 * n - 1) as Float / 5.) as Int * 5) as Float,
        ).0 + 960.;
        [for i in std::range(n) { util::centered(first + 3840. * i as Float, 1920.) }]
    } else {
        [util::centered(c, max_float(((r.h / 20.) as Int * 10) as Float, 320.))]
    }
}

// Where `a` crosses `b`, or `a`'s lower-left corner if they don't cross.
fn crossing(a: Rect, b: Rect) -> Rect {
    let x0 = max_float(a.x0, b.x0);
    let y0 = max_float(a.y0, b.y0);
    let x1 = min_float(a.x1, b.x1);
    let y1 = min_float(a.y1, b.y1);
    if x1 >= x0 && y1 >= y0 {
        crect(x0=x0, y0=y0, x1=x1, y1=y1)
    } else {
        crect(x0=a.x0, y0=a.y0, x1=a.x0, y1=a.y0)
    }
}

// Draws supply straps across implant `r` in a `w`-wide slot, on met2 when
// `m2`, each tied to all of `ports` unless `tie` is false.
fn draw_straps(r: Rect, ports: [Rect], w: Float, tie: Bool, m2: Bool) -> [Rect] {
    [for s in straps(r) {
        let strap = if m2 {
            util::met2_port(0., s.0, w, s.1)
        } else {
            util::met1_port(0., s.0, w, s.1)
        };
        if tie {
            for port in ports {
                let c = crossing(strap, port);
                if m2 {
                    util::contact(Via::Mcon, c, c, longer=true, later=true);
                    util::contact(Via::Via1, c, c, longer=true, later=true);
                } else {
                    util::contact(Via::Mcon, c, c, top_dir=1, longer=true);
                }
            }
        }
        strap
    }]
}

fn across(layer: String, r: Rect, w: Float) -> Rect {
    rect(layer, x0=0., y0=r.y0, x1=w, y1=r.y1)
}

// `c` turned to run up a `w`-wide slot and centered in it, construction-only
// when `construction`.
fn in_slot(c: Any, w: Float, construction: Bool) -> Any {
    let g = inst(c, y=0., angle=90, construction=construction);
    let b = bbox(g);
    eq(b.x0 + b.x1, w);
    g
}

// A decoder gate's devices in a `w`-wide slot. Gates and their taps share
// this call, and so one evaluation of the devices.
fn gate_devices(inputs: Int, nw: Int, pw: Int, w: Float, construction: Bool) -> Any {
    in_slot(util::gate(inputs, nw, pw), w, construction)
}

// A gate (`util::gate`) centered in a `width` slot, with its well and
// implants across the slot and supply straps tied to its sources, on met2
// when `m2`. A filler has the well, implants, and straps but no devices.
cell dec_gate(
    inputs: Int,
    nw: Int,
    pw: Int,
    width: Int = 1580,
    filler: Bool = false,
    signal_pins: Bool = false,
    supply_pins: Bool = false,
    boundary: Bool = true,
    m2: Bool = false,
) {
    let w = width as Float;
    let g = gate_devices(inputs, nw, pw, w, filler);
    let b = bbox(g);
    pub let nwell = across("nwell.drawing", shapes(g, "nwell.drawing")[0], w);
    pub let nsdm = across("nsdm.drawing", shapes(g, "nsdm.drawing")[0], w);
    pub let psdm = across("psdm.drawing", shapes(g, "psdm.drawing")[0], w);
    pub let vss_straps = draw_straps(nsdm, g.vss, w, !filler, m2);
    pub let vdd_straps = draw_straps(psdm, g.vdd, w, !filler, m2);
    pub let gates = g.gates;
    pub let a = g.a;
    pub let out = g.out;
    pub let vss = g.vss;
    pub let vdd = g.vdd;
    if !filler && signal_pins {
        for r in cons(out, gates) {
            util::draw_box("li1.pin", r);
        }
    }
    if !filler && supply_pins {
        for r in std::concat(vss, vdd) {
            util::draw_box("li1.pin", r);
        }
    }
    pub let outline = if boundary {
        rect("layout_boundary.boundary", x0=0., y0=b.y0, x1=w, y1=b.y1)
    } else {
        crect(x0=0., y0=b.y0, x1=w, y1=b.y1)
    };
}

// A tap column `w` wide beside gates with well `nwell` and implants `nsdm`
// and `psdm`: an n-tap in the PMOS implant, a p-tap in the NMOS implant, and
// the gates' supply straps, on met2 when `m2`.
fn draw_taps(w: Float, nwell: Rect, nsdm: Rect, psdm: Rect, m2: Bool, later: Bool, top_dir: Int) {
    across("nwell.drawing", nwell, w);
    for side in [(nsdm, "psdm.drawing"), (psdm, "nsdm.drawing")] {
        let r = side.0;
        rect(side.1, x0=170., y0=r.y0 + 110., x1=w - 170., y1=r.y1 - 110.);
        let area = crect(x0=295., y0=r.y0 + 290., x1=w - 295., y1=r.y1 - 290.);
        util::contact(Via::Tap, area, area, longer=true, later=true);
        for s in straps(r) {
            if m2 { util::met2_port(0., s.0, w, s.1); } else { util::met1_port(0., s.0, w, s.1); }
            let c = crect(x0=295., y0=s.0, x1=w - 295., y1=s.1);
            util::contact(Via::Mcon, c, c, top_dir=top_dir, longer=true, later=later);
            if m2 {
                util::contact(Via::Via1, c, c, longer=true, later=true);
            }
        }
    }
}

// A tap `width` wide beside `dec_gate`s of the given kind and size.
cell dec_tap(
    inputs: Int,
    nw: Int,
    pw: Int,
    width: Int = 1000,
    boundary: Bool = true,
    m2: Bool = false,
    later: Bool = true,
    top_dir: Int = 0,
) {
    let g = gate_devices(inputs, nw, pw, 1580., true);
    let b = bbox(g);
    draw_taps(
        width as Float,
        shapes(g, "nwell.drawing")[0],
        shapes(g, "nsdm.drawing")[0],
        shapes(g, "psdm.drawing")[0],
        m2,
        later,
        top_dir,
    );
    pub let outline = if boundary {
        rect("layout_boundary.boundary", x0=0., y0=b.y0, x1=width as Float, y1=b.y1)
    } else {
        crect(x0=0., y0=b.y0, x1=width as Float, y1=b.y1)
    };
}

// A multi-finger inverter: a 700 nm NMOS and PMOS with as many fingers as
// their widths need, each turned on its side, the PMOS well 220 nm past the
// NMOS implant. `nsd` and `psd` are their source/drain contacts by row.
cell mf_inv(nw: Int, pw: Int, pins: Bool = false) {
    let n = inst(
        util::mos([util::nmos(700)], 150, max_int((nw + 350) / 700, 1), gates=util::Gates::Merged),
        x=0.,
        y=0.,
        angle=90,
    );
    let p = inst(
        util::mos([util::pmos(700)], 150, max_int((pw + 350) / 700, 1), gates=util::Gates::Merged),
        y=0.,
        angle=90,
    );
    eq(bbox(p).x0, bbox(n).x1 + 220.);
    pub let nsd = n.sd[0];
    pub let psd = p.sd[0];
    pub let a = util::draw_box("li1.drawing", union(n.gate[0], p.gate[0]));
    if pins {
        for r in cons(a, std::concat(nsd, psd)) {
            util::draw_box("li1.pin", r);
        }
    }
}

// The stacked contact rows of `sd` with odd (or even) index, as one
// rectangle.
fn rows(sd: [Rect], odd: Bool) -> Rect {
    let last = std::len(sd) - 1;
    union(sd[if odd { 1 } else { 0 }], sd[if (last % 2 == 1) == odd { last } else { last - 1 }])
}

// A multi-finger inverter centered in a `width` slot, with met1 rails for its
// input, output, and supplies, and met2 supply stripes across its implants.
cell mf_gate(nw: Int, pw: Int, width: Int = 1580, filler: Bool = false, pins: Bool = false) {
    let w = width as Float;
    let g = mf_devices(nw, pw, w, filler);
    pub let nsdm = shapes(g, "nsdm.drawing")[0];
    pub let psdm = shapes(g, "psdm.drawing")[0];
    pub let nwell = across("nwell.drawing", shapes(g, "nwell.drawing")[0], w);
    let nsd = g.nsd;
    let psd = g.psd;
    let a0 = g.a;
    let y_out = union(rows(nsd, true), rows(psd, true));
    let vss0 = rows(nsd, false);
    let vdd0 = rows(psd, false);
    pub let vss = crect(x0=vss0.x0, y0=vss0.y0, x1=vss0.x0 + 240., y1=vss0.y1);
    pub let vdd = crect(x0=vdd0.x0, y0=vdd0.y0, x1=vdd0.x0 + 240., y1=vdd0.y1);
    let span = util::hull([
        a0,
        crect(x0=y_out.x1 - 240., y0=y_out.y0, x1=y_out.x1, y1=y_out.y1),
        vss,
        vdd,
    ]);
    pub let a = crect(x0=a0.x0, y0=span.y0, x1=a0.x1, y1=span.y1);
    pub let out = crect(x0=y_out.x1 - 240., y0=span.y0, x1=y_out.x1, y1=span.y1);
    if !filler {
        for rail in [(vss, nsd, false), (vdd, psd, false), (out, nsd, true), (out, psd, true)] {
            util::draw_box("met1.drawing", rail.0);
            for i in std::range(std::len(rail.1)) if (i % 2 == 1) == rail.2 {
                util::contact(Via::Mcon, rail.1[i], rail.0, longer=true, later=true);
            }
        }
        util::draw_box("met1.drawing", a);
        util::contact(Via::Mcon, a0, a, longer=true, later=true);
        if pins {
            util::draw_box("met1.pin", a);
            util::draw_box("met1.pin", out);
        }
    }
    pub let vss_stripes = [for s in straps(nsdm) {
        tied(util::met2_port(0., s.0, w, s.1), vss, !filler)
    }];
    pub let vdd_stripes = [for s in straps(psdm) {
        tied(util::met2_port(0., s.0, w, s.1), vdd, !filler)
    }];
    pub let outline = rect(
        "layout_boundary.boundary",
        x0=0.,
        y0=min_float(nsdm.y0, nwell.y0) - 200.,
        x1=w,
        y1=max_float(nsdm.y1, nwell.y1) + 200.,
    );
}

// `stripe`, tied to `rail` below it when `tie`.
fn tied(stripe: Rect, rail: Rect, tie: Bool) -> Rect {
    if tie {
        util::contact(Via::Via1, rail, stripe, longer=true, later=true);
    }
    stripe
}

// A multi-finger inverter in a `w`-wide slot, shared by gates and taps.
fn mf_devices(nw: Int, pw: Int, w: Float, construction: Bool) -> Any {
    in_slot(mf_inv(nw, pw), w, construction)
}

// The height of an `mf_gate`: both devices' fingers at 430 nm plus their
// diffusion ends, implant, well, and 200 nm margins. Cheaper than building
// one just to measure it.
fn mf_gate_height(nw: Int, pw: Int) -> Float {
    (430 * (max_int((nw + 350) / 700, 1) + max_int((pw + 350) / 700, 1)) + 1730) as Float
}

// A tap `width` wide beside `mf_gate`s of the given size.
cell mf_tap(nw: Int, pw: Int, width: Int = 1000) {
    let g = mf_devices(nw, pw, 1580., true);
    let nsdm = shapes(g, "nsdm.drawing")[0];
    let nwell = shapes(g, "nwell.drawing")[0];
    draw_taps(width as Float, nwell, nsdm, shapes(g, "psdm.drawing")[0], true, true, 0);
    pub let outline = rect(
        "layout_boundary.boundary",
        x0=0.,
        y0=min_float(nsdm.y0, nwell.y0),
        x1=width as Float,
        y1=max_float(nsdm.y1, nwell.y1),
    );
}

// Jogs li1 from output `src` up 170 nm past its top and over to input `dst`,
// then up to `dst` when `to_dst`.
fn li_jog(src: Rect, dst: Rect, to_dst: Bool) {
    let top = src.y1 + src.w + 170.;
    rect("li1.drawing", x0=src.x0, y0=src.y0, x1=src.x1, y1=top);
    rect(
        "li1.drawing",
        x0=min_float(src.x0, dst.x0),
        y0=src.y1 + 170.,
        x1=max_float(src.x1, dst.x0),
        y1=top,
    );
    if to_dst {
        rect("li1.drawing", x0=dst.x0, y0=src.y1 + 170., x1=dst.x1, y1=dst.y1);
    }
}

// An AND2: a NAND2 with a folded inverter 300 nm above it, the NAND's output
// jogged to the inverter's input.
cell and2_gate(
    nand: PrimitiveGateParams,
    inv: PrimitiveGateParams,
    filler: Bool = false,
    pins: Bool = false,
    boundary: Bool = true,
) {
    let n = inst(dec_gate(2, nand.nwidth, nand.pwidth, filler=filler), x=0., y=0.);
    let i = inst(dec_gate(1, inv.nwidth, inv.pwidth, filler=filler), x=0.);
    eq(i.outline.y0, n.outline.y1 + 300.);
    if !filler {
        li_jog(n.out, i.a, true);
        if pins {
            for r in [n.gates[0], n.gates[1], n.out, i.out] {
                util::draw_box("li1.pin", r);
            }
        }
        for r in std::concat(std::concat(n.vss, n.vdd), std::concat(i.vss, i.vdd)) {
            util::draw_box("li1.pin", r);
        }
    }
    pub let outline = if boundary {
        rect("layout_boundary.boundary", x0=0., y0=n.outline.y0, x1=1580., y1=i.outline.y1)
    } else {
        crect(x0=0., y0=n.outline.y0, x1=1580., y1=i.outline.y1)
    };
    pub let a = n.gates[0];
    pub let b = n.gates[1];
    pub let out = i.out;
    pub let vdd_straps = std::concat(n.vdd_straps, i.vdd_straps);
    pub let vss_straps = std::concat(n.vss_straps, i.vss_straps);
}

// The taps beside an AND2.
cell and2_tap(nand: PrimitiveGateParams, inv: PrimitiveGateParams, width: Int) {
    let n = inst(dec_tap(2, nand.nwidth, nand.pwidth, width=width), x=0., y=0.);
    let i = inst(dec_tap(1, inv.nwidth, inv.pwidth, width=width), x=0.);
    eq(i.outline.y0, n.outline.y1 + 300.);
    rect("layout_boundary.boundary", x0=0., y0=n.outline.y0, x1=width as Float, y1=i.outline.y1);
}

// Rises 340 nm on li1 from a gate output to an li1-met1 contact. Returns its
// met1.
fn li_up(port: Rect) -> Rect {
    let li = rect("li1.drawing", x0=port.x0, y0=port.y0, x1=port.x1, y1=port.y1 + 340.);
    let area = crect(x0=li.x0, y0=li.y1 - 240., x1=li.x1, y1=li.y1);
    util::contact(Via::Mcon, area, area, top_dir=2, longer=true, later=true).top
}

// Joins a stage's output folds `outs` to the next stage's input folds `ins`
// on a 240 nm met1 bus 400 nm below the first input. An li1 output (`li`)
// rises from its first fold through `li_up`.
fn join(outs: [Rect], ins: [Rect], li: Bool) {
    let first = if li { li_up(outs[0]) } else { outs[0] };
    let bus = util::centered(ins[0].y0 - 400., 240.);
    let lasts = std::concat(
        if std::len(outs) > 1 { [std::last(outs)] } else { [] },
        if std::len(ins) > 1 { [std::last(ins)] } else { [] },
    );
    let span = util::hull(std::concat([first, ins[0]], lasts));
    rect("met1.drawing", x0=span.x0, y0=bus.0, x1=span.x1, y1=bus.1);
    for port in std::concat(if li { [first] } else { outs }, ins) {
        rect(
            "met1.drawing",
            x0=port.x0,
            y0=min_float(port.y0, bus.0),
            x1=port.x1,
            y1=max_float(port.y1, bus.1),
        );
    }
}

// Ties gate input `port` to the met1 `track` it crosses.
fn tie(port: Rect, track: Rect) {
    let c = crect(x0=port.x0, y0=track.y0, x1=port.x1, y1=track.y1);
    let via = util::contact(Via::Mcon, c, c, longer=true).bbox;
    rect(
        "li1.drawing",
        x0=port.x0,
        y0=min_float(port.y0, via.y0),
        x1=port.x1,
        y1=max_float(port.y1, via.y1),
    );
}

// Ties a gate input to a far track: up to met2 at the gate, down to met1 at
// the track, and across on met2.
fn tie_m2(port: Rect, track: Rect) {
    util::contact(Via::Mcon, port, port, longer=true);
    util::contact(Via::Via1, port, port, longer=true);
    let c = crect(x0=port.x0, y0=track.y0, x1=port.x1, y1=track.y1);
    let via = util::contact(Via::Via1, c, c, longer=true);
    rect(
        "met2.drawing",
        x0=via.top.x0,
        y0=min_float(port.y0, via.bbox.y0),
        x1=via.top.x1,
        y1=max_float(port.y1, via.bbox.y1),
    );
}

// Stacks rows of gates by their outlines, each 300 nm above the last.
fn stack(outlines: [Rect]) {
    for i in std::range(std::len(outlines) - 1) {
        eq(outlines[i + 1].y0, outlines[i].y1 + 300.);
    }
}

// Met1 tracks across a stage from x = `left` to `-left`, 320 nm wide on a
// 480 nm pitch, top down from y = 160.
fn bus(left: Float, n: Int) -> [Rect] {
    [for k in std::range(n) {
        crect(x0=left, y0=-160. - 480. * k as Float, x1=-left, y1=160. - 480. * k as Float)
    }]
}

// The rails `straps` extended across a stage from x = `left` to `-left`.
fn rails(straps: [Rect], left: Float) -> [Rect] {
    [for s in straps { crect(x0=left, y0=s.y0, x1=-left, y1=s.y1) }]
}

// One write-mask bit's decoder: a NAND2 of its mask and write-enable tracks,
// then folded-inverter stages, each a row of folded gates with a tap before
// every four.
cell wmask_decoder_stage(p: DecoderParams) {
    let maxff = p.max_folds;
    let left = -((util::ceil_div(maxff, 4) + 1) as Float * 1000. + maxff as Float * 1580.) / 2.;
    let sl = util::slots(left, maxff, 1580., 1000., 4);
    let stages = [for s in std::range(p.num_stages) {
        let g = p.stages[s];
        let inputs = if s == 0 { 2 } else { 1 };
        let row = [for t in std::range(maxff) {
            inst(
                dec_gate(
                    inputs,
                    g.nwidth,
                    g.pwidth,
                    filler=t >= g.folds,
                    signal_pins=true,
                    supply_pins=true,
                ),
                x=sl.gates[t],
            )
        }];
        for gate in row {
            eq(gate.y, row[0].y);
        }
        for x in sl.taps {
            eq(inst(dec_tap(inputs, g.nwidth, g.pwidth, later=false, top_dir=1), x=x).y, row[0].y);
        }
        row
    }];
    eq(stages[0][0].outline.y0, 300.);
    stack([for row in stages { row[0].outline }]);
    for s in std::range(p.num_stages - 1) {
        for t in std::range(p.stages[s].folds) {
            li_jog(stages[s][t].out, stages[s + 1][0].a, true);
        }
        for t in std::range(p.stages[s + 1].folds) {
            li_jog(stages[s][0].out, stages[s + 1][t].a, true);
        }
    }
    let last = p.num_stages - 1;
    if p.stages[last].folds > 1 {
        for t in std::range(p.stages[last].folds) {
            li_jog(stages[last][t].out, stages[last][0].out, false);
        }
    }
    pub let inputs = [for t in bus(left, 2) { util::met1_port(t.x0, t.y0, t.x1, t.y1) }];
    for t in std::range(p.stages[0].folds) {
        for i in std::range(2) {
            let port = stages[0][t].gates[i];
            let c = crect(x0=port.x0, y0=inputs[i].y0, x1=port.x1, y1=inputs[i].y1);
            let via = util::contact(Via::Mcon, c, c, top_dir=1, longer=true).bbox;
            rect(
                "li1.drawing",
                x0=port.x0,
                y0=min_float(port.y0, via.y0) - 30.,
                x1=port.x1,
                y1=max_float(port.y1, via.y1),
            );
        }
    }
    pub let outputs = [for t in std::range(p.stages[last].folds) { stages[last][t].out }];
    pub let outputs_b = [for t in std::range(p.stages[last - 1].folds) { stages[last - 1][t].out }];
    pub let vdd_straps = std::flatten([for row in stages { row[0].vdd_straps }]);
    pub let vss_straps = std::flatten([for row in stages { row[0].vss_straps }]);
    pub let nwells = [for row in stages { row[0].nwell }];
}

// The write-mask decoders and their DFFs, one per mask bit `unit_w` apart,
// with the write enable track and supply straps across all of them.
cell wmask_peripherals(cols: Int, mux: Int, gran: Int, p: DecoderParams) {
    let bits = cols / mux / gran;
    let unit_w = util::wmask_unit_w(cols, mux, gran);
    let dff_x = 4715. + ((mux - 4) / 2) as Float * 1200.;
    let st = bbox(wmask_decoder_stage(p));
    let right = (bits - 1) as Float * unit_w + max_float(dff_x + 1385., st.w);
    let stages = [for bit in std::range(bits) {
        inst(wmask_decoder_stage(p), x=bit as Float * unit_w - st.x0, y=16840. - st.y0)
    }];
    let dffs = [for bit in std::range(bits) {
        inst(lib::columns::dff::dff_column(4), x=bit as Float * unit_w + dff_x, y=1460.)
    }];
    for bit in std::range(bits) {
        let q = dffs[bit].q;
        let input = stages[bit].inputs[1];
        let track = util::centered(util::cx_i(q), 280.);
        let m1 = rect(
            "met1.drawing",
            x0=track.0,
            y0=min_float(q.y0, input.y0),
            x1=track.1,
            y1=max_float(q.y1, input.y1),
        );
        rect(
            "met1.drawing",
            x0=min_float(input.x0, track.0),
            y0=input.y0,
            x1=max_float(input.x1, track.1),
            y1=input.y1,
        );
        util::contact(Via::Mcon, q, m1, longer=true);
    }
    let s0 = stages[0];
    pub let we = util::met1_port(0., s0.inputs[0].y0, right, s0.inputs[0].y1);
    for s in std::concat(s0.vdd_straps, s0.vss_straps) {
        util::met1_port(0., s.y0, right, s.y1);
    }
    pub let vdd = util::met2_port(0., 5650., right, 7450.);
    pub let vss = util::met2_port(0., 9390., right, 11190.);
    pub let clk = util::met2_port(0., 8175., right, 8495.);
    pub let rstb = util::met2_port(0., 3940., right, 4260.);
    for nw in s0.nwells {
        rect("nwell.drawing", x0=0., y0=nw.y0, x1=(bits - 1) as Float * unit_w + st.w, y1=nw.y1);
    }
    pub let outputs = [for s in stages { s.outputs }];
    pub let outputs_b = [for s in stages { s.outputs_b }];
    pub let d = [for dff in dffs { dff.d }];
    pub let vdd_straps = s0.vdd_straps;
    pub let vss_straps = s0.vss_straps;
}

// Per-finger gate widths and fold counts of a fanout buffer: a folded
// inverter followed by multi-finger inverters, each stage folded into
// `folds` fingers.
struct BufferLayout {
    stages: [PrimitiveGateParams],
    folds: [Int],
    num_stages: Int,
    max_folds: Int,
    vertical: Bool,
}

fn max_of(values: [Int]) -> Int { max_of_from(values, 0) }

fn max_of_from(values: [Int], best: Int) -> Int {
    if values == [] { best } else { max_of_from(tail(values), max_int(head(values), best)) }
}

// The fold limit for a stage of `num` outputs within `max_width`.
fn stage_fold_limit(max_width: Int, num: Int, width: Int, tap_width: Int) -> Int {
    max_int(
        (max_width - tap_width * (util::ceil_div(max_width, 4 * width + tap_width) + 1)) / num / width,
        1,
    )
}

// Fingers for one gate: one per 1.8 um of its narrower device, up to `limit`.
fn gate_folds(g: PrimitiveGateParams, limit: Int) -> Int {
    min_int(max_int(min_int(g.pwidth, g.nwidth) / 1800, 1), limit)
}

// A width split across `folds` fingers, rounded to 10 nm.
fn fold_width(width: Int, folds: Int) -> Int {
    ((width as Float * (1. / (folds as Float)) / 10. + 0.5) as Int) * 10
}

fn fold_gate(g: PrimitiveGateParams, folds: Int) -> PrimitiveGateParams {
    PrimitiveGateParams {
        nwidth: fold_width(g.nwidth, folds),
        pwidth: fold_width(g.pwidth, folds),
        length: g.length,
    }
}

// Lays out a buffer chain within `max_width` (0 for no limit), in the
// minimum decoder style: 1580 nm gates and 1000 nm taps.
fn buffer_layout(sizing: BufferSizing, max_width: Int, vertical: Bool) -> BufferLayout {
    let limit = if max_width > 0 { stage_fold_limit(max_width, 1, 1580, 1000) } else { 1 };
    let folds = [for g in sizing.stages { gate_folds(g, limit) }];
    BufferLayout {
        stages: [for i in std::range(std::len(folds)) { fold_gate(sizing.stages[i], folds[i]) }],
        folds,
        num_stages: std::len(folds),
        max_folds: max_of(folds),
        vertical,
    }
}

// A fanout buffer: a row of folded inverters, then rows of multi-finger
// inverters, each 300 nm above the last with a tap before every four. Its
// input is a track below the chain, on met2 when `vertical`.
cell fanout_buffer(b: BufferLayout) {
    let maxff = b.max_folds;
    let left = -(1000. + maxff as Float * 1580. + ((maxff + 3) / 4) as Float * 1000.) / 2.;
    let sl = util::slots(left, maxff, 1580., 1000., 4);
    let g0 = b.stages[0];
    let first = [for t in std::range(maxff) {
        inst(
            dec_gate(
                1,
                g0.nwidth,
                g0.pwidth,
                filler=t >= b.folds[0],
                signal_pins=true,
                supply_pins=true,
                m2=b.vertical,
            ),
            x=sl.gates[t],
        )
    }];
    for gate in first {
        eq(gate.y, first[0].y);
    }
    for x in sl.taps {
        eq(inst(dec_tap(1, g0.nwidth, g0.pwidth, m2=b.vertical), x=x).y, first[0].y);
    }
    let rest = [for s in std::range(b.num_stages - 1) {
        let g = b.stages[s + 1];
        let row = [for t in std::range(maxff) {
            inst(mf_gate(g.nwidth, g.pwidth, filler=t >= b.folds[s + 1], pins=true), x=sl.gates[t])
        }];
        for gate in row {
            eq(gate.y, row[0].y);
        }
        for x in sl.taps {
            eq(inst(mf_tap(g.nwidth, g.pwidth), x=x).y, row[0].y);
        }
        row
    }];
    eq(first[0].outline.y0, 300.);
    stack(cons(first[0].outline, [for row in rest { row[0].outline }]));
    let ins = [for s in std::range(b.num_stages - 1) {
        [for t in std::range(b.folds[s + 1]) { rest[s][t].a }]
    }];
    let outs = cons(
        [for t in std::range(b.folds[0]) { first[t].out }],
        [for s in std::range(b.num_stages - 1) {
            [for t in std::range(b.folds[s + 1]) { rest[s][t].out }]
        }],
    );
    for s in std::range(b.num_stages - 1) {
        join(outs[s], ins[s], s == 0);
    }
    pub let outputs = std::last(outs);
    if std::len(outputs) > 1 {
        for port in outputs {
            let top = port.y1 + port.w + 200.;
            rect("met1.drawing", x0=port.x0, y0=port.y0, x1=port.x1, y1=top);
            rect(
                "met1.drawing",
                x0=min_float(port.x0, outputs[0].x0),
                y0=port.y1 + 200.,
                x1=max_float(port.x1, outputs[0].x0),
                y1=top,
            );
        }
    }
    pub let input = if b.vertical {
        util::met2_port(left, -160., -left, 160.)
    } else {
        util::met1_port(left, -160., -left, 160.)
    };
    let port = first[0].a;
    if b.vertical {
        let c = crect(x0=port.x0, y0=input.y0, x1=port.x1, y1=input.y1);
        let via = union(
            util::contact(Via::Mcon, c, c, longer=true, later=true).bbox,
            util::contact(Via::Via1, c, c, longer=true, later=true).bbox,
        );
        rect(
            "li1.drawing",
            x0=port.x0,
            y0=min_float(port.y0, via.y0),
            x1=port.x1,
            y1=max_float(port.y1, via.y1),
        );
    } else {
        tie(port, input);
    }
    let stripes = [for vdd in [true, false] {
        [for row in rest { if vdd { row[0].vdd_stripes } else { row[0].vss_stripes } }]
    }];
    pub let vdd = cons(
        rails(first[0].vdd_straps, left)[0],
        [for s in stripes[0] { rails(s, left)[0] }],
    );
    pub let vss = cons(
        rails(first[0].vss_straps, left)[0],
        [for s in stripes[1] { rails(s, left)[0] }],
    );
    // Supply port shapes: every strap and stripe of every stage.
    let first_vdd = rails(first[0].vdd_straps, left);
    let first_vss = rails(first[0].vss_straps, left);
    pub let vdd_pins_m1 = util::coalesce_rects(if b.vertical { [] } else { first_vdd });
    pub let vss_pins_m1 = util::coalesce_rects(if b.vertical { [] } else { first_vss });
    pub let vdd_pins_m2 = util::coalesce_rects(std::concat(
        if b.vertical { first_vdd } else { [] },
        rails(std::flatten(stripes[0]), left),
    ));
    pub let vss_pins_m2 = util::coalesce_rects(std::concat(
        if b.vertical { first_vss } else { [] },
        rails(std::flatten(stripes[1]), left),
    ));
}

// Per-finger widths and folds of a column decoder: a NAND2 or NAND3 stage,
// then the AND's inverter and the buffer inverters as multi-finger inverters.
struct ColDecoderLayout {
    inputs: Int,
    nand: PrimitiveGateParams,
    invs: [PrimitiveGateParams],
    folds: [Int],
    num_stages: Int,
    max_folds: Int,
}

// Folds a column decoder into `max_width` in the relaxed decoder style:
// 1900 nm gates and 1000 nm taps, one output per select value.
fn col_decoder_layout(sizing: AndStageSizing, max_width: Int) -> ColDecoderLayout {
    let limit = stage_fold_limit(max_width, col_outputs(sizing.inputs), 1900, 1000);
    let gates = cons(sizing.nand, cons(sizing.inv, sizing.invs));
    let folds = [for g in gates { gate_folds(g, limit) }];
    let folded = [for i in std::range(std::len(gates)) { fold_gate(gates[i], folds[i]) }];
    ColDecoderLayout {
        inputs: sizing.inputs,
        nand: head(folded),
        invs: tail(folded),
        folds,
        num_stages: std::len(gates),
        max_folds: max_of(folds),
    }
}

fn col_outputs(inputs: Int) -> Int { if inputs == 3 { 8 } else { 4 } }

// A column decoder's gates: a row of NAND2s or NAND3s, one group of `folds`
// slots per output, then rows of multi-finger inverters, with predecode
// tracks below. Input `i` of output `n` takes bit `i` of `n` from tracks 2i
// and 2i + 1.
cell column_decoder_stage(c: ColDecoderLayout, embedded: Bool) {
    let num = col_outputs(c.inputs);
    let n = num * c.max_folds;
    let left = -(1000. * (1 + util::ceil_div(n, 4)) as Float + 1900. * n as Float) / 2.;
    let sl = util::slots(left, n, 1900., 1000., 4);
    let nands = [for k in std::range(n) {
        inst(
            dec_gate(
                c.inputs,
                c.nand.nwidth,
                c.nand.pwidth,
                width=1900,
                filler=k % c.max_folds >= c.folds[0],
                signal_pins=!embedded && c.inputs == 2,
                supply_pins=true,
            ),
            x=sl.gates[k],
        )
    }];
    for gate in nands {
        eq(gate.y, nands[0].y);
    }
    for x in sl.taps {
        eq(inst(dec_tap(2, c.nand.nwidth, c.nand.pwidth), x=x).y, nands[0].y);
    }
    let invs = [for s in std::range(c.num_stages - 1) {
        let g = c.invs[s];
        let pins = !embedded || s == c.num_stages - 2;
        let row = [for k in std::range(n) {
            inst(
                mf_gate(
                    g.nwidth,
                    g.pwidth,
                    width=1900,
                    filler=k % c.max_folds >= c.folds[s + 1],
                    pins=pins,
                ),
                x=sl.gates[k],
            )
        }];
        for gate in row {
            eq(gate.y, row[0].y);
        }
        for x in sl.taps {
            eq(inst(mf_tap(g.nwidth, g.pwidth), x=x).y, row[0].y);
        }
        row
    }];
    eq(nands[0].outline.y0, 300.);
    stack(cons(nands[0].outline, [for row in invs { row[0].outline }]));
    let ins = [for s in std::range(c.num_stages - 1) {
        [for o in std::range(num) {
            [for f in std::range(c.folds[s + 1]) { invs[s][o * c.max_folds + f].a }]
        }]
    }];
    let outs = cons(
        [for o in std::range(num) {
            [for f in std::range(c.folds[0]) { nands[o * c.max_folds + f].out }]
        }],
        [for s in std::range(c.num_stages - 1) {
            [for o in std::range(num) {
                [for f in std::range(c.folds[s + 1]) { invs[s][o * c.max_folds + f].out }]
            }]
        }],
    );
    for s in std::range(c.num_stages - 1) {
        for o in std::range(num) {
            join(outs[s][o], ins[s][o], s == 0);
        }
    }
    pub let vdd = rails(nands[0].vdd_straps, left)[0];
    pub let vss = rails(nands[0].vss_straps, left)[0];
    pub let predecode = [for t in bus(left, 2 * c.inputs) {
        util::met1_port(t.x0, t.y0, t.x1, t.y1)
    }];
    for o in std::range(num) {
        for f in std::range(c.folds[0]) {
            for i in std::range(c.inputs) {
                tie(
                    nands[o * c.max_folds + f].gates[i],
                    predecode[2 * i + group_value(o, [2, 2, 2], i)],
                );
            }
        }
    }
    pub let outputs = std::last(outs);
    pub let outputs_b = std::last(ins);
    pub let vdd_m1 = rails(nands[0].vdd_straps, left);
    pub let vss_m1 = rails(nands[0].vss_straps, left);
    pub let vdd_m2 = rails(std::flatten([for row in invs { row[0].vdd_stripes }]), left);
    pub let vss_m2 = rails(std::flatten([for row in invs { row[0].vss_stripes }]), left);
}

// A two- or three-bit column decoder, placed by its lower-right corner at
// the origin above its predecode tracks.
cell column_decoder(c: ColDecoderLayout) {
    let stage = inst(column_decoder_stage(c, true), y=(160 + 480 * (2 * c.inputs - 1)) as Float);
    eq(stage.predecode[0].x1, 0.);
    pub let outputs = stage.outputs;
    pub let outputs_b = stage.outputs_b;
    pub let predecode = stage.predecode;
    pub let vdd = stage.vdd;
    pub let vss = stage.vss;
    // Supply port shapes: the NAND row's met1 straps and the inverter rows'
    // met2 stripes.
    pub let vdd_pins_m1 = util::coalesce_rects(stage.vdd_m1);
    pub let vss_pins_m1 = util::coalesce_rects(stage.vss_m1);
    pub let vdd_pins_m2 = util::coalesce_rects(stage.vdd_m2);
    pub let vss_pins_m2 = util::coalesce_rects(stage.vss_m2);
}

// The address gates: AND2s of the address predecode lines, each driving a
// row of the wordline decoder, with their inputs tied to the wordline enable.
cell address_gate_stage(num: Int) {
    let nand = PrimitiveGateParams { nwidth: 2000, pwidth: 2500, length: 150 };
    let inv = PrimitiveGateParams { nwidth: 4000, pwidth: 10000, length: 150 };
    let left = -(num as Float * 1580. + (util::ceil_div(num, 4) + 1) as Float * 1000.) / 2.;
    let sl = util::slots(left, num, 1580., 1000., 4);
    for x in sl.taps {
        inst(and2_tap(nand, inv, 1000), x=x, y=840.);
    }
    let gates = [for x in sl.gates { inst(and2_gate(nand, inv, pins=true), x=x, y=840.) }];
    pub let wl_en = util::met1_port(left, -160., -left, 160.);
    pub let outputs = [for g in gates { g.out }];
    pub let inputs = [for g in gates { g.b }];
    // Supply port shapes: the AND2 row's met1 straps.
    pub let vdd_pins_m1 = util::coalesce_rects(rails(gates[0].vdd_straps, left));
    pub let vss_pins_m1 = util::coalesce_rects(rails(gates[0].vss_straps, left));
    pub let vdd_pins_m2: [Rect] = [];
    pub let vss_pins_m2: [Rect] = [];
    for g in gates {
        tie(g.a, wl_en);
    }
}

// The row decoder is a tree of AND stages. The root has unfolded AND2 gates
// followed by multi-finger inverters. Every other node is a row of NAND gates
// under a row of folded inverters, folded to fit a share of its parent's
// width. Gates sit in 1580 nm slots with a 1580 nm tap after every four, or in
// 3160 nm slots with a tap after every two for three-input gates. Each stage
// has one predecode track per input value below it.
struct NodeStage {
    root: Bool,
    leaf: Bool,
    inputs: Int,
    num: Int,
    width: Int,
    period: Int,
    nand: PrimitiveGateParams,
    inv: PrimitiveGateParams,
    invs: [PrimitiveGateParams],
    nand_folds: Int,
    inv_folds: Int,
    max_folds: Int,
    groups: [Int],
}

fn log2(n: Int) -> Int { if n <= 1 { 0 } else { 1 + log2(n / 2) } }

// First track of group `i`.
fn group_offset(groups: [Int], i: Int) -> Int {
    if i == 0 { 0 } else { head(groups) + group_offset(tail(groups), i - 1) }
}

// The value output `n` takes from group `i`: the digits of `n` in the mixed
// radix of the group sizes.
fn group_value(n: Int, groups: [Int], i: Int) -> Int {
    if i == 0 { n % head(groups) } else { group_value(n / head(groups), tail(groups), i - 1) }
}

fn node_stage(r: RowDecoderSizing, index: Int, max_width: Int) -> NodeStage {
    let n = r.nodes[index];
    let width = if n.inputs == 3 { 3160 } else { 1580 };
    let period = if n.inputs == 3 { 2 } else { 4 };
    let groups = if n.children == [] {
        [for i in std::range(log2(n.num)) { 2 }]
    } else {
        [for i in n.children { r.nodes[i].num }]
    };
    if index == 0 {
        NodeStage {
            root: true,
            leaf: n.children == [],
            inputs: n.inputs,
            num: n.num,
            width,
            period,
            nand: n.nand,
            inv: n.inv,
            invs: n.invs,
            nand_folds: 1,
            inv_folds: 1,
            max_folds: 1,
            groups,
        }
    } else {
        let limit = max_int(
            (max_width - 1580 * (util::ceil_div(max_width, period * width + 1580) + 1)) / n.num / width,
            1,
        );
        let nf = gate_folds(n.nand, limit);
        let inf = gate_folds(n.inv, limit);
        NodeStage {
            root: false, leaf: n.children == [], inputs: n.inputs, num: n.num, width, period,
            nand: fold_gate(n.nand, nf), inv: fold_gate(n.inv, inf), invs: [],
            nand_folds: nf, inv_folds: inf, max_folds: max_int(nf, inf), groups,
        }
    }
}

fn node_slots(s: NodeStage) -> Int { s.num * s.max_folds }
fn node_stage_w(s: NodeStage) -> Int {
    node_slots(s) * s.width + (util::ceil_div(node_slots(s), s.period) + 1) * 1580
}
fn node_left(s: NodeStage) -> Float { -(node_stage_w(s) / 2) as Float }

// The stage is placed by its lower-right corner, below the last track.
fn node_dy(s: NodeStage) -> Float { (480 * std::sum(s.groups) - 320) as Float }

// One stage of the row decoder tree, with its predecode tracks. The root is
// a row of AND2s then rows of multi-finger inverters; other stages are a row
// of NANDs under a row of folded inverters, each output's first NAND fold
// driving every inverter fold and every NAND fold the first inverter fold.
cell row_decoder_stage(s: NodeStage) {
    let left = node_left(s);
    let sl = util::slots(left, node_slots(s), s.width as Float, 1580., s.period);
    pub let tracks = bus(left, std::sum(s.groups));
    for t in tracks {
        util::draw_box("met1.drawing", t);
        if s.leaf {
            util::draw_box("met1.pin", t);
        }
    }
    // Gate inputs (by slot) and outputs (by output and fold), and the met1
    // straps of the first two rows and the met2 stripes of the rest.
    let ports = if s.root {
        for x in sl.taps {
            inst(and2_tap(s.nand, s.inv, 1580), x=x, y=840.);
        }
        let ands = [for x in sl.gates { inst(and2_gate(s.nand, s.inv), x=x, y=840.) }];
        let invs = [for k in std::range(std::len(s.invs)) {
            let g = s.invs[k];
            let row = [for x in sl.gates {
                inst(mf_gate(g.nwidth, g.pwidth, pins=k == std::len(s.invs) - 1), x=x)
            }];
            for gate in row {
                eq(gate.y, row[0].y);
            }
            for x in sl.taps {
                eq(inst(mf_tap(g.nwidth, g.pwidth, width=1580), x=x).y, row[0].y);
            }
            row
        }];
        stack(cons(ands[0].outline, [for row in invs { row[0].outline }]));
        let outs = cons([for g in ands { g.out }], [for row in invs { [for g in row { g.out }] }]);
        for k in std::range(std::len(s.invs)) {
            for i in std::range(s.num) {
                join([outs[k][i]], [invs[k][i].a], k == 0);
            }
        }
        StagePorts {
            inputs: [for g in ands { [g.a, g.b] }],
            outputs: [for o in std::last(outs) { [o] }],
            vdd: ands[0].vdd_straps,
            vss: ands[0].vss_straps,
            vdd_m2: std::flatten([for row in invs { row[0].vdd_stripes }]),
            vss_m2: std::flatten([for row in invs { row[0].vss_stripes }]),
        }
    } else {
        let nands = [for k in std::range(node_slots(s)) {
            inst(
                dec_gate(
                    s.inputs,
                    s.nand.nwidth,
                    s.nand.pwidth,
                    width=s.width,
                    filler=k % s.max_folds >= s.nand_folds,
                    supply_pins=true,
                ),
                x=sl.gates[k],
                y=840.,
            )
        }];
        let invs = [for k in std::range(node_slots(s)) {
            inst(
                dec_gate(
                    1,
                    s.inv.nwidth,
                    s.inv.pwidth,
                    width=s.width,
                    filler=k % s.max_folds >= s.inv_folds,
                    supply_pins=true,
                ),
                x=sl.gates[k],
            )
        }];
        for gate in invs {
            eq(gate.y, invs[0].y);
        }
        for x in sl.taps {
            inst(dec_tap(2, s.nand.nwidth, s.nand.pwidth, width=1580), x=x, y=840.);
            eq(inst(dec_tap(1, s.inv.nwidth, s.inv.pwidth, width=1580), x=x).y, invs[0].y);
        }
        eq(invs[0].outline.y0, nands[0].outline.y1 + 300.);
        for n in std::range(s.num) {
            let first = n * s.max_folds;
            for j in std::range(s.nand_folds) {
                li_jog(nands[first + j].out, invs[first].a, true);
            }
            for j in std::range(s.inv_folds) {
                li_jog(nands[first].out, invs[first + j].a, true);
            }
        }
        StagePorts {
            inputs: [for g in nands { g.gates }],
            outputs: [for n in std::range(s.num) {
                [for j in std::range(s.inv_folds) { invs[n * s.max_folds + j].out }]
            }],
            vdd: std::concat(nands[0].vdd_straps, invs[0].vdd_straps),
            vss: std::concat(nands[0].vss_straps, invs[0].vss_straps),
            vdd_m2: [],
            vss_m2: [],
        }
    };
    for n in std::range(s.num) {
        for k in std::range(s.nand_folds) {
            for i in std::range(s.inputs) {
                let port = ports.inputs[n * s.max_folds + k][i];
                let track = tracks[group_offset(s.groups, i) + group_value(n, s.groups, i)];
                if s.groups[i] > 6 { tie_m2(port, track); } else { tie(port, track); }
            }
        }
    }
    pub let outputs = ports.outputs;
    pub let vdd = rails(ports.vdd, left);
    pub let vss = rails(ports.vss, left);
    pub let vdd_m2 = rails(ports.vdd_m2, left);
    pub let vss_m2 = rails(ports.vss_m2, left);
}

// A decoder stage's gate inputs by slot, its outputs by output and fold, and
// its supply straps.
struct StagePorts {
    inputs: [[Rect]],
    outputs: [[Rect]],
    vdd: [Rect],
    vss: [Rect],
    vdd_m2: [Rect],
    vss_m2: [Rect],
}

// Jogs a child's output up to the parent's predecode track `dst` on met2.
fn child_route(src: Rect, dst: Rect, final_width: Int) {
    let li = rect("li1.drawing", x0=src.x0, y0=src.y0, x1=src.x1, y1=src.y1 + 340.);
    let area = crect(x0=li.x0, y0=li.y1 - 170., x1=li.x1, y1=li.y1);
    util::contact(Via::Mcon, area, area, longer=true, later=true);
    let m2 = util::contact(Via::Via1, area, area, longer=true, later=true).top;
    let space = (final_width / 2) as Float - m2.h;
    rect("met2.drawing", x0=m2.x0 - m2.h - space, y0=m2.y0, x1=m2.x1, y1=m2.y1);
    let r2 = rect(
        "met2.drawing",
        x0=m2.x0 - m2.h - space,
        y0=min_float(m2.y0, dst.y1),
        x1=m2.x0 - space,
        y1=max_float(m2.y1, dst.y1),
    );
    util::contact(Via::Via1, dst, r2, longer=true, later=true);
}

// The predecode tracks of a node's children and the met1 rails of every
// stage below it.
struct ChildrenPorts {
    predecode: [Rect],
    vdd_m1: [Rect],
    vss_m1: [Rect],
}

// Places children `k` onward with the next one's right edge at x, joins
// their outputs to this stage's tracks, and returns their ports.
fn place_children(
    r: RowDecoderSizing,
    n: DecoderNodeSizing,
    s: NodeStage,
    tracks: [Rect],
    k: Int,
    x: Float,
    max_width: Int,
) -> ChildrenPorts {
    if k == std::len(n.children) {
        ChildrenPorts { predecode: [], vdd_m1: [], vss_m1: [] }
    } else {
        let index = n.children[k];
        let sub = row_decoder_node(r, index, max_width);
        let b = bbox(sub);
        let child = inst(sub, x=x - b.x1, y=-340. - b.y1);
        let outputs = child.outputs;
        for j in std::range(s.groups[k]) {
            for src in outputs[j] {
                child_route(
                    src,
                    tracks[group_offset(s.groups, k) + j],
                    if r.nodes[index].inputs == 3 { 3160 } else { 1580 },
                );
            }
        }
        let rest = place_children(
            r,
            n,
            s,
            tracks,
            k + 1,
            x - (util::ceil_div((b.x1 - b.x0) as Int, 7900) * 7900) as Float,
            max_width,
        );
        ChildrenPorts {
            predecode: std::concat(child.predecode, rest.predecode),
            vdd_m1: std::concat(child.vdd_m1_tree, rest.vdd_m1),
            vss_m1: std::concat(child.vss_m1_tree, rest.vss_m1),
        }
    }
}

// The subtree at node `index`, placed by its root stage's lower-right corner.
cell row_decoder_node(r: RowDecoderSizing, index: Int, max_width: Int) {
    let n = r.nodes[index];
    let s = node_stage(r, index, max_width);
    let stage = inst(row_decoder_stage(s), x=node_left(s), y=node_dy(s));
    let total = if index == 0 { node_stage_w(s) } else { max_width };
    let below = place_children(r, n, s, stage.tracks, 0, 0., total / (std::len(n.children) + 1));
    pub let outputs = stage.outputs;
    pub let predecode = if n.children == [] { stage.tracks } else { below.predecode };
    // The met1 rails of every stage in the subtree.
    pub let vdd_m1_tree = std::concat(stage.vdd, below.vdd_m1);
    pub let vss_m1_tree = std::concat(stage.vss, below.vss_m1);
    pub let vdd_m2 = stage.vdd_m2;
    pub let vss_m2 = stage.vss_m2;
}

// The row decoder, placed by its root stage's lower-right corner.
cell row_decoder(r: RowDecoderSizing) {
    let tree = inst(row_decoder_node(r, 0, 0), x=0., y=0.);
    pub let outputs = [for folds in tree.outputs { head(folds) }];
    pub let predecode = tree.predecode;
    // Supply port shapes: every stage's met1 straps and the root's met2
    // stripes.
    pub let vdd_pins_m1 = util::coalesce_rects(tree.vdd_m1_tree);
    pub let vss_pins_m1 = util::coalesce_rects(tree.vss_m1_tree);
    pub let vdd_pins_m2 = util::coalesce_rects(tree.vdd_m2);
    pub let vss_pins_m2 = util::coalesce_rects(tree.vss_m2);
}

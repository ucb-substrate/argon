use std::layout::{crect, inst, rect, shapes, union};
use lib::columns::util;
use lib::columns::util::Via;

// The latch's cross-coupled NMOS: one two-finger device.
cell latch_nmos() {
    let m = inst(
        util::mos([util::nmos(1000)], 150, 2, gates=util::Gates::Merged),
        x=0.,
        y=0.,
        angle=270,
    );
    pub let a = m.gate[0];
    pub let sd = m.sd[0];
    for r in [a, sd[0], sd[1], sd[2]] {
        util::draw_box("li1.pin", r);
    }
}

// Extends li1 `r` vertically to reach `to`.
fn stitch(r: Rect, to: Rect) {
    rect("li1.drawing", x0=r.x0, y0=min_float(r.y0, to.y0), x1=r.x1, y1=max_float(r.y1, to.y1));
}

// Crosses gate `from` at y to gate `to` at `y_final` on li1 tracks 170 nm
// tall, joined by a met1 track at x = `track`.
fn cross(from: Rect, to: Rect, track: (Float, Float), y: Float, y_final: Float) {
    let a = rect(
        "li1.drawing",
        x0=min_float(from.x0, track.0),
        y0=y,
        x1=max_float(from.x1, track.1),
        h=170.,
    );
    let m1 = rect(
        "met1.drawing",
        x0=track.0,
        y0=min_float(y, y_final),
        x1=track.1,
        y1=max_float(y, y_final) + 170.,
    );
    let b = rect(
        "li1.drawing",
        x0=min_float(to.x0, track.0),
        y0=y_final,
        x1=max_float(to.x1, track.1),
        h=170.,
    );
    util::contact(Via::Mcon, a, m1, longer=true);
    util::contact(Via::Mcon, b, m1, longer=true);
}

// An 800 nm met2 supply stripe across the sense amp's span, centered on
// `port` (rounded toward zero to the grid).
fn stripe(port: Rect) -> Rect {
    let y0 = ((util::cy_i(port) - 400.) / 5.) as Int as Float * 5.;
    util::met2_port(-810., y0, 3990., y0 + 800.)
}

// The sense latch, two columns 2.07 um apart: input inverters, the
// cross-coupled NMOS, and two inverter stages to the outputs, each turned to
// run up the column, with a row of supply stripes per stage.
cell diff_latch() {
    let xs = [0., 2070.];
    let inv = [for y in [0., -4890., -7900.] {
        [for x in xs { inst(util::gate(1, 1200, 2000, pins=true), x=x, y=y, angle=270) }]
    }];
    let mn = [for x in xs { inst(latch_nmos(), x=x, y=-3010.) }];
    for k in std::range(2) {
        stitch(inv[0][k].out, mn[k].a);
        stitch(mn[k].sd[1], inv[1][k].a);
        stitch(inv[1][k].out, inv[2][k].a);
    }
    let al = inv[1][0].a;
    let ar = inv[1][1].a;
    let y_final = inv[1][0].vss[1].y0 - 340.;
    let xl = inv[1][0].vss[1].x1;
    let xr = inv[1][1].vss[0].x0;
    cross(al, ar, (xr - 400., xr - 200.), al.y0, y_final);
    cross(ar, al, (xl + 200., xl + 400.), al.y0 + 340., y_final);
    for k in std::range(2) {
        let li = inv[0][k].a;
        let x0 = if k == 0 { -290. } else { 3190. };
        let m0 = rect(
            "li1.drawing",
            x0=min_float(li.x0, x0),
            y0=li.y0,
            x1=max_float(li.x1, x0 + 280.),
            y1=li.y1,
        );
        let din = util::met1_port(x0, min_float(li.y0, 870.), x0 + 280., max_float(li.y1, 870.));
        util::contact(Via::Mcon, m0, din, longer=true);
    }

    // Each stage's sources to its stripes, and the NMOS sources to theirs.
    pub let vdd = [for row in inv { supply(row[0].vdd[0], std::concat(row[0].vdd, row[1].vdd)) }];
    let mn_vss = stripe(mn[0].sd[0]);
    for port in [mn[0].sd[0], mn[0].sd[2], mn[1].sd[0], mn[1].sd[2]] {
        let r = crect(x0=port.x0, y0=mn_vss.y0, x1=port.x1, y1=mn_vss.y1);
        let c = util::contact(Via::Mcon, r, r, longer=true);
        util::contact(Via::Via1, c.top, r, longer=true);
    }
    pub let vss = cons(
        mn_vss,
        [for row in inv { supply(row[0].vss[0], std::concat(row[0].vss, row[1].vss)) }],
    );

    pub let nwell = [for row in inv {
        rect(
            "nwell.drawing",
            x0=-810.,
            y0=shapes(row[0], "nwell.drawing")[0].y0,
            x1=3990.,
            y1=shapes(row[0], "nwell.drawing")[0].y1,
        )
    }];
    pub let psdm = [for row in inv {
        util::draw_box(
            "psdm.drawing",
            union(shapes(row[0], "psdm.drawing")[0], shapes(row[1], "psdm.drawing")[0]),
        )
    }];
    pub let nsdm = cons(
        shapes(mn[0], "nsdm.drawing")[0],
        [for row in inv {
            util::draw_box(
                "nsdm.drawing",
                union(shapes(row[0], "nsdm.drawing")[0], shapes(row[1], "nsdm.drawing")[0]),
            )
        }],
    );
    pub let dout1 = inv[2][0].out;
    pub let dout2 = inv[2][1].out;
}

// A supply stripe centered on `center`, tied to each of `ports`.
fn supply(center: Rect, ports: [Rect]) -> Rect {
    let s = stripe(center);
    for port in ports {
        let c = util::contact(Via::Mcon, port, port, longer=true);
        util::contact(Via::Via1, c.top, s, longer=true);
    }
    s
}

// A 1.3 um tap between latches: well and substrate taps under each of the
// latch's supply stripes, which it carries across.
cell diff_latch_cent() {
    let l = inst(diff_latch(), x=0., y=0., construction=true);
    for i in std::range(7) {
        let vdd = i >= 4;
        let implant = if vdd { l.psdm[i - 4] } else { l.nsdm[i] };
        let power = if vdd { l.vdd[i - 4] } else { l.vss[i] };
        let area = crect(x0=200., y0=implant.y0 + 200., x1=1100., y1=implant.y1 - 200.);
        util::draw_box(
            if vdd { "nsdm.drawing" } else { "psdm.drawing" },
            util::grow(util::tap(area).bot, 130., 130.),
        );
        let stripe = util::met2_port(0., power.y0, 1300., power.y1);
        let m1 = util::contact(Via::Mcon, area, area, top_dir=1, longer=true);
        util::contact(Via::Via1, m1.top, stripe, longer=true);
    }
    for nw in l.nwell {
        rect("nwell.drawing", x0=0., y0=nw.y0, x1=1300., y1=nw.y1);
    }
    rect("layout_boundary.boundary", x0=0., y0=-10200., x1=1300., y1=870.);
}

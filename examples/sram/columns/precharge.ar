use std::layout::{bbox, crect, inst, rect};
use lib::params::PrechargeParams;
use lib::columns::util;
use lib::columns::util::{Contact, Gates, Via};

// A precharge in a 1.2 um column: the equalizer and two pull-ups turned to run
// up the column, gated by the en_b stripes below and above them. Bitlines come
// in from the bitcells on the in tracks at the top and leave for the column mux
// on the out tracks at the bottom. Stripes span three columns, and every shape
// is trimmed to this one.
cell precharge_exact(p: PrechargeParams) {
    let w = 1200.;
    let e = p.equalizer_width as Float;
    let pu = p.pull_up_width as Float;
    let enb = p.en_b_width as Float;
    let gate_bot = crect(x0=-w, y0=360. - enb, x1=2. * w, y1=360.);
    let mos = inst(
        util::mos(
            [
                util::pmos(p.equalizer_width),
                util::pmos(p.pull_up_width),
                util::pmos(p.pull_up_width),
            ],
            p.length,
            1,
            gates=Gates::Both,
        ),
        angle=90,
    );
    let dev = bbox(mos);
    eq(dev.x0 + dev.x1, w);
    eq(dev.y0, gate_bot.y1);
    let gate_top = crect(x0=-w, y0=dev.y1, x1=2. * w, h=enb);
    let vdd_h = min_float(max_float(pu, 800.), 3600.);
    let stripe = crect(x0=-w, y0=e + pu + 1245. - vdd_h / 2., x1=2. * w, h=vdd_h);
    let bottom = min_float(0., gate_bot.y0 - enb / 4.);
    let cut_bot = 715. + e;
    let cut_top = gate_top.y0 - 500.;
    let ins = util::in_tracks();
    let outs = util::out_tracks();
    let sd = mos.sd;
    let gate = mos.gate[0];
    let gate_x = crect(x0=outs[1].0, y0=mos.gate_x[0].y0, x1=outs[1].1, y1=gate_top.y1);

    // Out tracks from the cell bottom; the middle one carries the gate.
    let o = [for i in std::range(3) {
        crect(x0=outs[i].0, y0=bottom, x1=outs[i].1, y1=if i == 1 { gate.y1 } else { cut_bot })
    }];
    let jog_top = util::jog(cut_bot, [outs[0], outs[2]], [ins[1], ins[2]]);
    let r = [for t in ins { crect(x0=t.0, y0=jog_top, x1=t.1, y1=cut_top) }];
    for i in std::range(4) {
        util::trim("met1.drawing", util::grow(r[i], if i % 3 == 0 { 60. } else { 0. }, 0.), w);
    }

    // Drains to the in tracks, sources to vdd through the edge tracks, the
    // equalizer to the out tracks, and the gate contacts to en_b.
    let sd_bot = util::grow(sd[1][0], 0., -20.);
    let sd_mid = util::grow(sd[2][1], 0., -20.);
    util::contact(Via::Mcon, sd_bot, r[2], longer=true, clip=w, dx=5.);
    util::contact(Via::Mcon, sd_mid, r[1], longer=true, clip=w);
    pub let m1_vias = [
        util::contact(
            Via::Mcon,
            crect(x0=w, y0=sd[2][0].y0 + 20., x1=w, y1=sd[2][0].y1 - 20.),
            r[3],
            longer=true,
            clip=w,
        ),
        util::contact(
            Via::Mcon,
            crect(x0=0., y0=sd[1][1].y0 + 20., x1=0., y1=sd[1][1].y1 - 20.),
            r[0],
            longer=true,
            clip=w,
        ),
    ];
    rect("li1.drawing", x0=sd[2][0].x0, y0=sd[2][0].y0, x1=w, y1=sd[2][0].y1);
    rect("li1.drawing", x0=0., y0=sd[1][1].y0, x1=sd[1][1].x1, y1=sd[1][1].y1);
    for k in std::range(2) {
        let x = (o[2 * k].x0 + o[2 * k].x1) / 2.;
        let s = sd[0][k];
        util::contact(
            Via::Mcon,
            crect(x0=x, y0=s.y0 + 20., x1=x, y1=s.y1 - 20.),
            util::grow(o[2 * k], 0., -80.),
            longer=true,
            clip=w,
        );
    }
    util::contact(Via::Mcon, gate_bot, util::grow(o[1], 0., -80.), longer=true, clip=w);
    util::contact(Via::Mcon, gate_top, util::grow(gate_x, 0., -80.), longer=true, clip=w);

    pub let vdd = util::trim("met2.drawing", stripe, w);
    util::trim("met2.pin", stripe, w);
    // The edge tracks, doubled across the column edges, to vdd.
    pub let m2_via = util::contact(
        Via::Via1,
        crect(x0=-70., y0=jog_top, x1=70., y1=cut_top),
        stripe,
        longer=true,
        clip=w,
    );
    util::contact(
        Via::Via1,
        crect(x0=1130., y0=jog_top, x1=1270., y1=cut_top),
        stripe,
        longer=true,
        clip=w,
    );
    util::contact(Via::Via1, o[1], gate_bot, longer=true, clip=w);
    let gate_ct = util::contact(Via::Via1, gate_x, gate_top, longer=true, clip=w).bbox.y1;
    rect("li1.drawing", x0=gate.x0, y0=o[1].y0, x1=gate.x1, y1=o[1].y1);
    rect("li1.drawing", x0=gate.x0, y0=gate_x.y0, x1=gate.x1, y1=gate_x.y1);

    // The in tracks jog over the gate contact to the out tracks and back.
    let y2 = util::jog(cut_top, [ins[1], ins[2]], [outs[0], outs[2]]);
    for i in [0, 2] {
        rect("met1.drawing", x0=outs[i].0, y0=y2, x1=outs[i].1, y1=gate_ct);
    }
    let top = util::jog(gate_ct, [outs[0], outs[2]], [ins[1], ins[2]]);
    let br_in = rect("met1.drawing", x0=ins[1].0, y0=top - 140., x1=ins[1].1, y1=top);
    let bl_in = rect("met1.drawing", x0=ins[2].0, y0=top - 140., x1=ins[2].1, y1=top);
    let br_out = util::draw_box("met1.drawing", o[0]);
    let bl_out = util::draw_box("met1.drawing", o[2]);
    for port in [br_in, bl_in, br_out, bl_out] {
        util::draw_box("met1.pin", port);
    }
    pub let en_b = [
        util::trim("met2.drawing", gate_bot, w),
        util::trim("met2.drawing", gate_top, w),
    ];
    util::trim("met2.pin", gate_bot, w);
    util::trim("met2.pin", gate_top, w);
    pub let br = [br_out, br_in];
    pub let bl = [bl_out, bl_in];
    pub let tracks = r;

    // Implants and well across the column.
    for s in std::layout::shapes(mos, "psdm.drawing") {
        rect("psdm.drawing", x0=0., y0=s.y0, x1=w, y1=s.y1);
    }
    pub let outline = rect("nwell.drawing", x0=0., y0=bottom, x1=w, y1=top);
}

// Draws `c` centered on x = `x` in a 1.3 um tap. Returns its bounds.
fn draw_centered(c: Contact, x: Float) -> Rect {
    util::draw_contact(util::moved(c, x - util::cx_i(c.bbox)), clip=1300.);
    c.bbox
}

// A 1.3 um n-tap between precharges: the tap ties the well to vdd, and the
// precharges' edge contacts are repeated on its right edge (and its left edge
// when `both_sides`), the bitline edge track contact on top when `via_top`.
cell precharge_tap(p: PrechargeParams, both_sides: Bool, via_top: Bool) {
    let pc = inst(precharge_exact(p), x=0., y=0., construction=true);
    let o = pc.outline;
    let brect = crect(x0=0., y0=o.y0, x1=1300., y1=o.y1);
    util::draw_box("nwell.drawing", brect);
    util::draw_box("nsdm.drawing", brect);
    let tap = util::tap_contact(util::grow(brect, -300., -300.), (0., 120.), (0., 120.), (80., 0.));
    let m1 = util::contact(Via::Mcon, tap.top, tap.top, top_dir=1);
    util::draw_box("li1.drawing", crect(x0=tap.top.x0, y0=m1.bot.y0, x1=tap.top.x1, y1=m1.bot.y1));

    let t = pc.tracks[0];
    let m1_via = pc.m1_vias[if via_top || both_sides { 0 } else { 1 }];
    rect("met1.drawing", x0=1170., y0=t.y0, x1=1300., y1=t.y1);
    let right = draw_centered(m1_via, 1300.);
    rect("li1.drawing", x0=tap.top.x0, y0=right.y0, x1=1300., y1=right.y1);
    if both_sides {
        rect("met1.drawing", x0=0., y0=t.y0, x1=130., y1=t.y1);
        let left = draw_centered(m1_via, 0.);
        rect("li1.drawing", x0=0., y0=left.y0, x1=tap.top.x1, y1=left.y1);
        draw_centered(pc.m2_via, 0.);
    }
    draw_centered(pc.m2_via, 1300.);

    pub let en_b = [for s in pc.en_b { util::met2_port(0., s.y0, 1300., s.y1) }];
    pub let vdd = util::met2_port(0., pc.vdd.y0, 1300., pc.vdd.y1);
    util::contact(Via::Via1, m1.top, vdd, bot_dir=1, top_dir=1);
    pub let outline = brect;
}

// The replica column's precharge: two precharges between end taps, their
// outputs tied to the replica bitlines on two met2 tracks below en_b.
cell replica_precharge(p: PrechargeParams) {
    let y0 = (90. - bbox(precharge_exact(p)).y1) / 2.;
    inst(precharge_tap(p, false, false), x=0., y=y0);
    let pc0 = inst(precharge_exact(p), x=1300., y=y0);
    let pc1 = inst(precharge_exact(p), x=3700., y=y0, reflect=true, angle=180);
    inst(precharge_tap(p, false, false), x=5000., y=y0, reflect=true, angle=180);

    pub let en_b = [for s in pc0.en_b { util::met2_port(0., s.y0, 5000., s.y1) }];
    pub let vdd = util::met2_port(0., pc0.vdd.y0, 5000., pc0.vdd.y1);
    pub let vdd_pins_m2 = [vdd];
    let en = en_b[0];
    let tracks = [for i in [1, 2] {
        util::met2_port(
            0.,
            en.y0 - i as Float * (en.h + 140.),
            5000.,
            en.y1 - i as Float * (en.h + 140.),
        )
    }];
    pub let rbl = tracks[0];
    for route in [(pc0.bl[0], 0), (pc1.bl[0], 0), (pc0.br[0], 1), (pc1.br[0], 1)] {
        let port = route.0;
        let track = tracks[route.1];
        rect(
            "met1.drawing",
            x0=port.x0,
            y0=min_float(port.y0, track.y0),
            x1=port.x1,
            y1=max_float(port.y1, track.y1),
        );
        let crossing = crect(x0=port.x0, y0=track.y0, x1=port.x1, y1=track.y1);
        util::contact(Via::Via1, crossing, crossing, bot_dir=2, top_dir=2);
    }
    pub let bl_in = [pc0.bl[1], pc1.bl[1]];
    pub let br_in = [pc0.br[1], pc1.br[1]];
}

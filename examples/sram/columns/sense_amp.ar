use std::layout::{crect, inst, rect};
use lib::columns::util;
use lib::columns::util::Via;

// The fixed sense amp artwork and its ports.
cell sense_amp_macro() {
    inst(lib::columns::sense_macro::macro_top(), x=0., y=0.);
    pub let inp = crect(x0=100., y0=8400., x1=380., y1=25230.);
    pub let inn = crect(x0=4420., y0=8400., x1=4700., y1=25230.);
    pub let vdd = crect(x0=0., y0=22400., x1=4800., y1=22690.);
    pub let vss = crect(x0=0., y0=9840., x1=4800., y1=10130.);
    pub let clk = crect(x0=0., y0=8400., x1=4800., y1=8690.);
}

// A tap and supply stack under the sense amp's stripe `power`, within the
// span `span` of the tap column.
fn center_pair(span: (Float, Float), power: (Float, Float), ntap: Bool) -> Rect {
    let area = crect(x0=200., y0=span.0 + 200., x1=1100., y1=span.1 - 200.);
    let tap = util::tap_contact(util::grow(area, 0., -170.), (0., 0.), (0., 120.), (0., 80.));
    util::draw_box(
        if ntap { "nsdm.drawing" } else { "psdm.drawing" },
        util::grow(tap.bot, 130., 130.),
    );
    let stripe = util::met2_port(0., power.0, 1300., power.1);
    let m1 = util::contact(Via::Mcon, area, area, top_dir=1).top;
    util::contact(Via::Via1, m1, stripe, longer=true);
    stripe
}

// The 1.3 um tap between sense amps.
cell sense_amp_cent() {
    rect("nwell.drawing", x0=0., y0=17335., x1=1300., y1=25230.);
    center_pair((17560., 25005.), (22400., 22690.), true);
    center_pair((8855., 16735.), (9840., 10130.), false);
    rect("layout_boundary.boundary", x0=0., y0=8385., x1=1300., y1=25230.);
}

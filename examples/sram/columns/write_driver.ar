use std::layout::{bbox, crect, inst, rect, shapes, union};
use lib::params::WriteDriverParams;
use lib::columns::util;
use lib::columns::util::Via;

// A tristate inverter: a two-finger NMOS and a two-finger PMOS mirrored 520 nm
// to its right, sharing the data gate (finger 0); finger 1 is the enable.
cell tristate_inv(p: WriteDriverParams) {
    let nmos = inst(
        util::mos([util::nmos(p.nwidth_driver)], p.length, 2, skip=[(0, 1)]),
        x=0.,
        y=0.,
    );
    let pmos = inst(
        util::mos([util::pmos(p.pwidth_driver)], p.length, 2, skip=[(0, 1)]),
        y=0.,
        reflect=true,
        angle=180,
    );
    eq(pmos.diffs[0].x0, nmos.diffs[0].x1 + 520.);
    rect("poly.drawing", x0=-190., y0=265., x1=pmos.x + 190., h=p.length as Float);
    pub let dout = util::draw_box("li1.drawing", union(nmos.sd[0][2], pmos.sd[0][2]));
    pub let din_n = nmos.gate[0];
    pub let din_p = pmos.gate[0];
    pub let en = nmos.gate[1];
    pub let en_b = pmos.gate[1];
    pub let vss = nmos.sd[0][0];
    pub let vdd = pmos.sd[0][0];
    for port in [din_n, din_p, en, en_b, vss, vdd, dout] {
        util::draw_box("li1.pin", port);
    }
}

// A bitline pair's write driver: a tristate inverter per bitline, turned to
// run up the column 530 nm apart and mirrored, with their enables joined on
// met2, their sources tied to supply stripes, and their outputs to the
// bitline tracks. Met1 x offsets are from the left of the sense amp's 4.8 um
// span, centered between the inverters.
cell write_driver(p: WriteDriverParams) {
    let sa = util::centered(265., 4800.);
    let inv = [
        inst(tristate_inv(p), x=0., y=0., angle=90),
        inst(tristate_inv(p), x=530., y=0., reflect=true, angle=90),
    ];
    for k in std::range(2) {
        let b = bbox(inv[k]);
        let x0 = sa.0 + if k == 0 { 100. } else { 4420. };
        let m1 = util::met1_port(x0, b.y0 + 600., x0 + 280., b.y1);
        let via = util::contact(Via::Mcon, m1, m1, bot_dir=2, top_dir=2, longer=true);
        let out = inv[k].dout;
        rect(
            "li1.drawing",
            x0=min_float(out.x0, via.bot.x0),
            y0=out.y0,
            x1=max_float(out.x1, via.bot.x1),
            y1=out.y1,
        );
    }

    // The enables, joined on met2; en_b then drops 460 nm on a met1 track.
    let ens = [for en_b in [false, true] {
        let ports = [for i in inv { if en_b { i.en_b } else { i.en } }];
        let vias = [for port in ports {
            util::contact(Via::Mcon, port, port, longer=true);
            util::contact(Via::Via1, port, port, longer=true).top
        }];
        let joined = util::draw_box("met2.drawing", union(vias[0], vias[1]));
        if en_b {
            let below = util::cx_i(ports[0]) - 460.;
            let track = util::centered(util::cx_i(joined), 240.);
            let m1 = rect(
                "met1.drawing",
                x0=track.0,
                y0=min_float(joined.y0, below),
                x1=track.1,
                y1=max_float(joined.y1, below),
            );
            util::contact(Via::Via1, m1, joined, longer=true);
            let span = util::centered(below, 320.);
            let via = crect(x0=track.0, y0=span.0, x1=track.1, y1=span.1);
            util::draw_box("met2.pin", util::contact(Via::Via1, via, via, longer=true).top)
        } else {
            util::draw_box("met2.pin", joined)
        }
    }];
    pub let en = ens[0];
    pub let en_b = ens[1];

    // Supply stripes centered on the left inverter's source contacts.
    let stripes = [for vdd in [true, false] {
        let ports = [for i in inv { if vdd { i.vdd } else { i.vss } }];
        let span = util::centered(
            util::cy_i(ports[0]),
            min_float(max_float(ports[0].h - 280., 800.), 3600.),
        );
        let stripe = util::met2_port(sa.0, span.0, sa.1, span.1);
        for port in ports {
            let c = util::contact(Via::Mcon, port, port, top_dir=2, longer=true);
            util::contact(Via::Via1, c.top, stripe, bot_dir=2, longer=true);
        }
        stripe
    }];
    pub let vdd = stripes[0];
    pub let vss = stripes[1];
    util::draw_box("li1.pin", inv[0].din_p);
    util::draw_box("li1.pin", inv[1].din_p);
    pub let din = [inv[1].din_n, inv[0].din_n];

    let top = bbox(inv[0]).y1;
    pub let nsdm = util::draw_box(
        "nsdm.drawing",
        union(shapes(inv[0], "nsdm.drawing")[0], shapes(inv[1], "nsdm.drawing")[0]),
    );
    pub let psdm = util::draw_box(
        "psdm.drawing",
        union(shapes(inv[0], "psdm.drawing")[0], shapes(inv[1], "psdm.drawing")[0]),
    );
    pub let nwell = rect(
        "nwell.drawing",
        x0=sa.0,
        y0=shapes(inv[0], "nwell.drawing")[0].y0,
        x1=sa.1,
        y1=top,
    );
    for x in [520., 4000.] {
        rect("met1.drawing", x0=sa.0 + x, y0=-1415., x1=sa.0 + x + 280., y1=top);
    }
}

// A 1.3 um tap between write drivers: an n-tap in the PMOS implant tied to
// vdd and a p-tap in the NMOS implant tied to vss, their stripes carried
// across.
cell write_driver_cent(p: WriteDriverParams) {
    let wd = inst(write_driver(p), x=0., y=0., construction=true);
    rect("nwell.drawing", x0=0., y0=wd.nwell.y0, x1=1300., y1=wd.nwell.y1);
    rect("layout_boundary.boundary", x0=0., y0=-1415., x1=1300., y1=wd.nwell.y1);
    for side in [(wd.psdm, wd.vdd, "nsdm.drawing"), (wd.nsdm, wd.vss, "psdm.drawing")] {
        let area = crect(x0=200., y0=side.0.y0 + 200., x1=1100., y1=side.0.y1 - 200.);
        util::draw_box(side.2, util::grow(util::tap(area).bot, 130., 130.));
        let stripe = util::met2_port(0., side.1.y0, 1300., side.1.y1);
        let m1 = util::contact(Via::Mcon, area, area, top_dir=1);
        util::contact(Via::Via1, m1.top, stripe, longer=true);
    }
}

use std::layout::{bbox, crect, inst, rect};
use lib::params::ColParams;
use lib::columns::{decoder, dff, diff_latch, mux, precharge, sense_amp, util, write_driver};
use lib::columns::util::Via;

// Heights of a column's blocks: the DFF, latch, and write driver sit at fixed
// heights, and the sense amp, column mux, and precharge stack on the write
// driver.
struct Rows {
    write_top: Float,
    sense: Float,
    mux: Float,
    mux_tap: Float,
    precharge: Float,
    top: Float,
}

fn rows(p: ColParams) -> Rows {
    let write_top = 29325. + bbox(write_driver::write_driver(p.wrdriver)).y1;
    let mux_y = write_top + 16845. + 160.;
    let pc = bbox(precharge::precharge_exact(p.pc));
    let pc_y = mux_y + mux::tgm_group_height(p.mux) - pc.y0;
    Rows {
        write_top,
        sense: write_top + 25230.,
        mux: mux_y,
        mux_tap: mux_y + mux::tgm_group_y_offset(p.mux),
        precharge: pc_y,
        top: pc_y + pc.y1,
    }
}

// The top of the sense amps, where the column decoder's routes may start.
fn column_sense_top(p: ColParams) -> Float { rows(p).write_top + 16845. }

// The 1.3 um taps between columns, with the ends' on the outside edges.
cell column_cent(p: ColParams, end: Bool) {
    let r = rows(p);
    inst(sense_amp::sense_amp_cent(), x=0., y=r.sense, reflect=true);
    inst(write_driver::write_driver_cent(p.wrdriver), x=0., y=29325.);
    inst(diff_latch::diff_latch_cent(), x=0., y=27040.);
    inst(dff::dff_column_cent(), x=0., y=1460.);
    inst(precharge::precharge_tap(p.pc, !end, end), x=0., y=r.precharge);
    inst(mux::tgate_mux_tap(p.mux, end), x=0., y=r.mux_tap);
}

// One word's column: a precharge per bitline pair, alternately mirrored, the
// column mux, and below it the sense amp, write driver, latch, and data DFF,
// with the data and enable routes between them.
cell column(p: ColParams) {
    let r = rows(p);
    let n = p.mux.mux_ratio;
    let ox = ((n - 4) / 2) as Float * 1200.;
    let pcs = [for bit in std::range(n) {
        if bit % 2 == 0 {
            inst(
                precharge::precharge_exact(p.pc),
                x=(bit + 1) as Float * 1200.,
                y=r.precharge,
                reflect=true,
                angle=180,
            )
        } else {
            inst(precharge::precharge_exact(p.pc), x=bit as Float * 1200., y=r.precharge)
        }
    }];
    let m = inst(mux::tgate_mux_group(p.mux), x=0., y=r.mux);
    let sense = inst(sense_amp::sense_amp_macro(), x=ox, y=r.sense, reflect=true);
    let write = inst(write_driver::write_driver(p.wrdriver), x=ox + 2135., y=29325.);
    let latch = inst(diff_latch::diff_latch(), x=ox + 810., y=27040.);
    let dff = inst(dff::dff_column(4), x=ox + 4065., y=1460.);

    // The mux outputs down to the sense amp inputs.
    for pair in [(m.bl_out, sense.inp), (m.br_out, sense.inn)] {
        let sa = pair.1;
        let m1 = rect(
            "met1.drawing",
            x0=sa.x0,
            y0=min_float(sa.y0, pair.0.y0),
            x1=sa.x1,
            y1=max_float(sa.y1, pair.0.y1),
        );
        util::contact(Via::Via1, m1, pair.0);
    }

    // The latch output down to the data output, and the data input up to the
    // DFF.
    let out = latch.dout1;
    let dout_track = (ox + 3400., ox + 3680.);
    let center_track = util::centered(ox + 2400., 280.);
    let jog_y = dff.q.y0 - 600.;
    rect("li1.drawing", x0=out.x0, y0=out.y0 - 470., x1=out.x1, y1=out.y1);
    let jog = rect("li1.drawing", x0=out.x0, y0=out.y0 - 470., x1=center_track.1, y1=out.y0 - 300.);
    let down = rect(
        "met1.drawing",
        x0=center_track.0,
        y0=min_float(jog.y0, jog_y),
        x1=center_track.1,
        y1=max_float(jog.y1, jog_y),
    );
    let jog_span = util::centered(jog_y, 280.);
    rect("met1.drawing", x0=center_track.0, y0=jog_span.0, x1=dout_track.1, y1=jog_span.1);
    util::contact(Via::Mcon, jog, down);
    pub let dout = util::met1_port(dout_track.0, 0., dout_track.1, jog_y);
    pub let din = util::met1_port(
        ox + 2980.,
        min_float(dff.d.y0, 0.),
        ox + 3260.,
        max_float(dff.d.y1, 0.),
    );
    util::contact(Via::Mcon, dff.d, din);

    // The DFF outputs to the write driver data inputs, from contacts on their
    // lower (NMOS-side) access points.
    for route in std::range(2) {
        let li = write.din[route];
        rect("mcon.drawing", x0=li.x0, y0=li.y0 + 80., x1=li.x1, y1=li.y0 + 250.);
        let source = rect(
            "met1.drawing",
            x0=li.x0 - 30.,
            y0=li.y0 - 435.,
            x1=li.x1 + 30.,
            y1=li.y1 - 20.,
        );
        let q = if route == 0 { dff.q } else { dff.q_b };
        let c = if route == 0 { latch.dout2 } else { latch.dout1 };
        let track = util::centered((c.x0 + c.x1) / 2., 280.);
        let m1 = rect(
            "met1.drawing",
            x0=track.0,
            y0=util::hull([latch.dout1, q, source]).y0,
            x1=track.1,
            y1=max_float(max_float(latch.dout1.y1, q.y1), source.y0 + 230.),
        );
        rect(
            "met1.drawing",
            x0=min_float(source.x0, track.0),
            y0=source.y0,
            x1=max_float(source.x1, track.1),
            y1=source.y0 + 230.,
        );
        util::contact(Via::Mcon, q, m1);
    }

    // The write enables, out to met1 pins beside the DFF.
    let ens = [for route in [(write.en, ox + 70.), (write.en_b, ox + 4450.)] {
        let en = route.0;
        let m1 = util::met1_port(
            route.1,
            min_float(en.y0, 0.),
            route.1 + 280.,
            max_float(en.y1, 0.),
        );
        let m2 = rect(
            "met2.drawing",
            x0=min_float(route.1, en.x0),
            y0=en.y0,
            x1=max_float(route.1 + 280., en.x1),
            y1=en.y1,
        );
        util::contact(Via::Via1, m1, m2);
        m1
    }];
    pub let we = ens[0];
    pub let we_b = ens[1];

    let hspan = if n == 4 { (-650., n as Float * 1200. + 650.) } else { (0., n as Float * 1200.) };
    for span in [
        (r.write_top, r.write_top + 7895.),
        (29665. + p.wrdriver.nwidth_driver as Float, r.write_top),
        (24740., 26100.),
        (19850., 21210.),
        (16840., 18200.),
    ] {
        rect("nwell.drawing", x0=hspan.0, y0=span.0, x1=hspan.1, y1=span.1);
    }
    // The supply stripes the column peripherals extend across the row.
    pub let vdd = std::concat([dff.vdd, write.vdd, sense.vdd, pcs[0].vdd, m.vdd], latch.vdd);
    pub let vss = std::concat([dff.vss, write.vss, sense.vss, m.vss], latch.vss);
    pub let latch_vdd = latch.vdd;
    pub let latch_vss = latch.vss;
    pub let en_b = pcs[0].en_b;
    pub let sense_clk = sense.clk;
}

// Routes a column's data port `port` down past the write-mask decoder, whose
// bottom is at `bottom`, to a met1 pin there.
fn data_port(port: Rect, bottom: Float, we: Rect) -> Rect {
    let out = util::centered(util::cx_i(port), 140.);
    let top = (we.y0 + we.y1) / 2. - 2000.;
    let m2 = rect(
        "met2.drawing",
        x0=port.x0,
        y0=min_float(port.y0 + 300., top - 300.),
        x1=port.x1,
        y1=max_float(port.y0 + 300., top - 300.),
    );
    let pin = util::met1_port(out.0, bottom, out.1, top);
    util::contact(Via::Via1, port, m2, longer=true);
    util::contact(Via::Via1, pin, m2, longer=true);
    pin
}

// Joins an output's folds `folds` on li1 above them and contacts the join
// from met1. Returns the contact's met1.
fn join_folds(folds: [Rect]) -> Rect {
    let src = folds[0];
    let top = src.y1 + src.w + 170.;
    let right = std::last(folds).x1;
    rect("li1.drawing", x0=src.x0, y0=src.y0, x1=src.x1, y1=top);
    let bar = rect(
        "li1.drawing",
        x0=min_float(src.x0, right),
        y0=src.y1 + 170.,
        x1=max_float(src.x1, right),
        y1=top,
    );
    let wide = bar.w >= 530. && bar.w > bar.h;
    util::contact(Via::Mcon, bar, bar, top_dir=if wide { 0 } else { 1 }, longer=true).top
}

// A row of columns between taps, the write-mask decoder below them, and the
// routes and rails across the row.
cell column_peripherals_exact(p: ColParams) {
    let n = p.mux.mux_ratio;
    let gran = p.wmask_granularity;
    let words = p.cols / n;
    let bits = words / gran;
    let rw = util::row_w(p.cols, n);
    let r = rows(p);
    inst(column_cent(p, true), x=0., y=0.);
    let cols = [for g in std::range(words) { inst(column(p), x=util::word_x(g, n), y=0.) }];
    for g in std::range(words - 1) {
        inst(column_cent(p, false), x=util::word_x(g, n) + util::column_w(n), y=0.);
    }
    inst(column_cent(p, true), x=rw, y=0., reflect=true, angle=180);
    let wm = inst(decoder::wmask_peripherals(p.cols, n, gran, p.wmask_decoder), x=650.);
    eq(bbox(wm).y1, -300.);

    // Each write-mask bit's enables, from its decoder's outputs to the write
    // drivers of the columns it masks.
    for bit in std::range(bits) {
        for port in wm.outputs[bit] {
            rect("li1.drawing", x0=port.x0, y0=port.y0, x1=port.x1, y1=port.y1 + 170.);
        }
        let we = join_folds(wm.outputs[bit]);
        let we_b = join_folds(wm.outputs_b[bit]);
        for k in std::range(gran) if bit * gran + k < words {
            let c = cols[bit * gran + k];
            let m1 = rect(
                "met1.drawing",
                x0=min_float(we.x0, c.we.x0),
                y0=we.y0,
                x1=max_float(we.x1, c.we.x1),
                y1=we.y1,
            );
            rect(
                "met1.drawing",
                x0=c.we.x0,
                y0=min_float(c.we.y0, m1.y0),
                x1=c.we.x1,
                y1=max_float(c.we.y0 + 300., m1.y1),
            );
            let m1b = rect(
                "met1.drawing",
                x0=min_float(we_b.x0, c.we_b.x0),
                y0=we_b.y0,
                x1=max_float(we_b.x1, c.we_b.x1),
                y1=we_b.y1,
            );
            let m2 = rect(
                "met2.drawing",
                x0=c.we_b.x0,
                y0=min_float(c.we_b.y0, m1b.y0),
                x1=c.we_b.x1,
                y1=max_float(c.we_b.y0 + 300., m1b.y1),
            );
            util::contact(Via::Via1, m1b, m2, longer=true);
            util::contact(Via::Via1, c.we_b, m2, longer=true);
        }
    }

    pub let din = [for c in cols { data_port(c.din, wm.y, wm.we) }];
    pub let dout = [for c in cols { data_port(c.dout, wm.y, wm.we) }];
    pub let wmask = [for b in std::range(bits) {
        let d = wm.d[b];
        let x = cols[b * gran].din.x0;
        let pin = util::met1_port(x - 280., min_float(d.y0, wm.y), x - 140., max_float(d.y1, wm.y));
        util::contact(Via::Mcon, d, pin);
        pin
    }];

    // Supply rails across the row: the write-mask decoder's met1 straps and
    // met2 stripes, and each block's met2 stripes, with the latch taps'
    // stripes again bottom up.
    let c0 = cols[0];
    let rails = [for vdd in [true, false] {
        let straps = if vdd { wm.vdd_straps } else { wm.vss_straps };
        let stripes = if vdd { c0.vdd } else { c0.vss };
        let taps = if vdd {
            [for i in [2, 1, 0] { c0.latch_vdd[i] }]
        } else {
            [for i in [3, 2, 0, 1] { c0.latch_vss[i] }]
        };
        let wm_stripe = if vdd { wm.vdd } else { wm.vss };
        (
            [for s in straps { crect(x0=0., y0=s.y0, x1=rw, y1=s.y1) }],
            [for s in cons(wm_stripe, std::concat(stripes, taps)) {
                util::met2_port(0., s.y0, rw, s.y1)
            }],
        )
    }];
    for s in std::concat(rails[0].0, rails[1].0) {
        util::draw_box("met1.drawing", s);
        util::draw_box("met1.pin", s);
    }
    pub let vdd = rails[0].1;
    pub let vss = rails[1].1;
    // Supply port shapes: the write-mask decoder's met1 straps and the
    // full-width met2 rails, each rail once.
    pub let vdd_pins_m1 = util::coalesce_rects(rails[0].0);
    pub let vss_pins_m1 = util::coalesce_rects(rails[1].0);
    pub let vdd_pins_m2 = util::coalesce_rects(vdd);
    pub let vss_pins_m2 = util::coalesce_rects(vss);
    pub let pc_b = [for s in c0.en_b { util::met2_port(0., s.y0, rw, s.y1) }];
    pub let precharge_en = pc_b;
    pub let sense_en = [
        crect(x0=0., y0=30665., x1=rw, y1=30955.),
        util::met2_port(0., c0.sense_clk.y0, rw, c0.sense_clk.y1),
    ];
    pub let clk = [util::met2_port(0., 8175., rw, 8495.), wm.clk];
    pub let rstb = [util::met2_port(0., 3940., rw, 4260.), wm.rstb];
    pub let we = wm.we;
    pub let write_en = we;
    let mux_tap = inst(mux::tgate_mux_tap(p.mux, true), x=0., y=r.mux_tap, construction=true);
    pub let sel = [for s in mux_tap.sel { crect(x0=0., y0=s.y0, x1=rw, y1=s.y1) }];
    pub let sel_b = [for s in mux_tap.sel_b { crect(x0=0., y0=s.y0, x1=rw, y1=s.y1) }];
    // Bitline landing pads on the top edge. Columns alternate in orientation,
    // so the pads swap sides on odd columns.
    pub let bl = pads(p, r.top, false);
    pub let br = pads(p, r.top, true);
}

fn pads(p: ColParams, top: Float, right: Bool) -> [Rect] {
    let n = p.mux.mux_ratio;
    [for i in std::range(p.cols) {
        let x = util::bit_x(i, n) + if ((i % n) % 2 == 0) == right { 715. } else { 345. };
        crect(x0=x, y0=top - 140., x1=x + 140., y1=top)
    }]
}

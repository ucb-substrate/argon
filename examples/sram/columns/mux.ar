use std::layout::{bbox, crect, inst, rect};
use lib::params::TGateMuxParams;
use lib::columns::util;
use lib::columns::util::{Contact, Via};

// A drain tied to a met2 stripe through an edge track: its li1-met1 and
// met1-met2 contacts and the stripe.
struct Split {
    li: Contact,
    m2: Contact,
    stripe: Rect,
}

// Ties drain `sd` to a new met2 stripe through the edge track `track`, which
// is doubled across the column edge at x = `x`.
fn split(sd: Rect, track: Rect, x: Float) -> Split {
    let doubled = crect(x0=x - 140., y0=track.y0, x1=x + 140., y1=track.y1);
    let li = util::contact(
        Via::Mcon,
        crect(x0=x, y0=sd.y0, x1=x, y1=sd.y1),
        util::grow(doubled, 0., -80.),
        top_dir=2,
        longer=true,
        clip=1200.,
    );
    util::trim(
        "li1.drawing",
        crect(x0=min_float(sd.x0, li.bbox.x0), y0=sd.y0, x1=max_float(sd.x1, li.bbox.x1), y1=sd.y1),
        1200.,
    );
    let stripe = crect(x0=-1200., y0=util::snap5(util::cy_i(li.bbox) - 300.), x1=2400., h=600.);
    let m2 = util::contact(Via::Via1, doubled, stripe, longer=true, clip=1200.);
    util::trim("met2.drawing", stripe, 1200.);
    Split { li, m2, stripe }
}

// The supply stripe between split stripes `lo` and `hi`: their gap less
// 300 nm on each side, at most 1.8 um tall and centered.
fn supply(lo: Rect, hi: Rect) -> Rect {
    let y0 = lo.y1 + 300.;
    let y1 = hi.y0 - 300.;
    if y1 - y0 > 1800. {
        crect(x0=-1200., y0=util::snap5((y0 + y1) / 2. - 900.), x1=2400., h=1800.)
    } else {
        crect(x0=-1200., y0=y0, x1=2400., y1=y1)
    }
}

// One transmission gate of the column mux, in a 1.2 um column: a PMOS pair
// above the complement selects and an NMOS pair below the true selects, both
// turned to run up the column. Bitlines enter on the middle in tracks; the
// out tracks carry them on, and the edge tracks tie the drains to the met2
// output stripes. Select stripe `idx` drives the gates.
cell tgate_mux_unit(p: TGateMuxParams, idx: Int) {
    let w = 1200.;
    let mux = p.mux_ratio;
    let sw = p.sel_width as Float;
    let space = max_float(sw / 4., 140.);
    let pmos = inst(util::mos([util::pmos(p.pwidth), util::pmos(p.pwidth)], p.length, 1), angle=90);
    let nmos = inst(
        util::mos([util::nmos(p.nwidth), util::nmos(p.nwidth)], p.length, 1),
        angle=270,
    );
    let pb = bbox(pmos);
    let nb = bbox(nmos);
    eq(pb.x0 + pb.x1, w);
    eq(pb.y0, 0.);
    eq(nb.x0 + nb.x1, w);
    eq(nb.y0, pb.y1 + 400.);
    let psd = pmos.sd;
    let nsd = nmos.sd;
    let ins = util::in_tracks();
    let outs = util::out_tracks();
    let in_top = nb.y1 - 600.;
    let bot = -(sw + space) * mux as Float;
    let top = nb.y1 + (sw + space) * mux as Float + max_float(170. - space, 0.);
    let out_top = util::jog(in_top, [ins[1], ins[2]], [outs[0], outs[2]]);
    for i in [0, 2] {
        rect("met1.drawing", x0=outs[i].0, y0=out_top, x1=outs[i].1, y1=top);
    }
    let tr0 = crect(x0=0., y0=bot, x1=140., y1=in_top);
    let tr3 = crect(x0=1060., y0=bot, x1=w, y1=in_top);
    pub let bl = rect("met1.drawing", x0=ins[1].0, y0=600., x1=ins[1].1, y1=in_top);
    pub let br = rect("met1.drawing", x0=ins[2].0, y0=600., x1=ins[2].1, y1=in_top);
    util::draw_box("met1.pin", bl);
    util::draw_box("met1.pin", br);
    for pair in [(br, nsd[1][1]), (bl, nsd[0][0]), (bl, psd[1][1]), (br, psd[0][0])] {
        util::contact(Via::Mcon, pair.0, pair.1, top_dir=2, longer=true, clip=w);
    }
    pub let splits = [
        split(psd[1][0], tr3, w),
        split(psd[0][1], tr0, 0.),
        split(nsd[0][1], tr3, w),
        split(nsd[1][0], tr0, 0.),
    ];
    pub let bl_out = util::trim("met2.drawing", splits[0].stripe, w);
    pub let br_out = util::trim("met2.drawing", splits[1].stripe, w);
    util::trim("met2.pin", splits[0].stripe, w);
    util::trim("met2.pin", splits[1].stripe, w);
    pub let vdd = util::trim("met2.drawing", supply(splits[1].stripe, splits[0].stripe), w);
    pub let vss = util::trim("met2.drawing", supply(splits[3].stripe, splits[2].stripe), w);

    // Complement selects below the PMOS and true selects above the NMOS.
    pub let sel_b = [for bit in std::range(mux) {
        select(-(sw + space) * bit as Float - sw, sw, bit == idx, pmos.gate[0])
    }];
    pub let sel = [for bit in std::range(mux) {
        select(nb.y1 + (sw + space) * bit as Float, sw, bit == idx, nmos.gate[0])
    }];

    pub let nwell = rect("nwell.drawing", x0=0., y0=pb.y0, x1=w, y1=pb.y1);
    for layer in ["psdm.drawing", "nsdm.drawing"] {
        for s in std::concat(std::layout::shapes(pmos, layer), std::layout::shapes(nmos, layer)) {
            rect(layer, x0=0., y0=s.y0, x1=w, y1=s.y1);
        }
    }
    pub let outline = rect(
        "layout_boundary.boundary",
        x0=0.,
        y0=-(sw + space) * (mux - 1) as Float - sw - 1000.,
        x1=w,
        y1=top,
    );
}

// A select stripe at `y`, contacted to `gate` through the middle out track
// when `on`.
fn select(y: Float, sw: Float, on: Bool, gate: Rect) -> Rect {
    let stripe = crect(x0=-1200., y0=y, x1=2400., h=sw);
    util::trim("met2.pin", stripe, 1200.);
    if on {
        let conn = crect(
            x0=gate.x0,
            y0=min_float(gate.y0, y),
            x1=gate.x1,
            y1=max_float(gate.y1, y + sw),
        );
        let track = util::out_tracks()[1];
        let via = crect(x0=track.0, y0=y, x1=track.1, h=sw);
        util::contact(Via::Via1, via, stripe, longer=true, clip=1200.);
        util::contact(Via::Mcon, conn, via, longer=true, clip=1200.);
        util::trim("li1.drawing", conn, 1200.);
    }
    util::trim("met2.drawing", stripe, 1200.)
}

// Draws `c` moved right by `dx` in a 1.3 um tap.
fn draw_tap(c: Contact, dx: Float) {
    util::draw_contact(util::moved(c, dx), clip=1300.);
}

// A tap and supply stack centered in `area`, tied to `stripe`.
fn tap_stack(area: Rect, stripe: Rect, ptap: Bool) {
    let tap = util::tap_contact(area, (0., 120.), (0., 120.), (80., 0.));
    if ptap {
        util::draw_box("psdm.drawing", util::grow(tap.bot, 130., 130.));
    }
    let m1 = util::contact(Via::Mcon, tap.top, tap.top, top_dir=1);
    util::contact(Via::Via1, m1.top, stripe);
}

// A 1.3 um tap between mux units: well and substrate taps tied to the supply
// stripes, the units' stripes carried across, and the left neighbor's edge
// splits repeated on its right edge (and the right neighbor's on its left
// edge, unless `end`).
cell tgate_mux_tap(p: TGateMuxParams, end: Bool) {
    let w = 1300.;
    let u = inst(tgate_mux_unit(p, 0), x=0., y=0., construction=true);
    for s in [u.splits[1], u.splits[3]] {
        draw_tap(s.li, w);
        draw_tap(s.m2, w);
        if !end {
            draw_tap(s.li, 0.);
            draw_tap(s.m2, 0.);
        }
    }
    for s in std::concat(u.sel_b, u.sel) {
        util::met2_port(0., s.y0, w, s.y1);
    }
    let vdd = util::met2_port(0., u.vdd.y0, w, u.vdd.y1);
    let vss = util::met2_port(0., u.vss.y0, w, u.vss.y1);
    let ntap = crect(x0=0., y0=u.nwell.y0, x1=w, y1=u.nwell.y1);
    tap_stack(util::grow(ntap, -300., -300.), vdd, false);
    tap_stack(crect(x0=300., y0=ntap.y1 + 600., x1=w - 300., y1=u.outline.y1 - 600.), vss, true);
    for s in u.splits {
        if !end {
            rect("met2.drawing", x0=0., y0=s.stripe.y0, x1=200., y1=s.stripe.y1);
        }
        rect("met2.drawing", x0=w - 200., y0=s.stripe.y0, x1=w, y1=s.stripe.y1);
    }
    util::draw_box("nwell.drawing", ntap);
    util::draw_box("nsdm.drawing", ntap);
    pub let outline = rect(
        "layout_boundary.boundary",
        x0=0.,
        y0=u.outline.y0,
        x1=w,
        y1=u.outline.y1,
    );
    pub let sel = u.sel;
    pub let sel_b = u.sel_b;
    pub let supplies = [u.vdd, u.vss];
}

// A column's mux: one unit per bit, alternately mirrored, and the met2
// outputs both bitline pairs share.
cell tgate_mux_group(p: TGateMuxParams) {
    let mux = p.mux_ratio;
    let width = mux as Float * 1200.;
    let y0 = -bbox(tgate_mux_unit(p, 0)).y0;
    let units = [for bit in std::range(mux) {
        if bit % 2 == 0 {
            inst(tgate_mux_unit(p, bit), x=bit as Float * 1200., y=y0)
        } else {
            inst(
                tgate_mux_unit(p, bit),
                x=(bit + 1) as Float * 1200.,
                y=y0,
                reflect=true,
                angle=180,
            )
        }
    }];
    let u = units[0];
    pub let br_out = util::met2_port(0., 500., width, 820.);
    pub let bl_out = util::met2_port(0., 0., width, 320.);
    for out in [(mux / 2, br_out), (mux / 2 + 1, bl_out)] {
        let x = out.0 as Float * 1200.;
        let m1 = rect("met1.drawing", x0=x - 140., y0=0., x1=x + 140., y1=u.bl.y1);
        util::contact(Via::Via1, m1, out.1, longer=true);
    }
    for s in std::concat(u.sel_b, u.sel) {
        rect("met2.pin", x0=0., y0=s.y0, x1=width, y1=s.y1);
    }
    pub let vdd = u.vdd;
    pub let vss = u.vss;
}

fn tgm_group_y_offset(p: TGateMuxParams) -> Float {
    -bbox(tgate_mux_unit(p, 0)).y0
}

fn tgm_group_height(p: TGateMuxParams) -> Float {
    bbox(tgate_mux_unit(p, 0)).h
}

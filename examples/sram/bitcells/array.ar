// SRAM22 uses a four-row body-contact pitch and a mux-ratio-wide column tile.
// The fixed dimensions below are the published Sky130 SRAM macro boundaries.

use std::layout::{crect, inst};
use lib::bitcells::macros;

fn bitcell_width() -> Float { 1200. }
fn bitcell_height() -> Float { 1580. }
fn rowend_width() -> Float { 1300. }
fn colend_height() -> Float { 2055. }
fn hstrap_rows() -> Int { 4 }

fn array_group_width(mux_ratio: Int) -> Float {
    rowend_width() + mux_ratio as Float * bitcell_width()
}

fn array_center_height() -> Float {
    (hstrap_rows() + 1) as Float * bitcell_height()
}

fn array_bottom_height() -> Float {
    colend_height() + 2. * bitcell_height()
}

fn array_top_height() -> Float {
    bitcell_height() + colend_height()
}

fn array_width(cols: Int, mux_ratio: Int) -> Float {
    2. * rowend_width() + bitcell_width() + (cols / mux_ratio) as Float * array_group_width(mux_ratio)
}

fn array_height(rows: Int) -> Float {
    array_bottom_height() + (rows / hstrap_rows()) as Float * array_center_height() + array_top_height()
}

fn bitcell_pair_x(pair: Int) -> Float {
    rowend_width() + 2. * bitcell_width() * pair as Float
}

fn bitcell_pair_right_x(pair: Int) -> Float {
    rowend_width() + 2. * bitcell_width() * (pair + 1) as Float
}

fn boundary_pair_x(pair: Int) -> Float {
    rowend_width() + bitcell_width() + 2. * bitcell_width() * pair as Float
}

fn draw_regular_row(mux_ratio: Int, y: Float) -> Rect {
    inst(macros::sp_wlstrap(), x=0., y=y);
    for pair in std::range(mux_ratio / 2) {
        inst(macros::sp_cell(), x=bitcell_pair_x(pair), y=y, reflect=true, angle=180);
        inst(macros::sp_cell(), x=bitcell_pair_right_x(pair), y=y);
    }
    crect(x0=0., y0=y - bitcell_height(), x1=array_group_width(mux_ratio), y1=y)
}

fn draw_alternate_row(mux_ratio: Int, y: Float) -> Rect {
    inst(macros::sp_wlstrap_a(), x=0., y=y, reflect=true);
    for pair in std::range(mux_ratio / 2) {
        inst(macros::sp_cell_a(), x=bitcell_pair_x(pair), y=y, angle=180);
        inst(macros::sp_cell_a(), x=bitcell_pair_right_x(pair), y=y, reflect=true);
    }
    crect(x0=0., y0=y - bitcell_height(), x1=array_group_width(mux_ratio), y1=y)
}

fn draw_hstrap_row(mux_ratio: Int, y: Float) -> Rect {
    inst(macros::sp_horiz_wlstrap(), x=0., y=y);
    for pair in std::range(mux_ratio / 2) {
        inst(macros::sp_hstrap(), x=boundary_pair_x(pair), y=y);
        inst(macros::sp_hstrap(), x=boundary_pair_x(pair), y=y, reflect=true, angle=180);
    }
    crect(x0=0., y0=y - bitcell_height(), x1=array_group_width(mux_ratio), y1=y)
}

cell array_center(mux_ratio: Int) {
    for pair in std::range(hstrap_rows() / 2) {
        let y = bitcell_height() + 2. * bitcell_height() * pair as Float;
        draw_alternate_row(mux_ratio, y);
        draw_regular_row(mux_ratio, y);
    }
    draw_hstrap_row(mux_ratio, array_center_height());
}

cell array_bottom(mux_ratio: Int) {
    let row_y = colend_height();
    draw_alternate_row(mux_ratio, row_y);
    inst(macros::sp_colend_a_p_cent(), x=0., y=row_y, reflect=true);
    for pair in std::range(mux_ratio / 2) {
        inst(macros::sp_colend_a(), x=boundary_pair_x(pair), y=row_y, angle=180);
        inst(macros::sp_colend_a(), x=boundary_pair_x(pair), y=row_y, reflect=true);
    }
    draw_hstrap_row(mux_ratio, array_bottom_height());
}

cell array_top(mux_ratio: Int) {
    let row_y = bitcell_height();
    inst(macros::sp_colend_p_cent(), x=0., y=row_y);
    for pair in std::range(mux_ratio / 2) {
        inst(macros::sp_colend(), x=boundary_pair_x(pair), y=row_y, reflect=true, angle=180);
        inst(macros::sp_colend(), x=boundary_pair_x(pair), y=row_y);
    }
    draw_regular_row(mux_ratio, row_y);
}

cell array_left() {
    for pair in std::range(hstrap_rows() / 2) {
        let y = bitcell_height() + 2. * bitcell_height() * pair as Float;
        inst(macros::sp_rowend_a(), x=rowend_width(), y=y, reflect=true);
        inst(macros::sp_cell_a(), x=rowend_width() + bitcell_width(), y=y, reflect=true);
        let end = inst(macros::sp_rowend(), x=rowend_width(), y=y);
        inst(macros::sp_cell(), x=rowend_width() + bitcell_width(), y=y);
    }
    let strap_y = array_center_height();
    let end = inst(
        macros::sp_rowend_hstrap(),
        x=rowend_width(),
        y=strap_y - bitcell_height(),
        reflect=true,
    );
    inst(macros::sp_hstrap(), x=rowend_width(), y=strap_y, reflect=true, angle=180);
}

cell array_right() {
    for pair in std::range(hstrap_rows() / 2) {
        let y = bitcell_height() + 2. * bitcell_height() * pair as Float;
        inst(macros::sp_wlstrap_a(), x=0., y=y, reflect=true);
        inst(macros::sp_cell_a(), x=rowend_width(), y=y, angle=180);
        inst(macros::sp_rowend_a(), x=2. * rowend_width() - 100., y=y, angle=180);
        let wl = inst(macros::sp_wlstrap(), x=0., y=y);
        inst(macros::sp_cell(), x=rowend_width(), y=y, reflect=true, angle=180);
        let end = inst(
            macros::sp_rowend(),
            x=2. * rowend_width() - 100.,
            y=y,
            reflect=true,
            angle=180,
        );
    }
    let strap_y = array_center_height();
    let wl = inst(macros::sp_horiz_wlstrap(), x=0., y=strap_y);
    inst(macros::sp_hstrap(), x=2. * rowend_width() - 100., y=strap_y);
    let end = inst(
        macros::sp_rowend_hstrap(),
        x=2. * rowend_width() - 100.,
        y=strap_y - bitcell_height(),
        angle=180,
    );
}

cell corner_ul() {
    inst(macros::sp_corner(), x=rowend_width(), y=bitcell_height());
    inst(macros::sp_colend(), x=rowend_width(), y=bitcell_height());
    inst(macros::sp_rowend(), x=rowend_width(), y=bitcell_height());
    inst(macros::sp_cell(), x=rowend_width() + bitcell_width(), y=bitcell_height());
}

cell corner_ur() {
    inst(macros::sp_colend_p_cent(), x=0., y=bitcell_height());
    inst(
        macros::sp_colend(),
        x=rowend_width() + bitcell_width(),
        y=bitcell_height(),
        reflect=true,
        angle=180,
    );
    inst(
        macros::sp_corner(),
        x=rowend_width() + bitcell_width(),
        y=bitcell_height(),
        reflect=true,
        angle=180,
    );
    inst(macros::sp_wlstrap(), x=0., y=bitcell_height());
    inst(macros::sp_cell(), x=rowend_width(), y=bitcell_height(), reflect=true, angle=180);
    inst(
        macros::sp_rowend(),
        x=rowend_width() + bitcell_width(),
        y=bitcell_height(),
        reflect=true,
        angle=180,
    );
}

cell corner_ll() {
    inst(
        macros::sp_rowend_hstrap(),
        x=rowend_width(),
        y=array_bottom_height() - bitcell_height(),
        reflect=true,
    );
    inst(macros::sp_hstrap(), x=rowend_width(), y=array_bottom_height(), reflect=true, angle=180);
    inst(macros::sp_rowend_a(), x=rowend_width(), y=colend_height(), reflect=true);
    inst(macros::sp_cell_a(), x=rowend_width() + bitcell_width(), y=colend_height(), reflect=true);
    inst(macros::sp_corner_a(), x=rowend_width(), y=colend_height(), reflect=true);
    inst(macros::sp_colend_a(), x=rowend_width(), y=colend_height(), reflect=true);
}

cell corner_lr() {
    let strap_y = array_bottom_height();
    inst(macros::sp_horiz_wlstrap(), x=0., y=strap_y);
    inst(macros::sp_hstrap(), x=rowend_width() + bitcell_width(), y=strap_y);
    inst(
        macros::sp_rowend_hstrap(),
        x=rowend_width() + bitcell_width(),
        y=strap_y - bitcell_height(),
        angle=180,
    );
    inst(macros::sp_wlstrap_a(), x=0., y=colend_height(), reflect=true);
    inst(macros::sp_cell_a(), x=rowend_width(), y=colend_height(), angle=180);
    inst(macros::sp_rowend_a(), x=rowend_width() + bitcell_width(), y=colend_height(), angle=180);
    inst(macros::sp_colend_a_p_cent(), x=0., y=colend_height(), reflect=true);
    inst(macros::sp_colend_a(), x=rowend_width() + bitcell_width(), y=colend_height(), angle=180);
    inst(macros::sp_corner_a(), x=rowend_width() + bitcell_width(), y=colend_height(), angle=180);
}

cell sp_cell_array(rows: Int, cols: Int, mux_ratio: Int) {
    let groups = cols / mux_ratio;
    let row_groups = rows / hstrap_rows();
    let left_width = rowend_width() + bitcell_width();
    let group_width = array_group_width(mux_ratio);
    let bottom_height = array_bottom_height();
    let center_height = array_center_height();

    inst(corner_ll(), x=0., y=0.);
    for col in std::range(groups) {
        let bottom = inst(array_bottom(mux_ratio), x=left_width + col as Float * group_width, y=0.);
    }
    inst(corner_lr(), x=left_width + groups as Float * group_width, y=0.);

    for row in std::range(row_groups) {
        let y = bottom_height + row as Float * center_height;
        let left = inst(array_left(), x=0., y=y);
        for col in std::range(groups) {
            inst(array_center(mux_ratio), x=left_width + col as Float * group_width, y=y);
        }
        let right = inst(array_right(), x=left_width + groups as Float * group_width, y=y);
    }

    let top_y = bottom_height + row_groups as Float * center_height;
    inst(corner_ul(), x=0., y=top_y);
    for col in std::range(groups) {
        let top = inst(array_top(mux_ratio), x=left_width + col as Float * group_width, y=top_y);
    }
    inst(corner_ur(), x=left_width + groups as Float * group_width, y=top_y);
    crect(x0=0., y0=0., x1=array_width(cols, mux_ratio), y1=array_height(rows));
    pub let bl = array_bitline_ports(cols, mux_ratio, false);
    pub let br = array_bitline_ports(cols, mux_ratio, true);
    pub let wl = array_wordline_ports(rows);
    let right_edge = left_width + groups as Float * group_width + 2. * rowend_width() + bitcell_width();
    pub let vdd_rails = array_power_rails(right_edge, row_groups, true);
    pub let vss_rails = array_power_rails(right_edge, row_groups, false);
    // Supply pins: met1 pads on the top and bottom edges, met2 rails on the left
    // and right edges. Dummy bitlines count as vdd and dummy wordlines as vss.
    let height = top_y + array_top_height();
    pub let vdd_pins_m1 = mirror_pads(array_edge_pads(groups, mux_ratio, true), height);
    pub let vss_pins_m1 = mirror_pads(array_edge_pads(groups, mux_ratio, false), height);
    pub let vdd_pins_m2 = std::concat(
        array_power_rails(rowend_width(), row_groups, true),
        vdd_rails,
    );
    pub let vss_pins_m2 = std::flatten([
        array_power_rails(rowend_width(), row_groups, false),
        vss_rails,
        dummy_wordline_rails(top_y, 0., rowend_width()),
        dummy_wordline_rails(top_y, right_edge - rowend_width(), right_edge),
    ]);
}

// Bitline landing pads on the bottom edge of the array. Bitcells alternate in
// orientation, so the pads swap sides on odd columns.
fn array_bitline_port(idx: Int, mux_ratio: Int, right: Bool) -> Rect {
    let group = idx / mux_ratio;
    let bit = idx % mux_ratio;
    let cell_x = rowend_width() + bitcell_width() + group as Float * array_group_width(mux_ratio) + rowend_width() + bit as Float * bitcell_width();
    let offset = if bit % 2 == 0 {
        if right { 715. } else { 350. }
    } else {
        if right { 345. } else { 710. }
    };
    crect(x0=cell_x + offset, y0=1650., x1=cell_x + offset + 140., y1=1780.)
}

fn array_bitline_ports(cols: Int, mux_ratio: Int, right: Bool) -> [Rect] {
    [for i in std::range(cols) { array_bitline_port(i, mux_ratio, right) }]
}

// Wordline pads on the left edge, numbered from the top row down. Each strap
// group holds four rows around its horizontal strap.
fn array_wordline_port(idx: Int, rows: Int) -> Rect {
    let group = idx / hstrap_rows();
    let row = idx % hstrap_rows();
    let row_offset = if row == 0 {
        0.
    } else if row == 1 {
        -760.
    } else if row == 2 {
        -3160.
    } else {
        -3920.
    };
    let y = array_bottom_height() + ((rows / hstrap_rows()) - 1 - group) as Float * array_center_height() + 5035. + row_offset;
    crect(x0=0., y0=y, x1=rowend_width(), y1=y + 170.)
}

fn array_wordline_ports(rows: Int) -> [Rect] {
    [for i in std::range(rows) { array_wordline_port(i, rows) }]
}

// M2 supply rails where they leave the right edge of the array, top down, as
// (bottom, top) offsets. Well-tie rails count with the supply they tie to.
fn array_top_rail_spans(vdd: Bool) -> [(Float, Float)] {
    if vdd {
        [(2760., 3040.,), (2160., 2610.,), (295., 555.,)]
    } else {
        [(3180., 3635.,), (1600., 1985.,), (725., 945.,)]
    }
}

fn array_bottom_rail_spans(vdd: Bool) -> [(Float, Float)] {
    if vdd { [(1025., 1475.,), (595., 875.,)] } else { [(1650., 2035.,), (0., 455.,)] }
}

// Rails of one strap group relative to its well-tie rail. These also exist
// below the lowest group.
fn array_strap_rail_spans(vdd: Bool) -> [(Float, Float)] {
    if vdd {
        [(-820., -560.,), (-1670., -1410.,)]
    } else {
        [(0., 170.,), (-390., -170.,), (-2060., -1840.,)]
    }
}

fn array_row_rail_spans(vdd: Bool) -> [(Float, Float)] {
    if vdd {
        [(-3980., -3720.,), (-4830., -4570.,), (-7140., -6880.,)]
    } else {
        [(-3550., -3330.,), (-5220., -5000.,), (-6710., -6490.,)]
    }
}

fn spans_to_rails(spans: [(Float, Float)], dy: Float, x0: Float, x1: Float) -> [Rect] {
    [for s in spans { crect(x0=x0, y0=s.0 + dy, x1=x1, y1=s.1 + dy) }]
}

fn array_group_rails(row_groups: Int, x0: Float, x1: Float, vdd: Bool) -> [Rect] {
    std::flatten([for k in std::range(row_groups + 1) {
        let well = array_bottom_height() - 465. + (row_groups - k) as Float * array_center_height();
        let strap = spans_to_rails(array_strap_rail_spans(vdd), well, x0, x1);
        let rows = if k < row_groups {
            spans_to_rails(array_row_rail_spans(vdd), well, x0, x1)
        } else {
            []
        };
        std::concat(strap, rows)
    }])
}

fn array_power_rails(right_edge: Float, row_groups: Int, vdd: Bool) -> [Rect] {
    let x0 = right_edge - rowend_width();
    let top_y = array_bottom_height() + row_groups as Float * array_center_height();
    std::concat(
        spans_to_rails(array_top_rail_spans(vdd), top_y, x0, right_edge),
        std::concat(
            array_group_rails(row_groups, x0, right_edge, vdd),
            spans_to_rails(array_bottom_rail_spans(vdd), 0., x0, right_edge),
        ),
    )
}

// M2 rails of the two dummy wordlines, near the bottom and top of the array.
fn dummy_wordline_rails(top_y: Float, x0: Float, x1: Float) -> [Rect] {
    [
        crect(x0=x0, y0=2350., x1=x1, y1=2520.),
        crect(x0=x0, y0=top_y + 1115., x1=x1, y1=top_y + 1285.),
    ]
}

// Left edge of a column group's wordline strap; group `groups` is the right corner.
fn array_group_x(group: Int, mux_ratio: Int) -> Float {
    rowend_width() + bitcell_width() + group as Float * array_group_width(mux_ratio)
}

// A met1 pad centered on the bitcell column boundary at `x`.
fn boundary_pad(x: Float, y0: Float, y1: Float) -> Rect {
    crect(x0=x - 70., y0=y0, x1=x + 70., y1=y1)
}

fn dummy_bitline_pad(x: Float) -> Rect {
    crect(x0=x, y0=1650., x1=x + 140., y1=1780.)
}

// Met1 supply pads on the bottom edge of the main array. Cell supplies sit on
// column boundaries, and each wordline strap has a well-tap pad.
fn array_edge_pads(groups: Int, mux_ratio: Int, vdd: Bool) -> [Rect] {
    let pairs = mux_ratio / 2;
    let right = array_group_x(groups, mux_ratio);
    let tap_offset = if vdd { 310. } else { 770. };
    let taps = [for g in std::range(groups + 1) {
        let x = array_group_x(g, mux_ratio) + tap_offset;
        crect(x0=x, y0=1065., x1=x + 220., y1=1245.)
    }];
    if vdd {
        std::flatten([
            [
                boundary_pad(rowend_width(), 1960., 2055.),
                boundary_pad(right + rowend_width() + bitcell_width(), 1960., 2055.),
            ],
            std::flatten([for g in std::range(groups) {
                let x = array_group_x(g, mux_ratio) + rowend_width();
                [for k in std::range(pairs) {
                    boundary_pad(x + (2 * k + 1) as Float * bitcell_width(), 1960., 2055.)
                }]
            }]),
            taps,
            [
                crect(x0=750., y0=0., x1=1050., y1=180.),
                crect(x0=right + 2750., y0=0., x1=right + 3050., y1=180.),
            ],
            [
                dummy_bitline_pad(rowend_width() + 710.),
                dummy_bitline_pad(rowend_width() + 345.),
                dummy_bitline_pad(right + rowend_width() + 350.),
                dummy_bitline_pad(right + rowend_width() + 715.),
            ],
        ])
    } else {
        std::flatten([
            [for g in std::range(groups + 1) {
                boundary_pad(array_group_x(g, mux_ratio), 1960., 2055.)
            }],
            std::flatten([for g in std::range(groups) {
                let x = array_group_x(g, mux_ratio) + rowend_width();
                [for k in std::range(pairs) {
                    boundary_pad(x + (2 * k) as Float * bitcell_width(), 1960., 2055.)
                }]
            }]),
            [boundary_pad(right + rowend_width(), 1960., 2055.)],
            taps,
            [
                crect(x0=240., y0=0., x1=540., y1=180.),
                crect(x0=right + 3260., y0=0., x1=right + 3560., y1=180.),
            ],
        ])
    }
}

// Adds the mirror image of bottom-edge pads on the top edge.
fn mirror_pads(pads: [Rect], height: Float) -> [Rect] {
    std::concat(
        pads,
        [for r in pads { crect(x0=r.x0, y0=height - r.y1, x1=r.x1, y1=height - r.y0) }],
    )
}

// The replica array reuses the same foundry macros, but has its own two-column
// tile and an extended substrate-tap cell along each side.
fn replica_pair_width() -> Float { 2. * bitcell_width() }

fn replica_row_groups(rows: Int) -> Int {
    (rows - 2 + hstrap_rows() - 1) / hstrap_rows()
}

fn replica_right_origin(cols: Int) -> Float {
    2. * rowend_width() + (cols / 2) as Float * replica_pair_width()
}

cell replica_tap_end() {
    inst(macros::sp_rowtapend_replica(), x=2520., y=bitcell_height(), reflect=true, angle=180);
    inst(macros::sp_rowend_hstrap(), x=3820., y=0., reflect=true);
}

cell replica_center() {
    inst(macros::sp_hstrap(), x=0., y=array_center_height(), reflect=true, angle=180);
    inst(macros::sp_hstrap(), x=replica_pair_width(), y=array_center_height());
    for pair in std::range(hstrap_rows() / 2) {
        let y = bitcell_height() + 2. * bitcell_height() * pair as Float;
        inst(macros::sp_cell_a_replica(), x=bitcell_width(), y=y, reflect=true);
        inst(macros::sp_cell_a_replica(), x=bitcell_width(), y=y, angle=180);
        inst(macros::sp_cell_replica(), x=bitcell_width(), y=y);
        inst(macros::sp_cell_replica(), x=bitcell_width(), y=y, reflect=true, angle=180);
    }
}

cell replica_top() {
    let row_y = bitcell_height();
    inst(macros::sp_colend(), x=0., y=row_y);
    inst(macros::sp_colend(), x=replica_pair_width(), y=row_y, reflect=true, angle=180);
    inst(macros::sp_cell_replica(), x=bitcell_width(), y=row_y);
    inst(macros::sp_cell_replica(), x=bitcell_width(), y=row_y, reflect=true, angle=180);
}

cell replica_bottom() {
    let row_y = colend_height();
    inst(macros::sp_hstrap(), x=0., y=array_bottom_height(), reflect=true, angle=180);
    inst(macros::sp_hstrap(), x=replica_pair_width(), y=array_bottom_height());
    inst(macros::sp_cell_a_replica(), x=bitcell_width(), y=row_y, reflect=true);
    inst(macros::sp_cell_a_replica(), x=bitcell_width(), y=row_y, angle=180);
    inst(macros::sp_colend_a(), x=0., y=row_y, reflect=true);
    inst(macros::sp_colend_a(), x=replica_pair_width(), y=row_y, angle=180);
}

cell replica_left() {
    inst(replica_tap_end(), x=-2520., y=array_center_height() - bitcell_height());
    for pair in std::range(hstrap_rows() / 2) {
        let y = bitcell_height() + 2. * bitcell_height() * pair as Float;
        inst(macros::sp_rowend_a_replica(), x=rowend_width(), y=y, reflect=true);
        inst(macros::sp_rowend_replica(), x=rowend_width(), y=y);
    }
}

cell replica_corner_top() {
    inst(macros::sp_corner(), x=rowend_width(), y=bitcell_height());
    inst(macros::sp_rowend_replica(), x=rowend_width(), y=bitcell_height());
}

cell replica_corner_bottom() {
    inst(replica_tap_end(), x=-2520., y=array_bottom_height() - bitcell_height());
    inst(macros::sp_rowend_a_replica(), x=rowend_width(), y=colend_height(), reflect=true);
    inst(macros::sp_corner_a(), x=rowend_width(), y=colend_height(), reflect=true);
}

cell replica_cell_array(rows: Int, cols: Int) {
    let groups = cols / 2;
    let row_groups = replica_row_groups(rows);
    let right_x = replica_right_origin(cols);

    inst(replica_corner_bottom(), x=0., y=0.);
    for col in std::range(groups) {
        let bottom = inst(
            replica_bottom(),
            x=rowend_width() + col as Float * replica_pair_width(),
            y=0.,
        );
    }
    inst(replica_corner_bottom(), x=right_x, y=0., reflect=true, angle=180);

    for row in std::range(row_groups) {
        let y = array_bottom_height() + row as Float * array_center_height();
        let left = inst(replica_left(), x=0., y=y);
        for col in std::range(groups) {
            inst(replica_center(), x=rowend_width() + col as Float * replica_pair_width(), y=y);
        }
        let right = inst(replica_left(), x=right_x, y=y, reflect=true, angle=180);
    }

    let top_y = array_bottom_height() + row_groups as Float * array_center_height();
    inst(replica_corner_top(), x=0., y=top_y);
    for col in std::range(groups) {
        let top = inst(
            replica_top(),
            x=rowend_width() + col as Float * replica_pair_width(),
            y=top_y,
        );
    }
    inst(replica_corner_top(), x=right_x, y=top_y, reflect=true, angle=180);
    pub let bl = [replica_bitline_port(0, false), replica_bitline_port(1, false)];
    pub let br = [replica_bitline_port(0, true), replica_bitline_port(1, true)];
    pub let wl = array_wordline_ports(rows);
    // One cell supply rail of each kind on the left edge, plus every substrate-tie rail.
    pub let vdd_rails = [crect(x0=0., y0=top_y + 2160., x1=rowend_width(), y1=top_y + 2610.)];
    pub let vss_rails = cons(
        crect(x0=0., y0=top_y + 3180., x1=rowend_width(), y1=top_y + 3635.),
        cons(
            crect(x0=0., y0=top_y + 1600., x1=rowend_width(), y1=top_y + 1985.),
            cons(
                crect(x0=0., y0=1650., x1=rowend_width(), y1=2035.),
                replica_tie_rails(row_groups),
            ),
        ),
    );
    // Supply pins: met1 pads on the top and bottom edges, met2 rails on the left
    // and right edges. Well ties count with the supply they tie to.
    pub let vdd_pins_m1 = replica_edge_pads(groups, right_x, top_y, true);
    pub let vss_pins_m1 = replica_edge_pads(groups, right_x, top_y, false);
    pub let vdd_pins_m2 = std::concat(
        array_power_rails(rowend_width(), row_groups, true),
        array_power_rails(right_x, row_groups, true),
    );
    pub let vss_pins_m2 = std::concat(
        array_power_rails(rowend_width(), row_groups, false),
        array_power_rails(right_x, row_groups, false),
    );
    // Met2 rails of each wordline on both edges, indexed like `wl`.
    pub let wl_pins_m2 = [for i in std::range(hstrap_rows() * row_groups) {
        replica_wordline_pins(i, row_groups, right_x)
    }];
}

// Met1 supply pads of the replica array. Cell supplies sit on column
// boundaries at three heights; well taps sit at the corners.
fn replica_edge_pads(groups: Int, right: Float, top_y: Float, vdd: Bool) -> [Rect] {
    let height = top_y + array_top_height();
    let spans = [
        (colend_height() - 95., colend_height() + 75.,),
        (array_bottom_height() - 75., array_bottom_height(),),
        (top_y + bitcell_height() - 75., top_y + bitcell_height() + 95.,),
    ];
    let cols = if vdd { std::range(groups + 1) } else { std::range(groups) };
    let col_offset = if vdd { 0. } else { bitcell_width() };
    let tap_offset = if vdd { 750. } else { 240. };
    std::concat(
        std::flatten([for g in cols {
            let x = rowend_width() + g as Float * replica_pair_width() + col_offset;
            [for s in spans { boundary_pad(x, s.0, s.1) }]
        }]),
        std::flatten([for s in [(0., 180.,), (height - 180., height,)] {
            [
                crect(x0=tap_offset, y0=s.0, x1=tap_offset + 300., y1=s.1),
                crect(x0=right - tap_offset - 300., y0=s.0, x1=right - tap_offset, y1=s.1),
            ]
        }]),
    )
}

// Rails of one replica wordline. Wordline 0 also owns the dummy-wordline rails.
fn replica_wordline_pins(idx: Int, row_groups: Int, right_edge: Float) -> [Rect] {
    let left = array_wordline_port(idx, hstrap_rows() * row_groups);
    let rails = [
        left,
        crect(x0=right_edge - rowend_width(), y0=left.y0, x1=right_edge, y1=left.y1),
    ];
    if idx == 0 {
        let top_y = array_bottom_height() + row_groups as Float * array_center_height();
        std::flatten([
            rails,
            dummy_wordline_rails(top_y, 0., rowend_width()),
            dummy_wordline_rails(top_y, right_edge - rowend_width(), right_edge),
        ])
    } else {
        rails
    }
}

// Substrate-tie rails under each horizontal strap. The side tap cells connect
// them to each other but not to the cell supply.
fn replica_tie_rails(row_groups: Int) -> [Rect] {
    [for i in std::range(row_groups + 1) {
        let y = array_bottom_height() + i as Float * array_center_height() - 465.;
        crect(x0=0., y0=y, x1=rowend_width(), y1=y + 345.)
    }]
}

fn replica_bitline_port(idx: Int, right: Bool) -> Rect {
    let x0 = if idx == 0 {
        if right { 1650. } else { 2010. }
    } else {
        if right { 3210. } else { 2850. }
    };
    crect(x0=x0, y0=3995., x1=x0 + 140., y1=4175.)
}
